{
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
  // A type that appears in an exported signature stays exported so callers can name it.
  "ignoreExportsUsedInFile": { "interface": true, "type": true },
  "workspaces": {
    ".": {
      // check-dynamic-sql.d.mts types the .mjs guard for the api tests that import its matchers.
      "entry": ["scripts/*.mjs", "scripts/check-dynamic-sql.d.mts"],
      "project": ["scripts/**"],
      // Declared in every package so `pnpm exec tsc` is TypeScript 7 everywhere (issue-tracker#288 D22),
      // though nothing at the root runs it.
      "ignoreDependencies": ["@typescript/native"],
    },
    // The package.json scripts, the tsdown entries, the vitest globalSetup and drizzle.config.ts are entries
    // through knip's plugins; listed here are only the hand-run CLIs nothing else names.
    "services/api": {
      "entry": [
        // The font-change procedure in assets/fonts/PROVENANCE.md runs it with tsx.
        "scripts/render-sample-certificate.ts",
        // The only writer of jurisdictions.handle; whether to wire or retire it is an open decision.
        "src/db/backfill-jurisdiction-handles.ts",
      ],
      "project": ["src/**/*.ts", "scripts/**/*.ts", "test/**/*.ts"],
      "ignore": [
        // Hand-run SQL transcript tooling: the generator is a tsx CLI, and the generated cases reach
        // every exported SQL helper through a namespace import that static analysis cannot follow.
        "test/sql-transcripts/**",
        // Unused since it landed; deleting it waits on the roster-export vs host-contact consent
        // decision, whose fix may reuse hostContactOptInFor.
        "src/services/host/event-consents-repository.drizzle.ts",
      ],
      // Nothing imports ws directly: @fastify/websocket's typings do, and without these the socket
      // type it hands the /ws handler resolves to `any`.
      "ignoreDependencies": ["@types/ws"],
      // GDAL's converter, which the hand-run boundary scripts require on the machine that runs them.
      "ignoreBinaries": ["ogr2ogr"],
    },
    "services/media-worker": {
      "project": ["src/**/*.ts", "test/**/*.ts"],
      // tsdown inlines @civfix/api (alwaysBundle) but keeps these external, so the bundled api code
      // resolves them from the worker's own node_modules at runtime. knip reads the named externals from
      // tsdown.config.ts itself; these are the ones its /^@aws-sdk\// pattern covers.
      "ignoreDependencies": [
        // @civfix/api/adapters/storage (R2 client)
        "@aws-sdk/client-s3",
        // @civfix/api/adapters/storage (presigned URLs)
        "@aws-sdk/s3-request-presigner",
      ],
    },
    "services/city-filer": {
      // The kit and the fixture portal's script run under node, loaded by path or through a workspace
      // script's import, never from src.
      "entry": ["kit/**/*.mjs", "test/fixtures/**/*.mjs"],
      "project": ["src/**/*.ts", "kit/**/*.mjs", "test/**/*.ts", "test/fixtures/**"],
      // coreutils, which the tests use to put a FIFO where a file is expected.
      "ignoreBinaries": ["mkfifo"],
      "ignoreDependencies": [
        // A workspace script's import, resolved through /workspace/node_modules (the image's link; the
        // test harness makes the same one).
        "@civfix/filer-kit",
        // tsdown inlines @civfix/api (alwaysBundle) but keeps these external, so the bundled api code
        // resolves them from the filer's own node_modules at runtime. knip reads the named externals
        // from tsdown.config.ts itself; these are the ones its /^@aws-sdk\// pattern covers.
        // @civfix/api/adapters/storage (R2 client)
        "@aws-sdk/client-s3",
        // @civfix/api/adapters/storage (presigned URLs)
        "@aws-sdk/s3-request-presigner",
      ],
    },
    "packages/config": {
      // Declared so `pnpm exec tsc` is TypeScript 7 here too (issue-tracker#288 D22), though nothing here
      // runs it.
      "ignoreDependencies": ["@typescript/native"],
    },
    // Outside pnpm-workspace.yaml (it deploys with wrangler from its own lockfile); CI installs it before
    // knip runs so its dependencies resolve.
    "infra/email-worker": {},
  },
}
