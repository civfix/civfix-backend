{
  "name": "@civfix/testing",
  "version": "0.0.0",
  "private": true,
  "description": "Shared test support for the backend's vitest suites: the console guard that fails a test on an unexpected console.error or console.warn. Consumed as TypeScript source by each package's own vitest setup file.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "exports": {
    "./console": "./src/console.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint --max-warnings 0 .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "clean": "rimraf .turbo *.tsbuildinfo"
  },
  "devDependencies": {
    "@civfix/config": "workspace:*",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^9.39.5",
    "rimraf": "^6.1.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
