{
  "name": "@civfix/city-filer",
  "version": "1.4.0",
  "private": true,
  "description": "civfix city filer. Works the filing.run queue: runs each portal's workspace script as the credential-less filer user through filer-shell, checks its output, uploads the evidence and hands the outcome back on filing.result.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "files": [
    "dist",
    "kit",
    "bin",
    "playbook"
  ],
  "scripts": {
    "build": "tsup",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "clean": "rimraf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1147.0",
    "@aws-sdk/s3-request-presigner": "^3.1147.0",
    "@civfix/api": "workspace:*",
    "@civfix/contract": "0.66.0-b-feat-city-filing-contract.g82d07a7",
    "@sentry/node": "^10.76.1",
    "@smithy/node-http-handler": "4.7.5",
    "drizzle-orm": "^0.45.3",
    "https-proxy-agent": "7.0.6",
    "pg-boss": "^10.4.2",
    "playwright-core": "1.64.0-alpha-1790635538000",
    "postgres": "^3.4.9",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@civfix/config": "workspace:*",
    "@civfix/seams": "workspace:*",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "rimraf": "^6.1.3",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
