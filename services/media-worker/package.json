{
  "name": "@civfix/media-worker",
  "version": "1.4.1",
  "private": true,
  "description": "civfix media worker. Consumes the Jobs seam (pg-boss) to run sandboxed, untrusted-byte media checks: decode-guard, EXIF/location strip, thumbnail, pHash, NSFW seam, video probe/remux, plus orphan-sweep and chat-partition cron.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "main": "./dist/worker.js",
  "exports": {
    ".": "./dist/worker.js",
    "./worker": "./dist/worker.js"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --max-warnings 0 .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "clean": "rimraf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1147.0",
    "@aws-sdk/s3-request-presigner": "^3.1147.0",
    "@civfix/api": "workspace:*",
    "@civfix/contract": "^0.71.1",
    "@sentry/node": "^11.10.0",
    "@smithy/node-http-handler": "4.7.5",
    "drizzle-orm": "^0.45.3",
    "execa": "^9.6.1",
    "exifr": "^7.1.3",
    "https-proxy-agent": "7.0.6",
    "pg-boss": "^10.4.2",
    "postgres": "^3.4.9",
    "sharp": "^0.35.5",
    "undici": "^7.30.1",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@civfix/config": "workspace:*",
    "@civfix/seams": "workspace:*",
    "@civfix/testing": "workspace:*",
    "@testcontainers/postgresql": "^12.2.1",
    "@types/ffprobe-static": "^2.0.3",
    "@types/node": "^24.19.2",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.14.0",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "rimraf": "^6.1.3",
    "tsdown": "^0.23.4",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^5.0.5"
  }
}
