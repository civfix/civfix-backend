{
  "name": "@civfix/media-worker",
  "version": "0.0.0",
  "private": true,
  "description": "civfix media worker. Consumes the Jobs seam (pg-boss) to run sandboxed, untrusted-byte media checks: decode-guard, EXIF/location strip, thumbnail, pHash, NSFW seam, video probe/remux, plus orphan-sweep and chat-partition cron.",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/worker.js",
  "exports": {
    ".": "./dist/worker.js",
    "./worker": "./dist/worker.js"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "clean": "rimraf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@civfix/api": "workspace:*",
    "@civfix/shared": "workspace:*",
    "drizzle-orm": "^0.36.4",
    "execa": "^9.5.2",
    "exifr": "^7.1.3",
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0",
    "pg-boss": "^10.1.5",
    "postgres": "^3.4.5",
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "@civfix/config": "workspace:*",
    "@testcontainers/postgresql": "^10.16.0",
    "@types/ffprobe-static": "^2.0.3",
    "@types/node": "^22.10.2",
    "eslint": "^9.16.0",
    "rimraf": "^6.0.1",
    "testcontainers": "^10.16.0",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
