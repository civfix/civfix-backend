{
  "name": "@civfix/media-worker",
  "version": "1.2.0",
  "private": true,
  "description": "civfix media worker. Consumes the Jobs seam (pg-boss) to run sandboxed, untrusted-byte media checks: decode-guard, EXIF/location strip, thumbnail, pHash, NSFW seam, video probe/remux, plus orphan-sweep and chat-partition cron.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "main": "./dist/worker.js",
  "exports": {
    ".": "./dist/worker.js",
    "./worker": "./dist/worker.js"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "clean": "rimraf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@civfix/api": "workspace:*",
    "@civfix/shared": "^0.55.0",
    "@sentry/node": "^10.73.0",
    "@smithy/node-http-handler": "4.7.5",
    "drizzle-orm": "^0.45.2",
    "execa": "^9.5.2",
    "exifr": "^7.1.3",
    "https-proxy-agent": "7.0.6",
    "pg-boss": "^10.1.5",
    "postgres": "^3.4.5",
    "sharp": "^0.35.4",
    "undici": "^7.16.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@civfix/config": "workspace:*",
    "@testcontainers/postgresql": "^11.14.0",
    "@types/ffprobe-static": "^2.0.3",
    "@types/node": "^22.10.2",
    "eslint": "^9.16.0",
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0",
    "rimraf": "^6.0.1",
    "testcontainers": "^11.14.0",
    "tsup": "^8.3.5",
    "tsx": "^4.23.13",
    "typescript": "^5.6.3",
    "vitest": "^3.2.7"
  }
}
