{
  "name": "@civfix/media-worker",
  "version": "1.4.0",
  "private": true,
  "description": "civfix media worker. Consumes the Jobs seam (pg-boss) to run sandboxed, untrusted-byte media checks: decode-guard, EXIF/location strip, thumbnail, pHash, NSFW seam, video probe/remux, plus orphan-sweep and chat-partition cron.",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/worker.js",
  "exports": {
    ".": "./dist/worker.js",
    "./worker": "./dist/worker.js"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "clean": "rimraf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1147.0",
    "@aws-sdk/s3-request-presigner": "^3.1147.0",
    "@civfix/api": "workspace:*",
    "@civfix/shared": "^0.58.0",
    "@sentry/node": "^10.76.1",
    "@smithy/node-http-handler": "4.7.5",
    "drizzle-orm": "^0.45.3",
    "execa": "^9.6.1",
    "exifr": "^7.1.3",
    "https-proxy-agent": "7.0.6",
    "pg-boss": "^10.4.2",
    "postgres": "^3.4.9",
    "sharp": "^0.35.5",
    "undici": "^7.30.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@civfix/config": "workspace:*",
    "@testcontainers/postgresql": "^11.14.0",
    "@types/ffprobe-static": "^2.0.3",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "rimraf": "^6.1.3",
    "testcontainers": "^11.14.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
