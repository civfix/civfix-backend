# civfix media-worker environment (machine reference).
# The worker is a SEPARATE process from the API. It boots offline with the same USE_FAKE_* defaults
# (ON outside production, OFF in production). It needs only what the media pipeline touches, NOT the
# API's HTTP config. Copy to media-worker.env (gitignored) and fill real values for production.
# In production the worker REQUIRES DATABASE_URL (it must persist media results); a missing one is fatal.
#
# NODE_ENV: `development` here is for LOCAL use only. In a deployment do NOT rely on this line: the
# image (Dockerfile) and the civfix-infra compose force NODE_ENV=production (compose
# `environment` overrides this env_file). A deployed worker left at `development` would default every
# USE_FAKE_* ON and silently run FAKE NSFW/abuse + dup checks and FAKE storage in production.

# ===== core =====
NODE_ENV=development                       # development | test | production (deploys force =production; see header)
DATABASE_URL=                              # postgres://user:pass@host:5432/civfix (PostGIS). Required in prod.
                                           # In PRODUCTION append ?sslmode=require (or verify-ca / verify-full)
                                           # for any host that crosses a wire: postgres.js defaults to ssl:false,
                                           # so a URL without sslmode ships credentials and rows in cleartext.
                                           # EXEMPT (the API's boot check skips these): localhost, 127.x, ::1, or
                                           # a single-label compose alias like `postgres`: packets that never
                                           # leave the machine, against an image with no server certificate.
                                           # Dotted names and RFC1918 addresses still require TLS.

# ===== storage: R2 (bypassed by USE_FAKE_STORAGE) =====
R2_ACCOUNT_ID=                             # required unless USE_FAKE_STORAGE - Cloudflare R2 account id
R2_ACCESS_KEY_ID=                          # required unless USE_FAKE_STORAGE - R2 access key id
R2_SECRET_ACCESS_KEY=                      # required unless USE_FAKE_STORAGE - R2 secret access key
R2_BUCKET=                                 # required unless USE_FAKE_STORAGE - R2 bucket name
R2_PUBLIC_BASE=                            # IGNORED BY THE WORKER (API-only). R2Storage.presignGet returns the
                                           # UNSIGNED public URL whenever a publicBase is configured, so the
                                           # worker deliberately does not pass one: it always SIGNS its GETs and
                                           # must keep working even when the bucket is private. Set it in the
                                           # API's env (and only there) for the CDN/custom-domain read path.

# ===== storage: LOCAL DISK - DEVELOPMENT ONLY =====
# Set LOCAL_STORAGE_DIR (the SAME directory the API uses) and the worker reads/writes objects straight
# off the filesystem instead of R2. It still resolves its download URL through a presigned GET, so
# PUBLIC_API_URL must point at the running API and LOCAL_STORAGE_SIGNING_KEY must match the API's.
# The path MUST be ABSOLUTE and byte-for-byte identical to the API's value: the two services run from
# different working directories, so a relative path resolves to two divergent trees and the objects this
# worker writes would 404 through the API. The adapter rejects a non-absolute value at construction.
# Refused at boot with NODE_ENV=production.
LOCAL_STORAGE_DIR=                         # [OPT] dev-only: ABSOLUTE shared local-disk object store directory (e.g. /home/you/civfix/.local-storage)
LOCAL_STORAGE_SIGNING_KEY=                 # [OPT] dev-only: must match the API's value (defaults to the same dev constant)
PUBLIC_API_URL=                            # required when LOCAL_STORAGE_DIR is set - e.g. http://localhost:8080

# ===== abuse / NSFW (bypassed by USE_FAKE_ABUSE_NSFW) =====
CF_TURNSTILE_SECRET=                       # [OPT] Turnstile secret (the worker only uses the NSFW/dedupe seam)

# ===== error reporting: GlitchTip [OPT] =====
GLITCHTIP_DSN=                             # [OPT] Sentry-compatible DSN; reporting is no-op if absent

# ===== seam fake flags (default true off-prod, false in production) =====
# FATAL IN PRODUCTION: each of these fails boot when explicitly enabled with NODE_ENV=production. A fake
# seam there is not a degraded mode, it is a silent no-op (see config.ts assertRealSeamInProd).
USE_FAKE_STORAGE=                          # 1/true to use in-memory storage instead of R2
USE_FAKE_ABUSE_NSFW=                       # 1/true to use fake abuse checks (incl. NSFW)
USE_FAKE_JOBS=                             # 1/true to use FakeJobs instead of pg-boss. Defaults ON outside
                                           # production, OFF in production. FakeJobs consumes NOTHING from
                                           # pg-boss, so a production worker with it starts clean, reports
                                           # healthy, and leaves every upload 'validating' forever - boot
                                           # therefore FAILS if it is explicitly on with NODE_ENV=production.
                                           # When it is OFF, DATABASE_URL is REQUIRED (pg-boss connection).

# ===== media pipeline tuning (all [OPT]; safe defaults in services/media-worker/src/config.ts) =====
MEDIA_MAX_DOWNLOAD_BYTES=                  # [OPT] hard cap on bytes pulled per asset (default MAX_VIDEO_BYTES)
MEDIA_MAX_IMAGE_PIXELS=                    # [OPT] decoded-pixel budget for images (default 24,000,000)
MEDIA_SHARP_PIXEL_LIMIT=                   # [OPT] sharp limitInputPixels ceiling (default 32,000,000)
MEDIA_MAX_CHILD_OUTPUT_BYTES=              # [OPT] max bytes a sandboxed child may emit (default MAX_VIDEO_BYTES+1MB)
MEDIA_FFPROBE_TIMEOUT_MS=                  # [OPT] per-call ffprobe timeout (default 10000)
MEDIA_FFMPEG_TIMEOUT_MS=                   # [OPT] per-call ffmpeg remux/thumbnail timeout (default 30000)
MEDIA_IMAGE_TIMEOUT_MS=                    # [OPT] per-call sharp pipeline timeout (default 15000). The image
                                           # lane is killed at 3x this + 5s, and boot FAILS unless that stays
                                           # below MEDIA_JOB_TIMEOUT_MS (so at most 28333 at the default 90000).
MEDIA_JOB_TIMEOUT_MS=                      # [OPT] per-PHASE wall-clock budget for a media.checks job (default
                                           # 90000). Sized ABOVE the worst-case sandbox tool sum on the video
                                           # path (ffprobe 10s + remux 30s + frame 30s + thumbnail 15s = 85s) so
                                           # the job budget only fires on a genuine tool hang, not on legit slow
                                           # processing (a process-phase timeout now RETRIES, it does not reject).
                                           # Charged once for the download and once for processing. The graceful
                                           # stop is derived as 2x + 5s (jobs.ts stopGraceMsFor = 185s at the
                                           # default), and the media-worker container's stop_grace_period in the
                                           # civfix-infra compose MUST exceed that (>= ~200s). Raising this raises both.
MEDIA_MAX_VIDEO_DURATION_SEC=              # [OPT] longest accepted video, seconds (default 30)
MEDIA_THUMBNAIL_MAX_EDGE=                  # [OPT] thumbnail longest edge, px (default 400)
MEDIA_NSFW_HOLD_THRESHOLD=                 # [OPT] NSFW score at/above which an asset is held (default 0.8)
MEDIA_UNSCORED_POLICY=                     # [OPT] flag | hold - what to do when NO NSFW scorer is configured
                                           # (default flag). A score of 0 from an unconfigured scorer means NO
                                           # VERDICT, not benign. `flag` publishes WITHOUT a blocking abuse flag
                                           # (F076: an unscored-NSFW flag is not a real verdict and would strand
                                           # every anonymous report-with-media in `held` forever via the
                                           # hold-release gate); the note records the gap. `hold` fails closed
                                           # (nothing publishes until an operator reviews) and is the INCIDENT
                                           # SWITCH: with no model vendored it holds 100% of media, which takes
                                           # anonymous reporting offline.
MEDIA_CHECKS_CONCURRENCY=                  # [OPT] parallel media.checks jobs per worker (default 2)
MEDIA_ORPHAN_TTL_MS=                       # [OPT] age after which a never-attached media is an orphan (default 6h).
                                           # PAIRED with UNBOUND_GRACE_MS in the API's media-authorization.ts:
                                           # grace must be <= TTL (the API 404s an unbound row past the grace, so
                                           # a longer TTL only keeps bytes nobody can fetch). Raise both together.
MEDIA_ORPHAN_SWEEP_BATCH=                  # [OPT] max orphan rows reaped per sweep PAGE (default 1000). The sweep
                                           # loops while a page comes back full, so this is a batching knob, not a
                                           # throughput ceiling: batch x MAX_PAGES rows can be DESTROYED per run.
MEDIA_ORPHAN_SWEEP_MAX_PAGES=              # [OPT] pages one orphan-sweep run drains before yielding (default 50)
MEDIA_HOLD_RELEASE_SWEEP_BATCH=            # [OPT] held anon reports re-evaluated per hold-release sweep (default 200)
RETENTION_SWEEP_BATCH=                     # [OPT] rows deleted per retention-sweep page, per table (default 5000)
RETENTION_SWEEP_MAX_PAGES=                 # [OPT] pages one retention-sweep run drains per table (default 20)
MEDIA_STUCK_TTL_MS=                        # [OPT] age after which a media row still 'validating' is stuck and its
                                           # media.checks job is re-enqueued by media.stuck.sweep (default 1h)
MEDIA_STUCK_SWEEP_BATCH=                   # [OPT] stuck-media rows re-enqueued per stuck-sweep run (default 500)
MEDIA_STUCK_SWEEP_MAX_ATTEMPTS=            # [OPT] how many stuck-sweep passes one media row gets before the sweep
                                           # gives up and persists it as 'rejected' (default 5). The sweep only
                                           # ever sees FINALIZED rows, so a row that survives this many passes is
                                           # hopeless (bytes never arrived, checks can never succeed) and would
                                           # otherwise be re-enqueued every run forever.
