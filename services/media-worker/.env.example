# civfix media-worker environment (machine reference).
# The worker is a SEPARATE process from the API. It boots offline with the same USE_FAKE_* defaults
# (ON outside production, OFF in production). It needs only what the media pipeline touches, NOT the
# API's HTTP config. Copy to media-worker.env (gitignored) and fill real values for production.
# In production the worker REQUIRES DATABASE_URL (it must persist media results); a missing one is fatal.
#
# NODE_ENV: `development` here is for LOCAL use only. In a deployment do NOT rely on this line — the
# image (Dockerfile) and infra/compose/docker-compose.yml force NODE_ENV=production (compose
# `environment` overrides this env_file). A deployed worker left at `development` would default every
# USE_FAKE_* ON and silently run FAKE NSFW/abuse + dup checks and FAKE storage in production.

# ===== core =====
NODE_ENV=development                       # development | test | production (deploys force =production; see header)
DATABASE_URL=                              # postgres://user:pass@host:5432/civfix (PostGIS). Required in prod.

# ===== storage: R2 (bypassed by USE_FAKE_STORAGE) =====
R2_ACCOUNT_ID=                             # required unless USE_FAKE_STORAGE - Cloudflare R2 account id
R2_ACCESS_KEY_ID=                          # required unless USE_FAKE_STORAGE - R2 access key id
R2_SECRET_ACCESS_KEY=                      # required unless USE_FAKE_STORAGE - R2 secret access key
R2_BUCKET=                                 # required unless USE_FAKE_STORAGE - R2 bucket name
R2_PUBLIC_BASE=                            # [OPT] public base URL for objects (CDN/custom domain)

# ===== abuse / NSFW (bypassed by USE_FAKE_ABUSE_NSFW) =====
CF_TURNSTILE_SECRET=                       # [OPT] Turnstile secret (the worker only uses the NSFW/dedupe seam)

# ===== error reporting: GlitchTip [OPT] =====
GLITCHTIP_DSN=                             # [OPT] Sentry-compatible DSN; reporting is no-op if absent

# ===== seam fake flags (default true off-prod, false in production) =====
USE_FAKE_STORAGE=                          # 1/true to use in-memory storage instead of R2
USE_FAKE_ABUSE_NSFW=                       # 1/true to use fake abuse checks (incl. NSFW)

# ===== media pipeline tuning (all [OPT]; safe defaults in services/media-worker/src/config.ts) =====
MEDIA_MAX_DOWNLOAD_BYTES=                  # [OPT] hard cap on bytes pulled per asset (default MAX_VIDEO_BYTES)
MEDIA_MAX_IMAGE_PIXELS=                    # [OPT] decoded-pixel budget for images (default 24,000,000)
MEDIA_SHARP_PIXEL_LIMIT=                   # [OPT] sharp limitInputPixels ceiling (default 32,000,000)
MEDIA_MAX_CHILD_OUTPUT_BYTES=              # [OPT] max bytes a sandboxed child may emit (default MAX_VIDEO_BYTES+1MB)
MEDIA_FFPROBE_TIMEOUT_MS=                  # [OPT] per-call ffprobe timeout (default 10000)
MEDIA_FFMPEG_TIMEOUT_MS=                   # [OPT] per-call ffmpeg remux/thumbnail timeout (default 30000)
MEDIA_IMAGE_TIMEOUT_MS=                    # [OPT] per-call sharp pipeline timeout (default 15000)
MEDIA_JOB_TIMEOUT_MS=                      # [OPT] overall per-job wall-clock budget (default 60000)
MEDIA_MAX_VIDEO_DURATION_SEC=              # [OPT] longest accepted video, seconds (default 30)
MEDIA_THUMBNAIL_MAX_EDGE=                  # [OPT] thumbnail longest edge, px (default 400)
MEDIA_NSFW_HOLD_THRESHOLD=                 # [OPT] NSFW score at/above which an asset is held (default 0.8)
MEDIA_CHECKS_CONCURRENCY=                  # [OPT] parallel media.checks jobs per worker (default 2)
MEDIA_ORPHAN_TTL_MS=                       # [OPT] age after which a never-attached media is an orphan (default 24h)
MEDIA_ORPHAN_SWEEP_BATCH=                  # [OPT] max orphan rows reaped per sweep (default 200)
