exports[`sql transcripts > makeDrizzleAdminEventRepository.linkReports 1`] = `
"-- empty
BEGIN tx1
[tx1] SELECT id FROM cleanups WHERE id = $1 LIMIT 1 -- ["id-1"]
COMMIT tx1
=> null
-- row
BEGIN tx1
[tx1] SELECT id FROM cleanups WHERE id = $1 LIMIT 1 -- ["id-1"]
[tx1] INSERT INTO cleanup_reports (cleanup_id, report_id, linked_by_user_id) SELECT $1, r.id, $2 FROM reports r WHERE r.id = ANY($3::uuid[]) AND r.status = ANY($4::text[]) AND r.visibility = 'public' AND r.deleted_at IS NULL ON CONFLICT (cleanup_id, report_id) DO NOTHING RETURNING report_id -- ["id-1","actorId-1",["reportId-1"],["published","acknowledged","in_progress","resolved"]]
[tx1] INSERT INTO cleanup_timeline (cleanup_id, kind, note, actor_id) SELECT $1, 'report_linked', 'Linked report ' || rid::text, $2 FROM unnest($3::uuid[]) AS rid -- ["id-1","actorId-1",["report_id-row"]]
[tx1] INSERT INTO audit_log (actor_id, action, target, meta) VALUES ($1, $2, $3, $4) RETURNING id -- ["actorId-1","event.reports_linked","cleanup:id-1",{"<json>":{"reportIds":["report_id-row"]}}]
COMMIT tx1
=> {"linked":["report_id-row"]}"
`;

