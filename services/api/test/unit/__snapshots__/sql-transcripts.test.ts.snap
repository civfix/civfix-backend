exports[`sql transcripts > makeDrizzleOrganizationRepository.removeMemberTx 1`] = `
"-- empty
BEGIN tx1
[tx1] SELECT id FROM organizations WHERE id = $1 LIMIT 1 FOR UPDATE -- ["organizationId-1"]
[tx1] SELECT id FROM users WHERE id = $1 LIMIT 1 FOR UPDATE -- ["userId-1"]
[tx1] SELECT role FROM organization_members WHERE organization_id = $1 AND user_id = $2 LIMIT 1 FOR UPDATE -- ["organizationId-1","userId-1"]
[tx1] DELETE FROM organization_members WHERE organization_id = $1 AND user_id = $2 AND role <> 'owner' RETURNING role -- ["organizationId-1","userId-1"]
[tx1] SELECT role FROM organization_members WHERE organization_id = $1 AND user_id = $2 LIMIT 1 -- ["organizationId-1","userId-1"]
COMMIT tx1
=> "not_member"
-- row
BEGIN tx1
[tx1] SELECT id FROM organizations WHERE id = $1 LIMIT 1 FOR UPDATE -- ["organizationId-1"]
[tx1] SELECT id FROM users WHERE id = $1 LIMIT 1 FOR UPDATE -- ["userId-1"]
[tx1] SELECT role FROM organization_members WHERE organization_id = $1 AND user_id = $2 LIMIT 1 FOR UPDATE -- ["organizationId-1","userId-1"]
[tx1] DELETE FROM organization_members WHERE organization_id = $1 AND user_id = $2 AND role <> 'owner' RETURNING role -- ["organizationId-1","userId-1"]
[tx1] UPDATE users SET primary_organization_id = NULL WHERE id = $1 AND primary_organization_id = $2 -- ["userId-1","organizationId-1"]
[tx1] INSERT INTO audit_log (actor_id, action, target, meta) VALUES ($1, $2, $3, $4) RETURNING id -- ["actorId-1","org.member_removed","organization:organizationId-1",{"<json>":{"targetUserId":"userId-1","role":"role-row","reason":"reason-1"}}]
COMMIT tx1
=> "removed""
`;

