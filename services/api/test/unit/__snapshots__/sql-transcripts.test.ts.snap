=> [{"lat":3,"lng":3,"type":"route","status":"active","organizer":{"id":"id-1","name":"name-1","followers":3,"following":3,"isFollowing":true,"handle":"handle-1","avatar":["avatar0-1","avatar1-1"],"avatarUrl":"avatarUrl-1","organization":{"verified":true,"id":"id-1","slug":"slug-1","name":"name-1","logoUrl":"logoUrl-1","verifiedKind":"nonprofit"},"bio":"bio-1","donationUrl":"donationUrl-1","deleted":true},"slots":[{"claimed":3,"id":"id-1","title":"title-1","sortOrder":3,"description":"description-1","capacity":3,"mine":true,"startsAt":"startsAt-1","endsAt":"endsAt-1"}],"id":"id-1","title":"title-1","eventKind":"cleanup","scheduledAt":"scheduledAt-1","going":3,"visibility":"public","address":"address-1","myCapabilities":["view_event_private"],"joined":true,"bring":["bringItem-1"],"linkedReports":[{"lat":3,"lng":3,"status":"submitted","id":"id-1","title":"title-1","category":"trash","linkedAt":"linkedAt-1","type":"graffiti","thumbUrl":"thumbUrl-1","addr":"addr-1"}],"galleryUrls":["galleryUrl-1"],"ticketTypes":[],"organization":{"verified":true,"id":"id-1","slug":"slug-1","name":"name-1","logoUrl":"logoUrl-1","verifiedKind":"nonprofit","donationUrl":"donationUrl-1"},"donationUrl":"donationUrl-1","description":"description-1","capacity":3,"endsAt":"endsAt-1","timezone":"timezone-1","referenceCode":"referenceCode-1","jurisdictionGeoid":"jurisdictionGeoid-1","myRole":"coordinator","coverUrl":"coverUrl-1","registeredCount":3,"checkedInCount":3,"waitlistCount":3,"pageSlug":"pageSlug-1","pageStatus":"published","addressSource":"resolved","dist":3,"slotCount":3,"guestCount":3,"donationClicks":3,"registrationOpensAt":"registrationOpensAt-1","registrationClosesAt":"registrationClosesAt-1","registrationState":"closed","myRegistration":null,"teamCount":3,"reminderOffsetsMinutes":[3]}]"
`;

