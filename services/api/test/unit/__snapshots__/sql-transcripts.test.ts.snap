[tx1] UPDATE media_assets SET purpose = CASE WHEN id = $1 THEN 'event_cover' ELSE 'event_gallery' END WHERE id = ANY($2::uuid[]) AND purpose <> 'verification' AND report_id IS NULL AND post_id IS NULL AND chat_message_id IS NULL AND (status = 'ready' OR (status = 'validating' AND finalized_at IS NOT NULL)) AND NOT ( EXISTS (SELECT 1 FROM users u WHERE u.avatar_media_id = media_assets.id) OR EXISTS (SELECT 1 FROM chat_groups cg WHERE cg.avatar_media_id = media_assets.id) OR EXISTS (SELECT 1 FROM organizations og WHERE og.logo_media_id = media_assets.id) OR EXISTS ( SELECT 1 FROM cleanups oc WHERE ( oc.cover_media_id = media_assets.id OR oc.gallery_media_ids @> ARRAY[media_assets.id] ) AND ($3::uuid IS NULL OR oc.id <> $4::uuid) ) OR EXISTS ( SELECT 1 FROM cleanup_page_media pm WHERE pm.media_id = media_assets.id AND ($5::uuid IS NULL OR pm.cleanup_id <> $6::uuid) ) ) AND ( ( EXISTS ( SELECT 1 FROM cleanups cur WHERE cur.id = $7::uuid AND ( cur.cover_media_id = media_assets.id OR cur.gallery_media_ids @> ARRAY[media_assets.id] ) ) OR EXISTS ( SELECT 1 FROM cleanup_page_media pm WHERE pm.cleanup_id = $8::uuid AND pm.media_id = media_assets.id ) ) OR media_assets.created_at > now() - make_interval(secs => $9) ) RETURNING id -- ["coverMediaId-1",["coverMediaId-1","galleryMediaId-1"],"id-1","id-1","id-1","id-1","id-1","id-1",21600]
