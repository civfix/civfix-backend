exports[`sql transcripts > makeDrizzleMailRepository.getThread 1`] = `
"-- empty
SELECT id, thread_token, jurisdiction_geoid, report_id, cleanup_id, org, subject, status, unread, last_message_at, created_at FROM mail_threads WHERE id = $1 LIMIT 1 -- ["id-1"]
=> null
