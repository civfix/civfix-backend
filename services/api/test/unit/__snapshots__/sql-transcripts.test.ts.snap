SELECT c.id, CASE WHEN c.status = 'cancelled' THEN 'cancelled' WHEN c.ends_at <= now() THEN 'done' WHEN c.scheduled_at <= now() THEN 'active' ELSE 'upcoming' END AS status, c.visibility, c.capacity, c.title, c.description, c.reference_code, ST_X(c.geom) AS lng, ST_Y(c.geom) AS lat, c.scheduled_at, c.ends_at, c.timezone, c.address, c.registration_opens_at, c.registration_closes_at, c.page_slug, c.organizer_user_id, c.organization_id FROM cleanups c WHERE c.id = $1 LIMIT 1 -- ["cleanup_id-row"]
