exports[`sql transcripts > attachRegistrationFields 1`] = `
"-- empty
SELECT t.id, t.cleanup_id, t.name, t.description, t.capacity, t.reserved_seats, COALESCE(sold.n, 0)::int AS sold, t.sales_opens_at, t.sales_closes_at, t.visibility, (t.access_code_hash IS NOT NULL) AS has_access_code, t.max_party_size, t.sort_order, t.waitlist_enabled, qs.ids AS question_ids FROM cleanup_ticket_types t LEFT JOIN LATERAL ( SELECT COALESCE(sum(r.party_size), 0)::int AS n FROM cleanup_registrations r WHERE r.ticket_type_id = t.id AND r.status = 'registered' ) sold ON true LEFT JOIN LATERAL ( SELECT array_agg(q.id ORDER BY q.sort_order, q.id) AS ids FROM cleanup_questions q WHERE q.ticket_type_id = t.id AND q.archived_at IS NULL ) qs ON true WHERE t.cleanup_id = ANY($1::uuid[]) ORDER BY t.cleanup_id, t.sort_order, t.id -- [["id-1"]]
SELECT r.id, r.cleanup_id, r.ticket_type_id, tt.name AS ticket_type_name, r.user_id, r.guest_id, g.name AS guest_name, r.party_size, r.status, r.source, r.host_note, r.registered_at, r.cancelled_at, ci.first_at AS checked_in_at, sc.slot_id, sl.title AS slot_title, ap.preview AS answers_preview, u.display_name AS person_display_name, u.handle AS person_handle, u.bio AS person_bio, u.avatar_url AS person_avatar_url, u.deleted_at AS person_deleted_at FROM cleanup_registrations r LEFT JOIN cleanup_ticket_types tt ON tt.id = r.ticket_type_id LEFT JOIN cleanup_guests g ON g.id = r.guest_id LEFT JOIN users u ON u.id = r.user_id LEFT JOIN cleanup_slot_claims sc ON sc.cleanup_id = r.cleanup_id AND sc.user_id = r.user_id LEFT JOIN cleanup_slots sl ON sl.id = sc.slot_id LEFT JOIN LATERAL ( SELECT min(s.checked_in_at) AS first_at FROM cleanup_registration_seats s WHERE s.registration_id = r.id AND s.checked_in_at IS NOT NULL ) ci ON true LEFT JOIN LATERAL ( SELECT left(string_agg(a.value_text, ' | ' ORDER BY a.created_at), $1) AS preview FROM cleanup_answers a WHERE a.registration_id = r.id AND a.scrubbed_at IS NULL AND a.value_text IS NOT NULL ) ap ON true WHERE r.cleanup_id = ANY($2::uuid[]) AND r.user_id = $3 AND r.status = 'registered' -- [120,["id-1"],"viewerUserId-1"]
=> [{"lat":3,"lng":3,"type":"route","status":"active","organizer":{"id":"id-1","name":"name-1","followers":3,"following":3,"isFollowing":true,"handle":"handle-1","avatar":["avatar0-1","avatar1-1"],"avatarUrl":"avatarUrl-1","organization":{"verified":true,"id":"id-1","slug":"slug-1","name":"name-1","logoUrl":"logoUrl-1","verifiedKind":"nonprofit"},"bio":"bio-1","donationUrl":"donationUrl-1","deleted":true},"slots":[{"claimed":3,"id":"id-1","title":"title-1","sortOrder":3,"description":"description-1","capacity":3,"mine":true,"startsAt":"startsAt-1","endsAt":"endsAt-1"}],"id":"id-1","title":"title-1","eventKind":"cleanup","scheduledAt":"scheduledAt-1","going":3,"visibility":"public","address":"address-1","myCapabilities":["view_event_private"],"joined":true,"bring":["bringItem-1"],"linkedReports":[{"lat":3,"lng":3,"status":"submitted","id":"id-1","title":"title-1","category":"trash","linkedAt":"linkedAt-1","type":"graffiti","thumbUrl":"thumbUrl-1","addr":"addr-1"}],"galleryUrls":["galleryUrl-1"],"ticketTypes":[],"organization":{"verified":true,"id":"id-1","slug":"slug-1","name":"name-1","logoUrl":"logoUrl-1","verifiedKind":"nonprofit","donationUrl":"donationUrl-1"},"donationUrl":"donationUrl-1","description":"description-1","capacity":3,"endsAt":"endsAt-1","timezone":"timezone-1","referenceCode":"referenceCode-1","jurisdictionGeoid":"jurisdictionGeoid-1","myRole":"coordinator","coverUrl":"coverUrl-1","registeredCount":3,"checkedInCount":3,"waitlistCount":3,"pageSlug":"pageSlug-1","pageStatus":"published","addressSource":"resolved","dist":3,"slotCount":3,"guestCount":3,"donationClicks":3,"registrationOpensAt":"registrationOpensAt-1","registrationClosesAt":"registrationClosesAt-1","registrationState":"closed","myRegistration":null,"teamCount":3,"reminderOffsetsMinutes":[3]}]
-- row
SELECT t.id, t.cleanup_id, t.name, t.description, t.capacity, t.reserved_seats, COALESCE(sold.n, 0)::int AS sold, t.sales_opens_at, t.sales_closes_at, t.visibility, (t.access_code_hash IS NOT NULL) AS has_access_code, t.max_party_size, t.sort_order, t.waitlist_enabled, qs.ids AS question_ids FROM cleanup_ticket_types t LEFT JOIN LATERAL ( SELECT COALESCE(sum(r.party_size), 0)::int AS n FROM cleanup_registrations r WHERE r.ticket_type_id = t.id AND r.status = 'registered' ) sold ON true LEFT JOIN LATERAL ( SELECT array_agg(q.id ORDER BY q.sort_order, q.id) AS ids FROM cleanup_questions q WHERE q.ticket_type_id = t.id AND q.archived_at IS NULL ) qs ON true WHERE t.cleanup_id = ANY($1::uuid[]) ORDER BY t.cleanup_id, t.sort_order, t.id -- [["id-1"]]
SELECT r.id, r.cleanup_id, r.ticket_type_id, tt.name AS ticket_type_name, r.user_id, r.guest_id, g.name AS guest_name, r.party_size, r.status, r.source, r.host_note, r.registered_at, r.cancelled_at, ci.first_at AS checked_in_at, sc.slot_id, sl.title AS slot_title, ap.preview AS answers_preview, u.display_name AS person_display_name, u.handle AS person_handle, u.bio AS person_bio, u.avatar_url AS person_avatar_url, u.deleted_at AS person_deleted_at FROM cleanup_registrations r LEFT JOIN cleanup_ticket_types tt ON tt.id = r.ticket_type_id LEFT JOIN cleanup_guests g ON g.id = r.guest_id LEFT JOIN users u ON u.id = r.user_id LEFT JOIN cleanup_slot_claims sc ON sc.cleanup_id = r.cleanup_id AND sc.user_id = r.user_id LEFT JOIN cleanup_slots sl ON sl.id = sc.slot_id LEFT JOIN LATERAL ( SELECT min(s.checked_in_at) AS first_at FROM cleanup_registration_seats s WHERE s.registration_id = r.id AND s.checked_in_at IS NOT NULL ) ci ON true LEFT JOIN LATERAL ( SELECT left(string_agg(a.value_text, ' | ' ORDER BY a.created_at), $1) AS preview FROM cleanup_answers a WHERE a.registration_id = r.id AND a.scrubbed_at IS NULL AND a.value_text IS NOT NULL ) ap ON true WHERE r.cleanup_id = ANY($2::uuid[]) AND r.user_id = $3 AND r.status = 'registered' -- [120,["id-1"],"viewerUserId-1"]
