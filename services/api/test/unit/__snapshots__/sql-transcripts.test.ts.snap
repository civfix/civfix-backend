[tx1] SELECT id FROM users WHERE id = $1 AND deleted_at IS NULL LIMIT 1 -- ["id-1"]
[tx1] INSERT INTO user_moderation (user_id, account_status, updated_at) VALUES ($1, $2, now()) ON CONFLICT (user_id) DO UPDATE SET account_status = EXCLUDED.account_status, updated_at = now() -- ["id-1","active"]
[tx1] INSERT INTO audit_log (actor_id, action, target, meta) VALUES ($1, $2, $3, $4) RETURNING id -- ["actorId-1","user.status_changed","user:id-1",{"<json>":{"status":"active","reason":"reason-1"}}]
COMMIT tx1
=> true"
`;

