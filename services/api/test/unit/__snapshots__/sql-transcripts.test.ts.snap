exports[`sql transcripts > makeDrizzleVolunteerHoursRepository.totalsFor 1`] = `
"-- empty
SELECT ujh.jurisdiction_geoid AS geoid, j.name AS name, ujh.total_hours::float8 AS hours FROM user_jurisdiction_hours ujh JOIN jurisdictions j ON j.geoid = ujh.jurisdiction_geoid WHERE ujh.user_id = $1 AND ujh.total_hours > 0 ORDER BY ujh.total_hours DESC, ujh.jurisdiction_geoid -- ["userId-1"]
SELECT o.id, o.slug, o.name, COALESCE(<helper ["am"]>.served_key, CASE WHEN <helper ["am"]>.status = 'validating' THEN <helper ["am"]>.r2_key END) AS logo_key, o.verified_status, o.verified_kind, sum(vh.hours)::float8 AS hours FROM volunteer_hours vh JOIN cleanups c ON c.id = vh.cleanup_id JOIN organizations o ON o.id = c.organization_id LEFT JOIN media_assets am ON am.id = o.logo_media_id WHERE vh.user_id = $1 AND vh.source = 'event' AND vh.voided_at IS NULL AND o.deleted_at IS NULL AND o.suspended_at IS NULL GROUP BY o.id, o.slug, o.name, am.id, o.verified_status, o.verified_kind ORDER BY sum(vh.hours) DESC, o.id LIMIT $2 -- ["userId-1",20]
SELECT ( (SELECT COALESCE(SUM(total_hours), 0) FROM user_jurisdiction_hours WHERE user_id = $1 AND total_hours > 0) + (SELECT COALESCE(SUM(hours), 0) FROM volunteer_hours WHERE user_id = $2 AND voided_at IS NULL AND source <> 'report' AND jurisdiction_geoid IS NULL) )::float8 AS total -- ["userId-1","userId-1"]
=> {"totalHours":0,"byJurisdiction":[],"byOrganization":[]}
-- row
SELECT ujh.jurisdiction_geoid AS geoid, j.name AS name, ujh.total_hours::float8 AS hours FROM user_jurisdiction_hours ujh JOIN jurisdictions j ON j.geoid = ujh.jurisdiction_geoid WHERE ujh.user_id = $1 AND ujh.total_hours > 0 ORDER BY ujh.total_hours DESC, ujh.jurisdiction_geoid -- ["userId-1"]
SELECT o.id, o.slug, o.name, COALESCE(<helper ["am"]>.served_key, CASE WHEN <helper ["am"]>.status = 'validating' THEN <helper ["am"]>.r2_key END) AS logo_key, o.verified_status, o.verified_kind, sum(vh.hours)::float8 AS hours FROM volunteer_hours vh JOIN cleanups c ON c.id = vh.cleanup_id JOIN organizations o ON o.id = c.organization_id LEFT JOIN media_assets am ON am.id = o.logo_media_id WHERE vh.user_id = $1 AND vh.source = 'event' AND vh.voided_at IS NULL AND o.deleted_at IS NULL AND o.suspended_at IS NULL GROUP BY o.id, o.slug, o.name, am.id, o.verified_status, o.verified_kind ORDER BY sum(vh.hours) DESC, o.id LIMIT $2 -- ["userId-1",20]
SELECT ( (SELECT COALESCE(SUM(total_hours), 0) FROM user_jurisdiction_hours WHERE user_id = $1 AND total_hours > 0) + (SELECT COALESCE(SUM(hours), 0) FROM volunteer_hours WHERE user_id = $2 AND voided_at IS NULL AND source <> 'report' AND jurisdiction_geoid IS NULL) )::float8 AS total -- ["userId-1","userId-1"]
=> {"totalHours":2,"byJurisdiction":[{"geoid":"geoid-row","name":"name-row","hours":"hours-row"}],"byOrganization":[{"organizationId":"id-row","slug":"slug-row","name":"name-row","logoKey":"logo_key-row","verified":false,"verifiedKind":"verified_kind-row","hours":"hours-row"}]}"
`;

