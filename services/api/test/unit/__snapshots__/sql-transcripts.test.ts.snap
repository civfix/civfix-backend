exports[`sql transcripts > makeDataExportService.exportData 1`] = `
"-- empty
SELECT id, display_name, handle, email, email_verified, bio, avatar_url, donation_url, created_at, deleted_at FROM users WHERE id = $1 LIMIT 1 -- ["userId-1"]
SELECT r.id, r.category, r.title, r.description, j.name AS place, r.status, r.created_at FROM reports r LEFT JOIN jurisdictions j ON j.geoid = r.jurisdiction_geoid WHERE r.reporter_user_id = $1 ORDER BY r.created_at DESC LIMIT $2 -- ["userId-1",50001]
SELECT id, kind, body, visibility, reply_to_id, repost_of_id, created_at, updated_at, deleted_at FROM posts WHERE author_id = $1 ORDER BY created_at DESC LIMIT $2 -- ["userId-1",5001]
SELECT id, cleanup_id, report_id, group_id, body, created_at, deleted_at FROM chat_messages WHERE sender_id = $1 ORDER BY created_at DESC LIMIT $2 -- ["userId-1",5001]
SELECT id, thread_id, body, created_at, deleted_at FROM dm_messages WHERE sender_id = $1 ORDER BY created_at DESC LIMIT $2 -- ["userId-1",5001]
SELECT id, source, report_id, cleanup_id, jurisdiction_geoid, hours::float8 AS hours, logged_by_user_id, created_at FROM volunteer_hours WHERE user_id = $1 ORDER BY created_at DESC LIMIT $2 -- ["userId-1",50001]
SELECT id, title, created_at FROM cleanups WHERE organizer_user_id = $1 ORDER BY created_at DESC LIMIT $2 -- ["userId-1",50001]
SELECT cleanup_id, role, joined_at FROM cleanup_members WHERE user_id = $1 ORDER BY joined_at DESC LIMIT $2 -- ["userId-1",50001]
SELECT followee_id FROM follows_people WHERE follower_id = $1 LIMIT $2 -- ["userId-1",50001]
SELECT follower_id FROM follows_people WHERE followee_id = $1 LIMIT $2 -- ["userId-1",50001]
SELECT blocked_id FROM user_blocks WHERE blocker_id = $1 LIMIT $2 -- ["userId-1",50001]
SELECT user_id, push, cleanup_chat, report_updates, follows, quiet_start, quiet_end, mentions, host_broadcasts FROM notification_prefs WHERE user_id = $1 LIMIT 1 -- ["userId-1"]
SELECT id, platform, created_at, revoked_at FROM push_tokens WHERE user_id = $1 LIMIT $2 -- ["userId-1",50001]
SELECT code, locale, holder_name, holder_handle, total_hours::float8 AS total_hours, entry_count, period_start, period_end, document_sha256, byte_size, issued_at, revoked_at, revoked_reason FROM service_hours_certificates WHERE user_id = $1 ORDER BY issued_at DESC LIMIT $2 -- ["userId-1",50001]
SELECT om.organization_id, o.slug, o.name, om.role, om.joined_at FROM organization_members om JOIN organizations o ON o.id = om.organization_id WHERE om.user_id = $1 ORDER BY om.joined_at DESC LIMIT $2 -- ["userId-1",50001]
SELECT cleanup_id, role, joined_at FROM cleanup_members WHERE user_id = $1 AND role <> 'member' ORDER BY joined_at DESC NULLS LAST LIMIT $2 -- ["userId-1",50001]
SELECT cleanup_id, terms_version, disclosure_version, host_contact_opt_in, sms_opt_in, accepted_at FROM event_consents WHERE user_id = $1 ORDER BY accepted_at DESC LIMIT $2 -- ["userId-1",50001]
SELECT r.id, r.cleanup_id, t.name AS ticket_type_name, r.party_size, r.status, r.source, r.registered_at, r.cancelled_at FROM cleanup_registrations r LEFT JOIN cleanup_ticket_types t ON t.id = r.ticket_type_id WHERE r.user_id = $1 ORDER BY r.registered_at DESC LIMIT $2 -- ["userId-1",50001]
SELECT a.cleanup_id, q.prompt, COALESCE(a.value_text, a.value_json::text) AS value FROM cleanup_answers a JOIN cleanup_questions q ON q.id = a.question_id JOIN cleanup_registrations r ON r.id = a.registration_id WHERE r.user_id = $1 AND a.scrubbed_at IS NULL ORDER BY a.created_at DESC LIMIT $2 -- ["userId-1",5001]
SELECT s.cleanup_id, s.seat_index, s.checked_in_at, s.checkin_method FROM cleanup_registration_seats s JOIN cleanup_registrations r ON r.id = s.registration_id WHERE r.user_id = $1 AND s.checked_in_at IS NOT NULL ORDER BY s.checked_in_at DESC LIMIT $2 -- ["userId-1",50001]
=> {"ok":true,"email":null}
