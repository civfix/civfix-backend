exports[`sql transcripts > makeDrizzleHostPortfolioRepository.kpisFor 1`] = `
"-- empty
WITH hosted AS ( SELECT m.cleanup_id AS id FROM cleanup_members m WHERE m.user_id = $1 AND m.role <> 'member' UNION SELECT oc.id FROM organization_members om JOIN organizations o ON o.id = om.organization_id AND o.deleted_at IS NULL JOIN cleanups oc ON oc.organization_id = om.organization_id WHERE om.user_id = $2 AND om.role <> 'member' ) SELECT count(*)::int AS events_hosted, count(*) FILTER ( WHERE c.status <> 'cancelled' AND c.ends_at > $3 )::int AS upcoming_events FROM hosted h JOIN cleanups c ON c.id = h.id WHERE TRUE AND c.organization_id = $4 -- ["userId-1","userId-1","2026-03-04T05:06:07.000Z","organizationId-1"]
=> {"eventsHosted":0,"upcomingEvents":0}
-- row
WITH hosted AS ( SELECT m.cleanup_id AS id FROM cleanup_members m WHERE m.user_id = $1 AND m.role <> 'member' UNION SELECT oc.id FROM organization_members om JOIN organizations o ON o.id = om.organization_id AND o.deleted_at IS NULL JOIN cleanups oc ON oc.organization_id = om.organization_id WHERE om.user_id = $2 AND om.role <> 'member' ) SELECT count(*)::int AS events_hosted, count(*) FILTER ( WHERE c.status <> 'cancelled' AND c.ends_at > $3 )::int AS upcoming_events FROM hosted h JOIN cleanups c ON c.id = h.id WHERE TRUE AND c.organization_id = $4 -- ["userId-1","userId-1","2026-03-04T05:06:07.000Z","organizationId-1"]
=> {"eventsHosted":"events_hosted-row","upcomingEvents":"upcoming_events-row"}"
`;

exports[`sql transcripts > makeDrizzleHostPortfolioRepository.listHostedEvents 1`] = `
"-- empty
WITH hosted AS ( SELECT m.cleanup_id AS id FROM cleanup_members m WHERE m.user_id = $1 AND m.role <> 'member' UNION SELECT oc.id FROM organization_members om JOIN organizations o ON o.id = om.organization_id AND o.deleted_at IS NULL JOIN cleanups oc ON oc.organization_id = om.organization_id WHERE om.user_id = $2 AND om.role <> 'member' ) SELECT c.id, c.reference_code, c.title, c.scheduled_at, c.ends_at, c.timezone, CASE WHEN c.status = 'cancelled' THEN 'cancelled' WHEN c.ends_at <= now() THEN 'done' WHEN c.scheduled_at <= now() THEN 'active' ELSE 'upcoming' END AS status, c.visibility, COALESCE(<helper ["ma"]>.served_key, CASE WHEN <helper ["ma"]>.status = 'validating' THEN <helper ["ma"]>.r2_key END) AS cover_key, c.capacity, c.page_slug, ( SELECT m.role FROM cleanup_members m WHERE m.cleanup_id = c.id AND m.user_id = $3 LIMIT 1 ) AS event_role, ( SELECT om.role FROM organization_members om WHERE om.organization_id = c.organization_id AND om.user_id = $4 LIMIT 1 ) AS org_role, o.id AS org_id, o.name AS org_name FROM hosted h JOIN cleanups c ON c.id = h.id LEFT JOIN media_assets ma ON ma.id = c.cover_media_id LEFT JOIN organizations o ON o.id = c.organization_id AND o.deleted_at IS NULL WHERE TRUE AND c.organization_id = $5 ORDER BY c.scheduled_at ASC, c.id ASC LIMIT $6 -- ["userId-1","userId-1","userId-1","userId-1","organizationId-1",4]
=> {"items":[],"nextCursor":null}
-- row
WITH hosted AS ( SELECT m.cleanup_id AS id FROM cleanup_members m WHERE m.user_id = $1 AND m.role <> 'member' UNION SELECT oc.id FROM organization_members om JOIN organizations o ON o.id = om.organization_id AND o.deleted_at IS NULL JOIN cleanups oc ON oc.organization_id = om.organization_id WHERE om.user_id = $2 AND om.role <> 'member' ) SELECT c.id, c.reference_code, c.title, c.scheduled_at, c.ends_at, c.timezone, CASE WHEN c.status = 'cancelled' THEN 'cancelled' WHEN c.ends_at <= now() THEN 'done' WHEN c.scheduled_at <= now() THEN 'active' ELSE 'upcoming' END AS status, c.visibility, COALESCE(<helper ["ma"]>.served_key, CASE WHEN <helper ["ma"]>.status = 'validating' THEN <helper ["ma"]>.r2_key END) AS cover_key, c.capacity, c.page_slug, ( SELECT m.role FROM cleanup_members m WHERE m.cleanup_id = c.id AND m.user_id = $3 LIMIT 1 ) AS event_role, ( SELECT om.role FROM organization_members om WHERE om.organization_id = c.organization_id AND om.user_id = $4 LIMIT 1 ) AS org_role, o.id AS org_id, o.name AS org_name FROM hosted h JOIN cleanups c ON c.id = h.id LEFT JOIN media_assets ma ON ma.id = c.cover_media_id LEFT JOIN organizations o ON o.id = c.organization_id AND o.deleted_at IS NULL WHERE TRUE AND c.organization_id = $5 ORDER BY c.scheduled_at ASC, c.id ASC LIMIT $6 -- ["userId-1","userId-1","userId-1","userId-1","organizationId-1",4]
=> {"items":[{"id":"id-row","referenceCode":"reference_code-row","title":"title-row","startsAt":"2026-03-04T05:06:07.000Z","endsAt":"2026-03-04T05:06:07.000Z","timezone":"timezone-row","status":"status-row","visibility":"visibility-row","coverKey":"cover_key-row","capacity":"capacity-row","eventRole":"event_role-row","orgRole":"org_role-row","orgId":"org_id-row","orgName":"org_name-row","pageSlug":"page_slug-row"}],"nextCursor":null}"
`;

exports[`sql transcripts > makeDrizzleHostRegistrationRepository.cancelRegistration 1`] = `
"-- empty
WITH cancelled AS ( UPDATE cleanup_registrations SET status = 'cancelled', cancelled_at = $1, cancelled_by = $2 WHERE id = $3 AND cleanup_id = $4 AND status = 'registered' RETURNING id, ticket_type_id, party_size ), seats AS ( UPDATE cleanup_registration_seats s SET status = 'cancelled' FROM cancelled c WHERE s.registration_id = c.id AND s.status = 'active' RETURNING s.id ), released AS ( UPDATE cleanup_ticket_types t SET reserved_seats = GREATEST(t.reserved_seats - c.party_size, 0), updated_at = $5 FROM cancelled c WHERE t.id = c.ticket_type_id RETURNING t.id ) SELECT id, ticket_type_id FROM cancelled -- ["2026-03-04T05:06:07.000Z","actorId-1","registrationId-1","cleanupId-1","2026-03-04T05:06:07.000Z"]
SELECT r.id, r.cleanup_id, r.ticket_type_id, tt.name AS ticket_type_name, r.user_id, r.guest_id, g.name AS guest_name, r.party_size, r.status, r.source, r.host_note, r.registered_at, r.cancelled_at, ci.first_at AS checked_in_at, sc.slot_id, sl.title AS slot_title, ap.preview AS answers_preview, u.display_name AS person_display_name, u.handle AS person_handle, u.bio AS person_bio, u.avatar_url AS person_avatar_url, u.deleted_at AS person_deleted_at FROM cleanup_registrations r LEFT JOIN cleanup_ticket_types tt ON tt.id = r.ticket_type_id LEFT JOIN cleanup_guests g ON g.id = r.guest_id LEFT JOIN users u ON u.id = r.user_id LEFT JOIN cleanup_slot_claims sc ON sc.cleanup_id = r.cleanup_id AND sc.user_id = r.user_id LEFT JOIN cleanup_slots sl ON sl.id = sc.slot_id LEFT JOIN LATERAL ( SELECT min(s.checked_in_at) AS first_at FROM cleanup_registration_seats s WHERE s.registration_id = r.id AND s.checked_in_at IS NOT NULL ) ci ON true LEFT JOIN LATERAL ( SELECT left(string_agg(a.value_text, ' | ' ORDER BY a.created_at), $1) AS preview FROM cleanup_answers a WHERE a.registration_id = r.id AND a.scrubbed_at IS NULL AND a.value_text IS NOT NULL ) ap ON true WHERE r.id = $2 AND r.cleanup_id = $3 LIMIT 1 -- [120,"registrationId-1","cleanupId-1"]
=> {"kind":"not_found"}
-- row
WITH cancelled AS ( UPDATE cleanup_registrations SET status = 'cancelled', cancelled_at = $1, cancelled_by = $2 WHERE id = $3 AND cleanup_id = $4 AND status = 'registered' RETURNING id, ticket_type_id, party_size ), seats AS ( UPDATE cleanup_registration_seats s SET status = 'cancelled' FROM cancelled c WHERE s.registration_id = c.id AND s.status = 'active' RETURNING s.id ), released AS ( UPDATE cleanup_ticket_types t SET reserved_seats = GREATEST(t.reserved_seats - c.party_size, 0), updated_at = $5 FROM cancelled c WHERE t.id = c.ticket_type_id RETURNING t.id ) SELECT id, ticket_type_id FROM cancelled -- ["2026-03-04T05:06:07.000Z","actorId-1","registrationId-1","cleanupId-1","2026-03-04T05:06:07.000Z"]
SELECT r.id, r.cleanup_id, r.ticket_type_id, tt.name AS ticket_type_name, r.user_id, r.guest_id, g.name AS guest_name, r.party_size, r.status, r.source, r.host_note, r.registered_at, r.cancelled_at, ci.first_at AS checked_in_at, sc.slot_id, sl.title AS slot_title, ap.preview AS answers_preview, u.display_name AS person_display_name, u.handle AS person_handle, u.bio AS person_bio, u.avatar_url AS person_avatar_url, u.deleted_at AS person_deleted_at FROM cleanup_registrations r LEFT JOIN cleanup_ticket_types tt ON tt.id = r.ticket_type_id LEFT JOIN cleanup_guests g ON g.id = r.guest_id LEFT JOIN users u ON u.id = r.user_id LEFT JOIN cleanup_slot_claims sc ON sc.cleanup_id = r.cleanup_id AND sc.user_id = r.user_id LEFT JOIN cleanup_slots sl ON sl.id = sc.slot_id LEFT JOIN LATERAL ( SELECT min(s.checked_in_at) AS first_at FROM cleanup_registration_seats s WHERE s.registration_id = r.id AND s.checked_in_at IS NOT NULL ) ci ON true LEFT JOIN LATERAL ( SELECT left(string_agg(a.value_text, ' | ' ORDER BY a.created_at), $1) AS preview FROM cleanup_answers a WHERE a.registration_id = r.id AND a.scrubbed_at IS NULL AND a.value_text IS NOT NULL ) ap ON true WHERE r.id = $2 AND r.cleanup_id = $3 LIMIT 1 -- [120,"id-row","cleanupId-1"]
SELECT id, registration_id, seat_index, attendee_name, status, checked_in_at, checked_in_by, checkin_method, checkin_coarsened_at, no_show_at FROM cleanup_registration_seats WHERE registration_id = ANY($1::uuid[]) ORDER BY registration_id, seat_index -- [["id-row"]]
=> {"kind":"cancelled","registration":{"id":"id-row","cleanupId":"cleanup_id-row","ticketTypeId":"ticket_type_id-row","ticketTypeName":"ticket_type_name-row","userId":"user_id-row","guestId":"guest_id-row","guestName":"guest_name-row","identity":{"userId":"user_id-row","displayName":"person_display_name-row","handle":"person_handle-row","bio":"person_bio-row","avatarUrl":"person_avatar_url-row","deletedAt":"2026-03-04T05:06:07.000Z"},"partySize":"party_size-row","status":"status-row","source":"source-row","hostNote":"host_note-row","registeredAt":"2026-03-04T05:06:07.000Z","cancelledAt":"2026-03-04T05:06:07.000Z","checkedInAt":"2026-03-04T05:06:07.000Z","slotId":"slot_id-row","slotTitle":"slot_title-row","seats":[],"answersPreview":"answers_preview-row"},"ticketTypeId":"ticket_type_id-row"}"
`;

