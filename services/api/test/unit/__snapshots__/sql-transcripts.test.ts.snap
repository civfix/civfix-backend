exports[`sql transcripts > authorizeEventBound 1`] = `
"-- empty
SELECT c.visibility, EXISTS ( SELECT 1 FROM cleanup_members m WHERE m.cleanup_id = c.id AND m.user_id = $1::uuid ) OR EXISTS ( SELECT 1 FROM organization_members om JOIN organizations o ON o.id = om.organization_id AND o.deleted_at IS NULL WHERE om.organization_id = c.organization_id AND om.user_id = $2::uuid ) AS is_member FROM ( SELECT c.id, c.visibility, c.organization_id FROM cleanups c WHERE c.cover_media_id = $3::uuid OR c.gallery_media_ids @> ARRAY[$4::uuid] OR EXISTS ( SELECT 1 FROM cleanup_page_media pm WHERE pm.cleanup_id = c.id AND pm.media_id = $5::uuid ) ) c ORDER BY c.id LIMIT 1 -- ["viewerId-1","viewerId-1","id-1","id-1","id-1"]
SELECT ( EXISTS (SELECT 1 FROM users WHERE avatar_media_id = $1) OR EXISTS (SELECT 1 FROM chat_groups WHERE avatar_media_id = $2) ) AS is_avatar -- ["id-1","id-1"]
=> {"allowed":true,"private":true}
