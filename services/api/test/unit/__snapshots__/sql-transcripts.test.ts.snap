COMMIT tx1
=> {"kind":"not_found"}
-- row
BEGIN tx1
[tx1] SELECT id, capacity FROM cleanups WHERE id = $1 LIMIT 1 FOR NO KEY UPDATE -- ["cleanupId-1"]
[tx1] SELECT count(*)::int AS n FROM cleanup_ticket_types WHERE cleanup_id = $1 -- ["cleanupId-1"]
[tx1] SELECT sum(capacity)::int AS used, bool_or(capacity IS NULL) AS unlimited FROM cleanup_ticket_types WHERE cleanup_id = $1 -- ["cleanupId-1"]
COMMIT tx1
