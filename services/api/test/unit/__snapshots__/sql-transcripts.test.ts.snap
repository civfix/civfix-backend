exports[`sql transcripts > makeDrizzleAdminReportRepository.getOutreach 1`] = `
"-- empty
SELECT t.id AS thread_id, t.status AS thread_status, EXISTS ( SELECT 1 FROM mail_messages m WHERE m.thread_id = t.id AND m.direction = 'in' ) AS has_inbound, ( SELECT m.to_addr FROM mail_messages m WHERE m.thread_id = t.id AND m.direction = 'out' AND m.to_addr IS NOT NULL AND m.to_addr <> '' ORDER BY m.created_at DESC, m.id DESC LIMIT 1 ) AS routed_to, ( SELECT MIN(m.created_at) FROM mail_messages m WHERE m.thread_id = t.id AND m.direction = 'out' ) AS routed_at, EXISTS ( SELECT 1 FROM mail_messages m WHERE m.thread_id = t.id AND m.direction = 'out' AND COALESCE(m.kind, 'packet') = 'packet' ) AS packet_sent, ( NOT EXISTS ( SELECT 1 FROM mail_events e WHERE e.thread_id = t.id AND e.type = 'sent' ) AND COALESCE( ( SELECT CASE WHEN EXISTS ( SELECT 1 FROM mail_events e WHERE e.thread_id = t.id AND e.message_id = latest.id::text AND e.type = $1 AND COALESCE(e.meta->>'reason', '') <> 'deadline' ) THEN true WHEN EXISTS ( SELECT 1 FROM mail_events e WHERE e.thread_id = t.id AND e.message_id = latest.id::text AND e.type = $2 AND e.meta->>'reason' = 'deadline' AND e.created_at > now() - make_interval(secs => $3) ) THEN false WHEN EXISTS ( SELECT 1 FROM mail_events e WHERE e.thread_id = t.id AND e.message_id = latest.id::text AND e.type = $4 ) THEN true ELSE latest.created_at < now() - make_interval(secs => $5) END FROM ( SELECT m.id, m.created_at FROM mail_messages m WHERE m.thread_id = t.id AND m.direction = 'out' ORDER BY m.created_at DESC, m.id DESC LIMIT 1 ) latest ), false ) ) AS send_failed, ( COALESCE( ( SELECT EXISTS ( SELECT 1 FROM mail_events e WHERE e.thread_id = t.id AND e.message_id = latest.id::text AND e.type = $6 AND e.meta->>'reason' = 'deadline' AND e.created_at > now() - make_interval(secs => $7) ) AND NOT EXISTS ( SELECT 1 FROM mail_events e WHERE e.thread_id = t.id AND e.message_id = latest.id::text AND e.type = $8 ) FROM ( SELECT m.id, m.created_at FROM mail_messages m WHERE m.thread_id = t.id AND m.direction = 'out' ORDER BY m.created_at DESC, m.id DESC LIMIT 1 ) latest ), false ) ) AS send_in_flight FROM mail_threads t WHERE t.report_id = $9 ORDER BY t.created_at DESC, t.id DESC LIMIT 1 -- ["failed","failed",900,"failed",900,"failed",900,"sent","id-1"]
=> {"status":"not_sent","threadId":null,"routedTo":null,"routedAt":null,"packetSent":false,"sendFailed":false,"sendInFlight":false}
-- row
SELECT t.id AS thread_id, t.status AS thread_status, EXISTS ( SELECT 1 FROM mail_messages m WHERE m.thread_id = t.id AND m.direction = 'in' ) AS has_inbound, ( SELECT m.to_addr FROM mail_messages m WHERE m.thread_id = t.id AND m.direction = 'out' AND m.to_addr IS NOT NULL AND m.to_addr <> '' ORDER BY m.created_at DESC, m.id DESC LIMIT 1 ) AS routed_to, ( SELECT MIN(m.created_at) FROM mail_messages m WHERE m.thread_id = t.id AND m.direction = 'out' ) AS routed_at, EXISTS ( SELECT 1 FROM mail_messages m WHERE m.thread_id = t.id AND m.direction = 'out' AND COALESCE(m.kind, 'packet') = 'packet' ) AS packet_sent, ( NOT EXISTS ( SELECT 1 FROM mail_events e WHERE e.thread_id = t.id AND e.type = 'sent' ) AND COALESCE( ( SELECT CASE WHEN EXISTS ( SELECT 1 FROM mail_events e WHERE e.thread_id = t.id AND e.message_id = latest.id::text AND e.type = $1 AND COALESCE(e.meta->>'reason', '') <> 'deadline' ) THEN true WHEN EXISTS ( SELECT 1 FROM mail_events e WHERE e.thread_id = t.id AND e.message_id = latest.id::text AND e.type = $2 AND e.meta->>'reason' = 'deadline' AND e.created_at > now() - make_interval(secs => $3) ) THEN false WHEN EXISTS ( SELECT 1 FROM mail_events e WHERE e.thread_id = t.id AND e.message_id = latest.id::text AND e.type = $4 ) THEN true ELSE latest.created_at < now() - make_interval(secs => $5) END FROM ( SELECT m.id, m.created_at FROM mail_messages m WHERE m.thread_id = t.id AND m.direction = 'out' ORDER BY m.created_at DESC, m.id DESC LIMIT 1 ) latest ), false ) ) AS send_failed, ( COALESCE( ( SELECT EXISTS ( SELECT 1 FROM mail_events e WHERE e.thread_id = t.id AND e.message_id = latest.id::text AND e.type = $6 AND e.meta->>'reason' = 'deadline' AND e.created_at > now() - make_interval(secs => $7) ) AND NOT EXISTS ( SELECT 1 FROM mail_events e WHERE e.thread_id = t.id AND e.message_id = latest.id::text AND e.type = $8 ) FROM ( SELECT m.id, m.created_at FROM mail_messages m WHERE m.thread_id = t.id AND m.direction = 'out' ORDER BY m.created_at DESC, m.id DESC LIMIT 1 ) latest ), false ) ) AS send_in_flight FROM mail_threads t WHERE t.report_id = $9 ORDER BY t.created_at DESC, t.id DESC LIMIT 1 -- ["failed","failed",900,"failed",900,"failed",900,"sent","id-1"]
=> {"status":"replied","threadId":"thread_id-row","routedTo":"routed_to-row","routedAt":"2026-03-04T05:06:07.000Z","packetSent":"packet_sent-row","sendFailed":"send_failed-row","sendInFlight":"send_in_flight-row"}"
`;

exports[`sql transcripts > makeDrizzleAdminReportRepository.getReport 1`] = `
"-- empty
SELECT r.id, r.category, r.status, r.visibility, EXISTS ( SELECT 1 FROM abuse_flags af WHERE af.subject_type = 'report' AND af.subject_id = r.id::text AND af.resolved_at IS NULL ) AS flagged, r.title, j.name AS place, COALESCE(NULLIF(r.addr, ''), j.name) AS address, r.description, ST_Y(r.geom) AS lat, ST_X(r.geom) AS lng, -- confirmations was the report_follows count; that table was dropped with the discussion system. -- Kept as a stable admin DTO field (always 0 now) so the admin UI neighbors-confirmed row still parses. '0'::text AS confirmations, EXISTS (SELECT 1 FROM media_assets m WHERE m.report_id = r.id AND m.status = 'ready' AND m.served_key IS NOT NULL) AS has_photo, pm.id AS preview_id, pm.kind AS preview_kind, pm.served_key AS preview_key, pm.thumb_key AS preview_thumb_key, r.created_at, r.reference_code, r.verification_verdict, r.verified_at, -- The reporter's earned report-verified flag (D7); null for an anonymous report (no user_moderation -- row joins), false when the reporter has a user row but no moderation row yet. CASE WHEN u.id IS NULL THEN NULL ELSE COALESCE(um.report_verified, false) END AS reporter_report_verified, <helper ["u"]>.id AS <helper ["reporter_id"]>, <helper ["u"]>.display_name AS <helper ["reporter_name"]>, <helper ["u"]>.handle AS <helper ["reporter_handle"]>, <helper ["u"]>.email_verified AS <helper ["reporter_email_verified"]>, EXISTS (SELECT 1 FROM oauth_identities oi WHERE oi.user_id = <helper ["u"]>.id) AS <helper ["reporter_has_oauth"]>, <helper ["u"]>.created_at AS <helper ["reporter_joined"]> FROM reports r LEFT JOIN jurisdictions j ON j.geoid = r.jurisdiction_geoid LEFT JOIN users u ON u.id = r.reporter_user_id LEFT JOIN user_moderation um ON um.user_id = r.reporter_user_id LEFT JOIN LATERAL ( SELECT pa.id, pa.kind, pa.served_key, pa.thumb_key FROM media_assets pa WHERE pa.report_id = r.id AND pa.status = 'ready' AND pa.served_key IS NOT NULL ORDER BY (pa.kind = 'image') DESC, pa.created_at ASC, pa.id ASC LIMIT 1 ) pm ON TRUE WHERE r.deleted_at IS NULL AND r.id = $1 LIMIT 1 -- ["id-1"]
=> null
-- row
SELECT r.id, r.category, r.status, r.visibility, EXISTS ( SELECT 1 FROM abuse_flags af WHERE af.subject_type = 'report' AND af.subject_id = r.id::text AND af.resolved_at IS NULL ) AS flagged, r.title, j.name AS place, COALESCE(NULLIF(r.addr, ''), j.name) AS address, r.description, ST_Y(r.geom) AS lat, ST_X(r.geom) AS lng, -- confirmations was the report_follows count; that table was dropped with the discussion system. -- Kept as a stable admin DTO field (always 0 now) so the admin UI neighbors-confirmed row still parses. '0'::text AS confirmations, EXISTS (SELECT 1 FROM media_assets m WHERE m.report_id = r.id AND m.status = 'ready' AND m.served_key IS NOT NULL) AS has_photo, pm.id AS preview_id, pm.kind AS preview_kind, pm.served_key AS preview_key, pm.thumb_key AS preview_thumb_key, r.created_at, r.reference_code, r.verification_verdict, r.verified_at, -- The reporter's earned report-verified flag (D7); null for an anonymous report (no user_moderation -- row joins), false when the reporter has a user row but no moderation row yet. CASE WHEN u.id IS NULL THEN NULL ELSE COALESCE(um.report_verified, false) END AS reporter_report_verified, <helper ["u"]>.id AS <helper ["reporter_id"]>, <helper ["u"]>.display_name AS <helper ["reporter_name"]>, <helper ["u"]>.handle AS <helper ["reporter_handle"]>, <helper ["u"]>.email_verified AS <helper ["reporter_email_verified"]>, EXISTS (SELECT 1 FROM oauth_identities oi WHERE oi.user_id = <helper ["u"]>.id) AS <helper ["reporter_has_oauth"]>, <helper ["u"]>.created_at AS <helper ["reporter_joined"]> FROM reports r LEFT JOIN jurisdictions j ON j.geoid = r.jurisdiction_geoid LEFT JOIN users u ON u.id = r.reporter_user_id LEFT JOIN user_moderation um ON um.user_id = r.reporter_user_id LEFT JOIN LATERAL ( SELECT pa.id, pa.kind, pa.served_key, pa.thumb_key FROM media_assets pa WHERE pa.report_id = r.id AND pa.status = 'ready' AND pa.served_key IS NOT NULL ORDER BY (pa.kind = 'image') DESC, pa.created_at ASC, pa.id ASC LIMIT 1 ) pm ON T