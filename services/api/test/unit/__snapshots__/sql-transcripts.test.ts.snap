exports[`sql transcripts > makeDrizzlePostRepository.listSaves 1`] = `
"-- empty
SELECT p.id, p.author_id, p.kind, p.body, p.reply_to_id, p.thread_root_id, p.repost_of_id, p.event_id, p.report_id, p.like_count, p.repost_count, p.reply_count, p.save_count, p.organization_id, p.created_at, p.updated_at , ps.created_at AS saved_at FROM post_saves ps JOIN posts p ON p.id = ps.post_id WHERE ps.user_id = $1 AND p.deleted_at IS NULL AND p.visibility = 'public' AND NOT EXISTS ( SELECT 1 FROM user_blocks b WHERE (b.blocker_id = $2 AND b.blocked_id = p.author_id) OR (b.blocker_id = p.author_id AND b.blocked_id = $3) ) ORDER BY ps.created_at DESC, ps.post_id DESC LIMIT $4 -- ["viewerId-1","viewerId-1","viewerId-1",4]
=> {"items":[],"nextCursor":null}
-- row
SELECT p.id, p.author_id, p.kind, p.body, p.reply_to_id, p.thread_root_id, p.repost_of_id, p.event_id, p.report_id, p.like_count, p.repost_count, p.reply_count, p.save_count, p.organization_id, p.created_at, p.updated_at , ps.created_at AS saved_at FROM post_saves ps JOIN posts p ON p.id = ps.post_id WHERE ps.user_id = $1 AND p.deleted_at IS NULL AND p.visibility = 'public' AND NOT EXISTS ( SELECT 1 FROM user_blocks b WHERE (b.blocker_id = $2 AND b.blocked_id = p.author_id) OR (b.blocker_id = p.author_id AND b.blocked_id = $3) ) ORDER BY ps.created_at DESC, ps.post_id DESC LIMIT $4 -- ["viewerId-1","viewerId-1","viewerId-1",4]
SELECT u.id, u.display_name, u.handle, u.bio, u.follower_count AS followers, u.following_count AS following, COALESCE(<helper ["am"]>.served_key, CASE WHEN <helper ["am"]>.status = 'validating' THEN <helper ["am"]>.r2_key END) AS avatar_r2_key, u.avatar_url, u.deleted_at, EXISTS ( SELECT 1 FROM follows_people f WHERE f.follower_id = $1 AND f.followee_id = u.id ) AS is_following FROM users u LEFT JOIN media_assets am ON am.id = u.avatar_media_id WHERE u.id = ANY($2::uuid[]) -- ["viewerId-1",["author_id-row"]]
SELECT post_id, id, kind, codec, served_key AS r2_key, thumb_key, status, width, height FROM media_assets WHERE post_id = ANY($1::uuid[]) AND status = 'ready' AND served_key IS NOT NULL ORDER BY post_id, created_at ASC -- [["id-row"]]
SELECT m.<helper ["post_id"]> AS mkey, u.id, u.handle, u.display_name FROM <helper ["post_mentions"]> m JOIN users u ON u.id = m.mentioned_user_id WHERE m.<helper ["post_id"]> IN <helper [["id-row"]]> ORDER BY m.<helper ["post_id"]> ASC, u.handle ASC, u.id ASC -- []
SELECT p.id, p.kind, p.body, p.event_id, p.report_id, p.like_count, p.repost_count, p.reply_count, p.save_count, p.created_at, p.deleted_at, p.visibility, p.organization_id, u.id AS author_id, u.display_name, u.handle, u.bio, u.avatar_url FROM posts p LEFT JOIN users u ON u.id = p.author_id AND u.deleted_at IS NULL WHERE p.id = ANY($1::uuid[]) AND NOT EXISTS ( SELECT 1 FROM user_blocks b WHERE (b.blocker_id = $2 AND b.blocked_id = p.author_id) OR (b.blocker_id = p.author_id AND b.blocked_id = $3) ) -- [["repost_of_id-row","reply_to_id-row"],"viewerId-1","viewerId-1"]
SELECT post_id FROM post_likes WHERE user_id = $1 AND post_id = ANY($2::uuid[]) -- ["viewerId-1",["id-row"]]
SELECT post_id FROM post_saves WHERE user_id = $1 AND post_id = ANY($2::uuid[]) -- ["viewerId-1",["id-row"]]
SELECT repost_of_id FROM posts WHERE kind = 'repost' AND author_id = $1 AND repost_of_id = ANY($2::uuid[]) AND deleted_at IS NULL -- ["viewerId-1",["id-row"]]
SELECT c.id, c.title, c.event_kind, CASE WHEN c.status = 'cancelled' THEN 'cancelled' WHEN c.ends_at <= now() THEN 'done' WHEN c.scheduled_at <= now() THEN 'active' ELSE 'upcoming' END AS status, c.scheduled_at, c.ends_at, c.timezone, ST_Y(c.geom) AS lat, ST_X(c.geom) AS lng, ((SELECT count(*)::int FROM cleanup_members m WHERE m.cleanup_id = c.id) + ( SELECT count(*)::int FROM cleanup_guests cg WHERE cg.cleanup_id = c.id AND cg.cancelled_at IS NULL )) AS going, u.id AS org_id, u.display_name AS org_name, u.handle AS org_handle, u.bio AS org_bio, u.avatar_url AS org_avatar_url, u.donation_url AS org_donation_url FROM cleanups c JOIN users u ON u.id = c.organizer_user_id WHERE c.id = ANY($1::uuid[]) AND c.visibility = 'public' -- [["event_id-row"]]
SELECT r.id, r.category, r.type, r.title, r.status, ST_Y(r.geom) AS lat, ST_X(r.geom) AS lng, r.addr, m.thumb_key, m.r2_key AS thumb_r2_key FROM reports r LEFT JOIN LATERAL ( SELECT thumb_key, served_key AS r2_key FROM media_assets WHERE report_id = r.id AND status = 'ready' AND served_key IS NOT NULL AND (kind = 'image' OR thumb_key IS NOT NULL) ORDER BY created_at ASC, id ASC LIMIT 1 ) m ON true WHERE r.id = ANY($1::uuid[]) AND r.status = ANY($2::text[]) AND r.visibility = 'public' AND r.deleted_at IS NULL -- [["report_id-row"],["published","acknowledged","in_progress","resolved"]]
SELECT o.id, o.slug, o.name, o.verified_status, o.verified_kind, COALESCE(<helper ["am"]>.served_key, CASE WHEN <helper ["am"]>.status = 'validating' THEN <helper ["am"]>.r2_key END) AS logo_key FROM organizations o LEFT JOIN media_assets am ON am.id = o.logo_media_id WHERE o.id = ANY($1::uuid[]) AND o.deleted_at IS NULL -- [["organization_id-row"]]
=> {"items":[],"nextCursor":null}"
`;

