BEGIN tx1
[tx1] SELECT status, now() AS now FROM cleanups WHERE id = $1 LIMIT 1 FOR NO KEY UPDATE -- ["cleanupId-1"]
[tx1] DELETE FROM cleanup_members WHERE cleanup_id = $1 AND user_id = $2 AND role <> 'organizer' RETURNING user_id -- ["cleanupId-1","userId-1"]
[tx1] WITH cancelled AS ( UPDATE cleanup_registrations SET status = 'cancelled', cancelled_at = $1, cancelled_by = $2 WHERE cleanup_id = $3 AND user_id = $4 AND status = 'registered' AND ticket_type_id IS NULL RETURNING id ), seats AS ( UPDATE cleanup_registration_seats s SET status = 'cancelled' FROM cancelled c WHERE s.registration_id = c.id AND s.status = 'active' RETURNING s.id ) SELECT id FROM cancelled -- ["now-row","actorId-1","cleanupId-1","userId-1"]
[tx1] INSERT INTO cleanup_bans (cleanup_id, user_id, banned_by_user_id) VALUES ($1, $2, $3) ON CONFLICT (cleanup_id, user_id) DO NOTHING -- ["cleanupId-1","userId-1","actorId-1"]
[tx1] DELETE FROM cleanup_slot_claims WHERE cleanup_id = $1 AND user_id = $2 -- ["cleanupId-1","userId-1"]
[tx1] SELECT (SELECT count(*)::int FROM cleanup_members m WHERE m.cleanup_id = $1) + ( SELECT count(*)::int FROM cleanup_guests cg WHERE cg.cleanup_id = $2 AND cg.cancelled_at IS NULL ) AS count -- ["cleanupId-1","cleanupId-1"]
COMMIT tx1
=> {"kind":"removed","going":2}"
`;

