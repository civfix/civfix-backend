exports[`sql transcripts > makeDrizzleThreadsRepository.listThreadsFor 1`] = `
"-- empty
WITH page AS ( SELECT r.id AS room_id, mem.joined_at AS joined_at, mem.last_read_at AS last_read_at, date_trunc('milliseconds', COALESCE(last_msg.created_at, mem.joined_at)) AS activity FROM <helper ["cleanup_members"]> mem JOIN <helper ["cleanups"]> r ON r.id = mem.<helper ["cleanup_id"]> LEFT JOIN LATERAL ( SELECT cm.created_at FROM chat_messages cm WHERE cm.<helper ["cleanup_id"]> = r.id AND cm.deleted_at IS NULL ORDER BY cm.created_at DESC, cm.id DESC LIMIT 1 ) last_msg ON TRUE LEFT JOIN conversation_hides h ON h.user_id = $1 AND h.room_kind = $2 AND h.room_id = r.id WHERE mem.user_id = $3 AND (h.hidden_at IS NULL OR COALESCE(last_msg.created_at, mem.joined_at) > h.hidden_at) AND date_trunc('milliseconds', COALESCE(last_msg.created_at, mem.joined_at)) < $4 AND (date_trunc('milliseconds', COALESCE(last_msg.created_at, mem.joined_at)) < $5 OR r.id < $6::uuid) ORDER BY date_trunc('milliseconds', COALESCE(last_msg.created_at, mem.joined_at)) DESC, r.id DESC LIMIT $7 ) SELECT page.room_id, r.title, page.joined_at, (SELECT count(*)::int FROM <helper ["cleanup_members"]> m WHERE m.<helper ["cleanup_id"]> = page.room_id) AS members, ( SELECT count(*)::int FROM chat_messages cm WHERE cm.<helper ["cleanup_id"]> = page.room_id AND cm.deleted_at IS NULL AND cm.sender_id IS DISTINCT FROM $8 AND cm.created_at > GREATEST(page.joined_at, COALESCE(page.last_read_at, to_timestamp(0))) ) AS unread, last_msg.body AS last_body, last_msg.created_at AS last_created_at, last_msg.sender_id AS last_sender_id FROM page JOIN <helper ["cleanups"]> r ON r.id = page.room_id LEFT JOIN LATERAL ( SELECT cm.body, cm.created_at, cm.sender_id FROM chat_messages cm WHERE cm.<helper ["cleanup_id"]> = page.room_id AND cm.deleted_at IS NULL ORDER BY cm.created_at DESC, cm.id DESC LIMIT 1 ) last_msg ON TRUE ORDER BY page.activity DESC, page.room_id DESC -- ["userId-1","cleanup","userId-1","2026-03-04T05:06:07.001Z","2026-03-04T05:06:07.000Z","id-1",3,"userId-1"]
=> []
-- row
WITH page AS ( SELECT r.id AS room_id, mem.joined_at AS joined_at, mem.last_read_at AS last_read_at, date_trunc('milliseconds', COALESCE(last_msg.created_at, mem.joined_at)) AS activity FROM <helper ["cleanup_members"]> mem JOIN <helper ["cleanups"]> r ON r.id = mem.<helper ["cleanup_id"]> LEFT JOIN LATERAL ( SELECT cm.created_at FROM chat_messages cm WHERE cm.<helper ["cleanup_id"]> = r.id AND cm.deleted_at IS NULL ORDER BY cm.created_at DESC, cm.id DESC LIMIT 1 ) last_msg ON TRUE LEFT JOIN conversation_hides h ON h.user_id = $1 AND h.room_kind = $2 AND h.room_id = r.id WHERE mem.user_id = $3 AND (h.hidden_at IS NULL OR COALESCE(last_msg.created_at, mem.joined_at) > h.hidden_at) AND date_trunc('milliseconds', COALESCE(last_msg.created_at, mem.joined_at)) < $4 AND (date_trunc('milliseconds', COALESCE(last_msg.created_at, mem.joined_at)) < $5 OR r.id < $6::uuid) ORDER BY date_trunc('milliseconds', COALESCE(last_msg.created_at, mem.joined_at)) DESC, r.id DESC LIMIT $7 ) SELECT page.room_id, r.title, page.joined_at, (SELECT count(*)::int FROM <helper ["cleanup_members"]> m WHERE m.<helper ["cleanup_id"]> = page.room_id) AS members, ( SELECT count(*)::int FROM chat_messages cm WHERE cm.<helper ["cleanup_id"]> = page.room_id AND cm.deleted_at IS NULL AND cm.sender_id IS DISTINCT FROM $8 AND cm.created_at > GREATEST(page.joined_at, COALESCE(page.last_read_at, to_timestamp(0))) ) AS unread, last_msg.body AS last_body, last_msg.created_at AS last_created_at, last_msg.sender_id AS last_sender_id FROM page JOIN <helper ["cleanups"]> r ON r.id = page.room_id LEFT JOIN LATERAL ( SELECT cm.body, cm.created_at, cm.sender_id FROM chat_messages cm WHERE cm.<helper ["cleanup_id"]> = page.room_id AND cm.deleted_at IS NULL ORDER BY cm.created_at DESC, cm.id DESC LIMIT 1 ) last_msg ON TRUE ORDER BY page.activity DESC, page.room_id DESC -- ["userId-1","cleanup","userId-1","2026-03-04T05:06:07.001Z","2026-03-04T05:06:07.000Z","id-1",3,"userId-1"]
=> [{"cleanupId":"room_id-row","title":"title-row","joinedAt":"2026-03-04T05:06:07.000Z","members":"members-row","unread":"unread-row","last":{"body":"last_body-row","createdAt":"2026-03-04T05:06:07.000Z","senderId":"last_sender_id-row"}}]"
`;

