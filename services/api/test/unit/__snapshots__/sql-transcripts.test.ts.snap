exports[`sql transcripts > makeDrizzleHostRegistrationRepository.savePage 1`] = `
"-- empty
BEGIN tx1
[tx1] SELECT id FROM cleanups WHERE id = $1 LIMIT 1 FOR SHARE -- ["cleanupId-1"]
COMMIT tx1
=> {"kind":"not_found"}
-- row
BEGIN tx1
[tx1] SELECT id FROM cleanups WHERE id = $1 LIMIT 1 FOR SHARE -- ["cleanupId-1"]
[tx1] UPDATE media_assets SET purpose = CASE WHEN media_assets.purpose IN ('event_cover', 'event_gallery') THEN media_assets.purpose ELSE 'event_gallery' END WHERE media_assets.id = ANY($1::uuid[]) AND media_assets.purpose <> 'verification' AND media_assets.report_id IS NULL AND media_assets.post_id IS NULL AND media_assets.chat_message_id IS NULL AND ( media_assets.status = 'ready' OR (media_assets.status = 'validating' AND media_assets.finalized_at IS NOT NULL) ) AND NOT ( EXISTS (SELECT 1 FROM users u WHERE u.avatar_media_id = media_assets.id) OR EXISTS (SELECT 1 FROM chat_groups cg WHERE cg.avatar_media_id = media_assets.id) OR EXISTS (SELECT 1 FROM organizations og WHERE og.logo_media_id = media_assets.id) OR EXISTS ( SELECT 1 FROM cleanups oc WHERE ( oc.cover_media_id = media_assets.id OR oc.gallery_media_ids @> ARRAY[media_assets.id] ) AND ($2::uuid IS NULL OR oc.id <> $3::uuid) ) OR EXISTS ( SELECT 1 FROM cleanup_page_media pm WHERE pm.media_id = media_assets.id AND ($4::uuid IS NULL OR pm.cleanup_id <> $5::uuid) ) ) AND ( ( EXISTS ( SELECT 1 FROM cleanups cur WHERE cur.id = $6::uuid AND ( cur.cover_media_id = media_assets.id OR cur.gallery_media_ids @> ARRAY[media_assets.id] ) ) OR EXISTS ( SELECT 1 FROM cleanup_page_media pm WHERE pm.cleanup_id = $7::uuid AND pm.media_id = media_assets.id ) ) OR media_assets.created_at > now() - make_interval(secs => $8) ) RETURNING media_assets.id -- [["blockMediaId-1"],"cleanupId-1","cleanupId-1","cleanupId-1","cleanupId-1","cleanupId-1","cleanupId-1",21600]
[tx1] UPDATE media_assets SET purpose = 'event_cover' WHERE media_assets.id = ANY($1::uuid[]) AND media_assets.purpose <> 'verification' AND media_assets.report_id IS NULL AND media_assets.post_id IS NULL AND media_assets.chat_message_id IS NULL AND ( media_assets.status = 'ready' OR (media_assets.status = 'validating' AND media_assets.finalized_at IS NOT NULL) ) AND NOT ( EXISTS (SELECT 1 FROM users u WHERE u.avatar_media_id = media_assets.id) OR EXISTS (SELECT 1 FROM chat_groups cg WHERE cg.avatar_media_id = media_assets.id) OR EXISTS (SELECT 1 FROM organizations og WHERE og.logo_media_id = media_assets.id) OR EXISTS ( SELECT 1 FROM cleanups oc WHERE ( oc.cover_media_id = media_assets.id OR oc.gallery_media_ids @> ARRAY[media_assets.id] ) AND ($2::uuid IS NULL OR oc.id <> $3::uuid) ) OR EXISTS ( SELECT 1 FROM cleanup_page_media pm WHERE pm.media_id = media_assets.id AND ($4::uuid IS NULL OR pm.cleanup_id <> $5::uuid) ) ) AND ( ( EXISTS ( SELECT 1 FROM cleanups cur WHERE cur.id = $6::uuid AND ( cur.cover_media_id = media_assets.id OR cur.gallery_media_ids @> ARRAY[media_assets.id] ) ) OR EXISTS ( SELECT 1 FROM cleanup_page_media pm WHERE pm.cleanup_id = $7::uuid AND pm.media_id = media_assets.id ) ) OR media_assets.created_at > now() - make_interval(secs => $8) ) RETURNING media_assets.id -- [["coverMediaId-1"],"cleanupId-1","cleanupId-1","cleanupId-1","cleanupId-1","cleanupId-1","cleanupId-1",21600]
[tx1] UPDATE cleanups SET cover_media_id = $1 WHERE id = $2 -- ["coverMediaId-1","cleanupId-1"]
[tx1] DELETE FROM cleanup_page_media WHERE cleanup_id = $1 AND NOT (media_id = ANY($2::uuid[])) -- ["cleanupId-1",["blockMediaId-1"]]
[tx1] INSERT INTO cleanup_page_media (cleanup_id, media_id) SELECT $1::uuid, t.id FROM unnest($2::uuid[]) AS t(id) ON CONFLICT (cleanup_id, media_id) DO NOTHING -- ["cleanupId-1",["blockMediaId-1"]]
[tx1] UPDATE cleanups SET page_slug = $1 WHERE id = $2 -- ["slug-1","cleanupId-1"]
[tx1] INSERT INTO cleanup_pages ( cleanup_id, status, theme_accent, blocks, seo, created_at, updated_at ) VALUES ( $1, 'draft', $2, $3, COALESCE($4, '{}'::jsonb), $5, $6 ) ON CONFLICT (cleanup_id) DO UPDATE SET theme_accent = COALESCE($7, cleanup_pages.theme_accent), blocks = EXCLUDED.blocks, seo = COALESCE($8, cleanup_pages.seo), updated_at = $9 -- ["cleanupId-1","bloom",{"<json>":[{"kind":"hero","id":"id-1","headline":"headline-1","subhead":"subhead-1","mediaId":"mediaId-1","imageUrl":"imageUrl-1"}]},{"<json>":{"noindex":true,"title":"title-1","description":"description-1"}},"2026-03-04T05:06:07.000Z","2026-03-04T05:06:07.000Z","bloom",{"<json>":{"noindex":true,"title":"title-1","description":"description-1"}},"2026-03-04T05:06:07.000Z"]
[tx1] SELECT c.id AS cleanup_id, c.page_slug AS slug, COALESCE(p.status, 'draft') AS status, COALESCE(p.theme_accent, 'bloom') AS theme_accent, p.blocks, p.seo, c.cover_media_id, m.r2_key AS cover_key, c.visibility, p.published_at, p.updated_at, p.flagged_at, p.flag_reason, COALESCE(p.view_count, 0) AS view_count FROM cleanups c LEFT JOIN cleanup_pages p ON p.cleanup_id = c.id LEFT JOIN media_assets m ON m.id = c.cover_media_id AND m.status = 'ready' WHERE c.id = $1 LIMIT 1 -- ["cleanupId-1"]
COMMIT tx1
=> {"kind":"saved","record":{"cleanupId":"cleanup_id-row","slug":"slug-row","status":"status-row","themeAccent":"theme_accent-row","blocks":"blocks-row","seo":"seo-row","coverMediaId":"cover_media_id-row","coverKey":"cover_key-row","visibility":"visibility-row","publishedAt":"2026-03-04T05:06:07.000Z","updatedAt":"2026-03-04T05:06:07.000Z","flaggedAt":"2026-03-04T05:06:07.000Z","flagReason":"flag_reason-row","viewCount":2}}"
`;

