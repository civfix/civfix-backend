exports[`sql transcripts > makeDrizzleVolunteerHoursRepository.leaderboard 1`] = `
"-- empty
SELECT name FROM jurisdictions WHERE geoid = $1 LIMIT 1 -- ["geoid-1"]
SELECT ujh.user_id, u.display_name AS name, u.handle, u.avatar_url, EXISTS ( SELECT 1 FROM user_blocks b WHERE ujh.user_id <> $1 AND ((b.blocker_id = $2 AND b.blocked_id = ujh.user_id) OR (b.blocker_id = ujh.user_id AND b.blocked_id = $3)) ) AS blocked_pair, ujh.total_hours::float8 AS hours FROM user_jurisdiction_hours ujh JOIN users u ON u.id = ujh.user_id WHERE ujh.jurisdiction_geoid = $4 AND ujh.total_hours > 0 AND u.deleted_at IS NULL AND u.show_volunteer_hours IS NOT FALSE ORDER BY ujh.total_hours DESC, ujh.user_id LIMIT $5 OFFSET $6 -- ["viewerId-1","viewerId-1","viewerId-1","geoid-1",4,3]
WITH me AS ( SELECT ujh.total_hours FROM user_jurisdiction_hours ujh JOIN users u ON u.id = ujh.user_id WHERE ujh.user_id = $1 AND ujh.jurisdiction_geoid = $2 AND ujh.total_hours > 0 AND u.deleted_at IS NULL AND u.show_volunteer_hours IS NOT FALSE ) SELECT (SELECT total_hours::float8 FROM me) AS hours, CASE WHEN EXISTS (SELECT 1 FROM me) THEN ( SELECT count(*)::int + 1 FROM user_jurisdiction_hours o JOIN users ou ON ou.id = o.user_id WHERE o.jurisdiction_geoid = $3 AND o.total_hours > (SELECT total_hours FROM me) AND o.total_hours > 0 AND ou.deleted_at IS NULL AND ou.show_volunteer_hours IS NOT FALSE ) END AS rank -- ["viewerId-1","geoid-1","geoid-1"]
=> {"jurisdictionName":null,"entries":[],"nextOffset":null,"participantCount":null,"viewerRank":null,"viewerHours":null}
-- row
SELECT name FROM jurisdictions WHERE geoid = $1 LIMIT 1 -- ["geoid-1"]
SELECT ujh.user_id, u.display_name AS name, u.handle, u.avatar_url, EXISTS ( SELECT 1 FROM user_blocks b WHERE ujh.user_id <> $1 AND ((b.blocker_id = $2 AND b.blocked_id = ujh.user_id) OR (b.blocker_id = ujh.user_id AND b.blocked_id = $3)) ) AS blocked_pair, ujh.total_hours::float8 AS hours FROM user_jurisdiction_hours ujh JOIN users u ON u.id = ujh.user_id WHERE ujh.jurisdiction_geoid = $4 AND ujh.total_hours > 0 AND u.deleted_at IS NULL AND u.show_volunteer_hours IS NOT FALSE ORDER BY ujh.total_hours DESC, ujh.user_id LIMIT $5 OFFSET $6 -- ["viewerId-1","viewerId-1","viewerId-1","geoid-1",4,3]
WITH me AS ( SELECT ujh.total_hours FROM user_jurisdiction_hours ujh JOIN users u ON u.id = ujh.user_id WHERE ujh.user_id = $1 AND ujh.jurisdiction_geoid = $2 AND ujh.total_hours > 0 AND u.deleted_at IS NULL AND u.show_volunteer_hours IS NOT FALSE ) SELECT (SELECT total_hours::float8 FROM me) AS hours, CASE WHEN EXISTS (SELECT 1 FROM me) THEN ( SELECT count(*)::int + 1 FROM user_jurisdiction_hours o JOIN users ou ON ou.id = o.user_id WHERE o.jurisdiction_geoid = $3 AND o.total_hours > (SELECT total_hours FROM me) AND o.total_hours > 0 AND ou.deleted_at IS NULL AND ou.show_volunteer_hours IS NOT FALSE ) END AS rank -- ["viewerId-1","geoid-1","geoid-1"]
=> {"jurisdictionName":"name-row","entries":[{"rank":4,"userId":"user_id-row","hours":"hours-row","name":"Community member","avatar":["#9B7ED9","#74A9D8"]}],"nextOffset":null,"participantCount":null,"viewerRank":"rank-row","viewerHours":"hours-row"}"
`;

