UPDATE cleanup_registrations r SET host_note = NULL WHERE r.id IN ( SELECT r2.id FROM cleanup_registrations r2 JOIN cleanups c ON c.id = r2.cleanup_id WHERE r2.host_note IS NOT NULL AND COALESCE(c.ends_at, c.scheduled_at) < $1 LIMIT $2 ) RETURNING r.id -- ["2025-12-04T05:06:07.000Z",500]
