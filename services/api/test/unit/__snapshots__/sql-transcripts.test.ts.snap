COMMIT tx1
=> false
-- row
BEGIN tx1
[tx1] SELECT id FROM users WHERE id = $1 AND deleted_at IS NULL LIMIT 1 -- ["id-1"]
[tx1] INSERT INTO user_moderation (user_id, report_verified, report_verified_at, report_verified_by, updated_at) VALUES ($1, $2, now(), $3, now()) ON CONFLICT (user_id) DO UPDATE SET report_verified = $4, report_verified_at = now(), report_verified_by = $5, updated_at = now() -- ["id-1",true,"actorId-1",true,"actorId-1"]
[tx1] INSERT INTO audit_log (actor_id, action, target, meta) VALUES ($1, $2, $3, $4) RETURNING id -- ["actorId-1","user.report_verified","user:id-1",{"<json>":{}}]
COMMIT tx1
=> true"
`;

exports[`sql transcripts > makeDrizzleAdminUserRepository.setStatus 1`] = `
