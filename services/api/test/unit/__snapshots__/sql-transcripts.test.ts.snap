WITH ids AS ( SELECT id AS cleanup_id FROM cleanups WHERE organizer_user_id = $1 UNION SELECT cleanup_id FROM cleanup_members WHERE user_id = $2 ) SELECT c.id, c.organizer_user_id, c.type, c.event_kind, c.title, c.description, ST_X(c.geom) AS lng, ST_Y(c.geom) AS lat, c.scheduled_at, c.completed_at, c.ends_at, c.timezone, CASE WHEN c.status = 'cancelled' THEN 'cancelled' WHEN c.ends_at <= now() THEN 'done' WHEN c.scheduled_at <= now() THEN 'active' ELSE 'upcoming' END AS status, c.bring, c.address, c.address_source, c.jurisdiction_geoid, c.reference_code, c.created_at, c.capacity, c.visibility, ((SELECT count(*)::int FROM cleanup_members m WHERE m.cleanup_id = c.id) + ( SELECT count(*)::int FROM cleanup_guests cg WHERE cg.cleanup_id = c.id AND cg.cancelled_at IS NULL )) AS going, u.display_name AS org_display_name, u.handle AS org_handle, u.bio AS org_bio, u.avatar_url AS org_avatar_url, u.donation_url AS org_donation_url FROM cleanups c JOIN ids ON ids.cleanup_id = c.id JOIN users u ON u.id = c.organizer_user_id WHERE c.status <> 'cancelled' AND c.visibility = 'public' AND c.scheduled_at >= now() ORDER BY c.scheduled_at ASC, c.id ASC LIMIT $3 -- ["userId-1","userId-1",3]
=> []
