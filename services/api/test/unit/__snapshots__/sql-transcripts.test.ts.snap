exports[`sql transcripts > makeDrizzleActivityRepository.list 1`] = `
"-- empty
SELECT feed.* FROM (( SELECT 'audit'::text AS source, a.id::text AS id, a.created_at AS ts, u.display_name AS who, a.target AS where_label, a.action AS action, NULL::text AS event_type, a.target AS subject FROM audit_log a LEFT JOIN users u ON u.id = a.actor_id -- audit_log carries the L4 read audits too (one row per sensitive PAGE VIEW). Those are -- navigation, not activity: unfiltered they fill this branch's whole per-source window and evict -- every real action from the feed. They remain in the audit-log view. WHERE a.action <> ALL($1) AND (a.action ILIKE $2 ESCAPE '\\' OR u.display_name ILIKE $3 ESCAPE '\\' OR a.target ILIKE $4 ESCAPE '\\') ORDER BY a.created_at DESC, a.id::text DESC LIMIT $5 ) UNION ALL ( SELECT 'report'::text AS source, r.id::text AS id, r.created_at AS ts, ru.display_name AS who, j.name AS where_label, NULL::text AS action, NULL::text AS event_type, r.category AS subject FROM reports r LEFT JOIN users ru ON ru.id = r.reporter_user_id LEFT JOIN jurisdictions j ON j.geoid = r.jurisdiction_geoid WHERE r.deleted_at IS NULL AND r.visibility = 'public' AND (r.category ILIKE $6 ESCAPE '\\' OR ru.display_name ILIKE $7 ESCAPE '\\' OR j.name ILIKE $8 ESCAPE '\\') -- reports.created_at is DEFAULT now() (effectively non-null on every row), so ordering on the -- bare column lets the (created_at) index serve the sort instead of a seq-scan+top-N heap sort. ORDER BY r.created_at DESC, r.id::text DESC LIMIT $9 ) UNION ALL ( SELECT 'cleanup'::text AS source, c.id::text AS id, c.created_at AS ts, cu.display_name AS who, c.address AS where_label, NULL::text AS action, NULL::text AS event_type, c.title AS subject FROM cleanups c LEFT JOIN users cu ON cu.id = c.organizer_user_id WHERE true AND (c.title ILIKE $10 ESCAPE '\\' OR cu.display_name ILIKE $11 ESCAPE '\\' OR c.address ILIKE $12 ESCAPE '\\') -- cleanups.created_at is DEFAULT now() (set on insert, effectively non-null), so ordering on the -- bare column lets the (created_at) index serve the sort. ORDER BY c.created_at DESC, c.id::text DESC LIMIT $13 ) UNION ALL ( SELECT 'mail_event'::text AS source, e.id::text AS id, e.created_at AS ts, t.org AS who, COALESCE(t.org, t.jurisdiction_geoid) AS where_label, NULL::text AS action, e.type AS event_type, t.subject AS subject FROM mail_events e LEFT JOIN mail_threads t ON t.id = e.thread_id WHERE true AND (e.type ILIKE $14 ESCAPE '\\' OR t.org ILIKE $15 ESCAPE '\\' OR t.jurisdiction_geoid ILIKE $16 ESCAPE '\\' OR t.subject ILIKE $17 ESCAPE '\\') ORDER BY e.created_at DESC, e.id::text DESC LIMIT $18 )) AS feed ORDER BY feed.ts DESC, feed.id DESC LIMIT $19 -- [["user.detail_viewed","user.messages_viewed","inbox.message_viewed","mail.thread_viewed","media.viewed","org.detail_viewed","org.verifications_viewed","org.list_viewed","org.members_viewed","org.events_viewed","event.roster_viewed","event.guests_viewed","event.answers_viewed"],"%q-1%","%q-1%","%q-1%",4,"%q-1%","%q-1%","%q-1%",4,"%q-1%","%q-1%","%q-1%",4,"%q-1%","%q-1%","%q-1%","%q-1%",4,4]
=> {"records":[],"nextCursor":null}
-- row
SELECT feed.* FROM (( SELECT 'audit'::text AS source, a.id::text AS id, a.created_at AS ts, u.display_name AS who, a.target AS where_label, a.action AS action, NULL::text AS event_type, a.target AS subject FROM audit_log a LEFT JOIN users u ON u.id = a.actor_id -- audit_log carries the L4 read audits too (one row per sensitive PAGE VIEW). Those are -- navigation, not activity: unfiltered they fill this branch's whole per-source window and evict -- every real action from the feed. They remain in the audit-log view. WHERE a.action <> ALL($1) AND (a.action ILIKE $2 ESCAPE '\\' OR u.display_name ILIKE $3 ESCAPE '\\' OR a.target ILIKE $4 ESCAPE '\\') ORDER BY a.created_at DESC, a.id::text DESC LIMIT $5 ) UNION ALL ( SELECT 'report'::text AS source, r.id::text AS id, r.created_at AS ts, ru.display_name AS who, j.name AS where_label, NULL::text AS action, NULL::text AS event_type, r.category AS subject FROM reports r LEFT JOIN users ru ON ru.id = r.reporter_user_id LEFT JOIN jurisdictions j ON j.geoid = r.jurisdiction_geoid WHERE r.deleted_at IS NULL AND r.visibility = 'public' AND (r.category ILIKE $6 ESCAPE '\\' OR ru.display_name ILIKE $7 ESCAPE '\\' OR j.name ILIKE $8 ESCAPE '\\') -- reports.created_at is DEFAULT now() (effectively non-null on every row), so ordering on the -- bare column lets the (created_at) index serve the sort instead of a seq-scan+top-N heap sort. ORDER BY r.created_at DESC, r.id::text DESC LIMIT $9 ) UNION ALL ( SELECT 'cleanup'::text AS source, c.id::text AS id, c.created_at AS ts, cu.display_name AS who, c.address AS where_label, NULL::text AS action, NULL::text AS event_type, c.title AS subject FROM cleanups c LEFT JOIN users cu ON cu.id = c.organizer_user_id WHERE true AND (c.title ILIKE $10 ESCAPE '\\' OR cu.display_name ILIKE $11 ESCAPE '\\' OR c.address ILIKE $12 ESCAPE '\\') -- cleanups.created_at is DEFAULT now() (set on insert, effectively non-null), so ordering on the -- bare column lets the (created_at) index serve the sort. ORDER BY c.created_at DESC, c.id::text DESC LIMIT $13 ) UNION ALL ( SELECT 'mail_event'::text AS source, e.id::text AS id, e.created_at AS ts, t.org AS who, COALESCE(t.org, t.jurisdiction_geoid) AS where_label, NULL::text AS action, e.type AS event_type, t.subject AS subject FROM mail_events e LEFT JOIN mail_threads t ON t.id = e.thread_id WHERE true AND (e.type ILIKE $14 ESCAPE '\\' OR t.org ILIKE $15 ESCAPE '\\' OR t.jurisdiction_geoid ILIKE $16 ESCAPE '\\' OR t.subject ILIKE $17 ESCAPE '\\') ORDER BY e.created_at DESC, e.id::text DESC LIMIT $18 )) AS feed ORDER BY feed.ts DESC, feed.id DESC LIMIT $19 -- [["user.detail_viewed","user.messages_viewed","inbox.message_viewed","mail.thread_viewed","media.viewed","org.detail_viewed","org.verifications_viewed","org.list_viewed","org.members_viewed","org.events_viewed","event.roster_viewed","event.guests_viewed","event.answers_viewed"],"%q-1%","%q-1%","%q-1%",4,"%q-1%","%q-1%","%q-1%",4,"%q-1%","%q-1%","%q-1%",4,"%q-1%","%q-1%","%q-1%","%q-1%",4,4]
=> {"records":[{"source":"source-row","id":"id-row","ts":"ts-row","who":"who-row","where":"where_label-row","action":"action-row","eventType":"event_type-row","subject":"subject-row"}],"nextCursor":null}"
`;

