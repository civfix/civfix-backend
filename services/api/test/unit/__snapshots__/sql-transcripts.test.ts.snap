RUE WHERE r.deleted_at IS NULL AND r.status = ANY($1) AND EXISTS ( SELECT 1 FROM abuse_flags af WHERE af.subject_type = 'report' AND af.subject_id = r.id::text AND af.resolved_at IS NULL ) AND r.verification_verdict IS NULL AND (r.title ILIKE $2 ESCAPE '\\' OR r.addr ILIKE $3 ESCAPE '\\' OR j.name ILIKE $4 ESCAPE '\\' OR u.display_name ILIKE $5 ESCAPE '\\' OR u.handle::text ILIKE $6 ESCAPE '\\' OR r.reference_code = upper(btrim($7))) ORDER BY r.created_at DESC, r.id DESC LIMIT $8 -- [["submitted"],"%q-1%","%q-1%","%q-1%","%q-1%","%q-1%","q-1",4]
