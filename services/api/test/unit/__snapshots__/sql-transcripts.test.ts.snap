exports[`sql transcripts > makeDrizzleAdminUserRepository.removeUserMessage 1`] = `
"-- empty
BEGIN tx1
[tx1] UPDATE chat_messages SET deleted_at = now() WHERE id = $1 AND sender_id = $2 AND deleted_at IS NULL RETURNING id -- ["messageId-1","userId-1"]
[tx1] UPDATE dm_messages SET deleted_at = now() WHERE id = $1 AND sender_id = $2 AND deleted_at IS NULL RETURNING id -- ["messageId-1","userId-1"]
COMMIT tx1
=> false
-- row
BEGIN tx1
[tx1] UPDATE chat_messages SET deleted_at = now() WHERE id = $1 AND sender_id = $2 AND deleted_at IS NULL RETURNING id -- ["messageId-1","userId-1"]
[tx1] INSERT INTO audit_log (actor_id, action, target, meta) VALUES ($1, $2, $3, $4) RETURNING id -- ["actorId-1","message.removed","message:messageId-1",{"<json>":{"userId":"userId-1","reason":"reason-1"}}]
COMMIT tx1
=> true"
`;

