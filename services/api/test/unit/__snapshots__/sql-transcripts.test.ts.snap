SELECT id, platform, created_at, revoked_at FROM push_tokens WHERE user_id = $1 LIMIT $2 -- ["userId-1",50001]
SELECT code, locale, holder_name, holder_handle, total_hours::float8 AS total_hours, entry_count, period_start, period_end, document_sha256, byte_size, issued_at, revoked_at, revoked_reason FROM service_hours_certificates WHERE user_id = $1 ORDER BY issued_at DESC LIMIT $2 -- ["userId-1",50001]
SELECT om.organization_id, o.slug, o.name, om.role, om.joined_at FROM organization_members om JOIN organizations o ON o.id = om.organization_id WHERE om.user_id = $1 ORDER BY om.joined_at DESC LIMIT $2 -- ["userId-1",50001]
SELECT cleanup_id, role, joined_at FROM cleanup_members WHERE user_id = $1 AND role <> 'member' ORDER BY joined_at DESC NULLS LAST LIMIT $2 -- ["userId-1",50001]
SELECT cleanup_id, terms_version, disclosure_version, host_contact_opt_in, sms_opt_in, accepted_at FROM event_consents WHERE user_id = $1 ORDER BY accepted_at DESC LIMIT $2 -- ["userId-1",50001]
