=> {"seats":0,"ofRegistered":0}
-- row
WITH prior AS ( SELECT c.id FROM cleanups c WHERE c.id = ANY($1::uuid[]) AND c.id <> $2 AND c.scheduled_at < (SELECT s.scheduled_at FROM cleanups s WHERE s.id = $3) ), roster AS ( SELECT r.party_size, (r.user_id IS NOT NULL AND EXISTS ( SELECT 1 FROM cleanup_registrations p WHERE p.user_id = r.user_id AND p.status = 'registered' AND p.cleanup_id IN (SELECT id FROM prior) )) AS is_returning FROM cleanup_registrations r WHERE r.cleanup_id = $4 AND r.status = 'registered' ) SELECT COALESCE(sum(party_size) FILTER (WHERE is_returning), 0)::text AS seats, COALESCE(sum(party_size), 0)::text AS of_registered FROM roster -- [["hostedEventId-1"],"cleanupId-1","cleanupId-1","cleanupId-1"]
=> {"seats":null,"ofRegistered":null}"
`;

exports[`sql transcripts > makeDrizzleAnalyticsRepository.seatTrend 1`] = `
"-- empty
WITH moves AS ( SELECT (registered_at AT TIME ZONE $1)::date AS at, party_size AS added, 0 AS removed FROM cleanup_registrations WHERE cleanup_id = $2 UNION ALL SELECT (cancelled_at AT TIME ZONE $3)::date AS at, 0 AS added, party_size AS removed FROM cleanup_registrations WHERE cleanup_id = $4 AND status = 'cancelled' AND cancelled_at IS NOT NULL ), days AS ( SELECT at, sum(added) AS added, sum(removed) AS removed FROM moves GROUP BY at ORDER BY at DESC LIMIT $5 ) SELECT to_char(at, 'YYYY-MM-DD') AS day, added::text AS added, removed::text AS removed FROM days ORDER BY at ASC -- ["timezone-1","cleanupId-1","timezone-1","cleanupId-1",400]
=> []
-- row
WITH moves AS ( SELECT (registered_at AT TIME ZONE $1)::date AS at, party_size AS added, 0 AS removed FROM cleanup_registrations WHERE cleanup_id = $2 UNION ALL SELECT (cancelled_at AT TIME ZONE $3)::date AS at, 0 AS added, party_size AS removed FROM cleanup_registrations WHERE cleanup_id = $4 AND status = 'cancelled' AND cancelled_at IS NOT NULL ), days AS ( SELECT at, sum(added) AS added, sum(removed) AS removed FROM moves GROUP BY at ORDER BY at DESC LIMIT $5 ) SELECT to_char(at, 'YYYY-MM-DD') AS day, added::text AS added, removed::text AS removed FROM days ORDER BY at ASC -- ["timezone-1","cleanupId-1","timezone-1","cleanupId-1",400]
=> [{"day":"day-row","added":null,"removed":null}]"
`;

exports[`sql transcripts > makeDrizzleAnalyticsRepository.signupsByDayAcross 1`] = `
"-- empty
SELECT to_char((registered_at AT TIME ZONE $1)::date, 'YYYY-MM-DD') AS day, count(*)::text AS n FROM cleanup_registrations WHERE cleanup_id = ANY($2::uuid[]) AND status = 'registered' AND (registered_at AT TIME ZONE $3)::date BETWEEN $4::date AND $5::date GROUP BY 1 ORDER BY 1 LIMIT 400 -- ["UTC",["cleanupId-1"],"UTC","fromDay-1","toDay-1"]
SELECT c.id::text AS key, c.title AS label, count(r.id)::text AS n FROM cleanups c JOIN cleanup_registrations r ON r.cleanup_id = c.id AND r.status = 'registered' AND (r.registered_at AT TIME ZONE $1)::date BETWEEN $2::date AND $3::date WHERE c.id = ANY($4::uuid[]) GROUP BY c.id, c.title ORDER BY 3 DESC, c.title ASC LIMIT $5 -- ["UTC","fromDay-1","toDay-1",["cleanupId-1"],12]
SELECT c.id::text AS key, c.title AS label, round(sum(vh.hours))::text AS n FROM cleanups c JOIN volunteer_hours vh ON vh.cleanup_id = c.id AND vh.source = 'event' AND vh.voided_at IS NULL AND (vh.created_at AT TIME ZONE $1)::date BETWEEN $2::date AND $3::date WHERE c.id = ANY($4::uuid[]) GROUP BY c.id, c.title ORDER BY sum(vh.hours) DESC, c.title ASC LIMIT $5 -- ["UTC","fromDay-1","toDay-1",["cleanupId-1"],12]
=> {"daily":[],"byEvent":[],"hoursByEvent":[]}
-- row
SELECT to_char((registered_at AT TIME ZONE $1)::date, 'YYYY-MM-DD') AS day, count(*)::text AS n FROM cleanup_registrations WHERE cleanup_id = ANY($2::uuid[]) AND status = 'registered' AND (registered_at AT TIME ZONE $3)::date BETWEEN $4::date AND $5::date GROUP BY 1 ORDER BY 1 LIMIT 400 -- ["UTC",["cleanupId-1"],"UTC","fromDay-1","toDay-1"]
SELECT c.id::text AS key, c.title AS label, count(r.id)::text AS n FROM cleanups c JOIN cleanup_registrations r ON r.cleanup_id = c.id AND r.status = 'registered' AND (r.registered_at AT TIME ZONE $1)::date BETWEEN $2::date AND $3::date WHERE c.id = ANY($4::uuid[]) GROUP BY c.id, c.title ORDER BY 3 DESC, c.title ASC LIMIT $5 -- ["UTC","fromDay-1","toDay-1",["cleanupId-1"],12]
SELECT c.id::text AS key, c.title AS label, round(sum(vh.hours))::text AS n FROM cleanups c JOIN volunteer_hours vh ON vh.cleanup_id = c.id AND vh.source = 'event' AND vh.voided_at IS NULL AND (vh.created_at AT TIME ZONE $1)::date BETWEEN $2::date AND $3::date WHERE c.id = ANY($4::uuid[]) GROUP BY c.id, c.title ORDER BY sum(vh.hours) DESC, c.title ASC LIMIT $5 -- ["UTC","fromDay-1","toDay-1",["cleanupId-1"],12]
=> {"daily":[{"day":"day-row","count":2}],"byEvent":[{"key":"key-row","label":"label-row","count":2}],"hoursByEvent":[{"key":"key-row","label":"label-row","count":2}]}"
`;

exports[`sql transcripts > makeDrizzleAnalyticsRepository.topContributors 1`] = `
"-- empty
WITH report_counts AS ( SELECT reporter_user_id AS user_id, COUNT(*)::int AS n FROM reports WHERE deleted_at IS NULL AND reporter_user_id IS NOT NULL GROUP BY reporter_user_id ), cleanup_counts AS ( SELECT organizer_user_id AS user_id, COUNT(*)::int AS n FROM cleanups GROUP BY organizer_user_id ), top AS ( SELECT t.user_id, t.total, COALESCE(rc.n, 0)::int AS reports, COALESCE(cc.n, 0)::int AS cleanups FROM ( SELECT user_id, SUM(n)::int AS total FROM ( SELECT user_id, n FROM report_counts UNION ALL SELECT user_id, n FROM cleanup_counts ) x GROUP BY user_id ) t LEFT JOIN report_counts rc ON rc.user_id = t.user_id LEFT JOIN cleanup_counts cc ON cc.user_id = t.user_id WHERE t.total > 0 ORDER BY t.total DESC, t.user_id ASC LIMIT $1 ), user_city AS ( SELECT DISTINCT ON (r.reporter_user_id) r.reporter_user_id AS user_id, j.name AS city FROM reports r JOIN jurisdictions j ON j.geoid = r.jurisdiction_geoid WHERE r.reporter_user_id IN (SELECT user_id FROM top) ORDER BY r.reporter_user_id, r.created_at DESC ) SELECT u.display_name AS name, uc.city AS city, top.reports::text AS reports, top.cleanups::text AS cleanups FROM top JOIN users u ON u.id = top.user_id LEFT JOIN user_city uc ON uc.user_id = top.user_id ORDER BY top.total DESC, u.id ASC -- [3]
=> []
-- row

=> []"
`;

exports[`sql transcripts > makeDrizzleAnalyticsRepository.topJurisdictions 1`] = `
"-- empty
WITH agg AS ( SELECT r.jurisdiction_geoid AS geoid, j.name AS name, j.layer AS layer, COUNT(*) AS pins, COUNT(*) FILTER (WHERE r.status = 'resolved') AS resolved FROM reports r LEFT JOIN jurisdictions j ON j.geoid = r.jurisdiction_geoid WHERE r.deleted_at IS NULL AND r.visibility = 'public' AND r.jurisdiction_geoid IS NOT NULL GROUP BY r.jurisdiction_geoid, j.name, j.layer ) SELECT CASE WHEN name IS NULL THEN geoid WHEN COUNT(*) OVER (PARTITION BY name) > 1 THEN name || ' (' || COALESCE(layer, geoid) || ')' ELSE name END AS org, pins::text AS pins, resolved::text AS resolved FROM agg ORDER BY pins DESC, geoid ASC LIMIT $1 -- [3]
=> []
-- row

=> []"
`;

