[tx1] INSERT INTO audit_log (actor_id, action, target, meta) VALUES ($1, $2, $3, $4) RETURNING id -- ["actorId-1","moderation.appeal_decided","moderation:id-1",{"<json>":{"decision":"uphold","subjectId":"subject_id-row","subjectType":"subject_type-row","restored":false,"note":"note-1"}}]
