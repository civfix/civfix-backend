SELECT COALESCE( ( SELECT EXISTS ( SELECT 1 FROM mail_events e WHERE e.thread_id = $1::uuid AND e.message_id = latest.id::text AND e.type = $2 AND e.meta->>'reason' = 'deadline' AND e.created_at > now() - make_interval(secs => $3) ) AND NOT EXISTS ( SELECT 1 FROM mail_events e WHERE e.thread_id = $4::uuid AND e.message_id = latest.id::text AND e.type = $5 ) FROM ( SELECT m.id, m.created_at FROM mail_messages m WHERE m.thread_id = $6::uuid AND m.direction = 'out' ORDER BY m.created_at DESC, m.id DESC LIMIT 1 ) latest ), false ) AS ok -- ["threadId-1","failed",900,"threadId-1","sent","threadId-1"]
