exports[`sql transcripts > makeDrizzleInboundRepository.setStatus 1`] = `
"-- empty
BEGIN tx1
[tx1] SELECT status FROM inbound_emails WHERE id = $1 LIMIT 1 FOR UPDATE -- ["id-1"]
COMMIT tx1
=> false
-- row
BEGIN tx1
[tx1] SELECT status FROM inbound_emails WHERE id = $1 LIMIT 1 FOR UPDATE -- ["id-1"]
[tx1] UPDATE inbound_emails SET status = $1, archived_at = CASE WHEN $2 THEN COALESCE(archived_at, now()) ELSE NULL END WHERE id = $3 -- ["unread",false,"id-1"]
[tx1] INSERT INTO audit_log (actor_id, action, target, meta) VALUES ($1, $2, $3, $4) RETURNING id -- ["actorId-1","inbox.status_changed","inbound_email:id-1",{"<json>":{"status":"unread","priorStatus":"status-row"}}]
COMMIT tx1
=> true"
`;

