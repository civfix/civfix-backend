=> []
-- row
SELECT r.id, r.category, r.title, r.status, ST_X(r.geom) AS lng, ST_Y(r.geom) AS lat, r.addr, m.thumb_key, cr.linked_at FROM cleanup_reports cr JOIN reports r ON r.id = cr.report_id LEFT JOIN LATERAL ( SELECT COALESCE(ma.thumb_key, ma.served_key) AS thumb_key FROM media_assets ma WHERE ma.report_id = r.id AND ma.status = 'ready' AND (ma.thumb_key IS NOT NULL OR ma.served_key IS NOT NULL) ORDER BY ma.created_at ASC LIMIT 1 ) m ON true WHERE cr.cleanup_id = $1 AND r.status = ANY($2::text[]) AND r.visibility = 'public' AND r.deleted_at IS NULL ORDER BY cr.linked_at DESC, r.id -- ["id-1",["published","acknowledged","in_progress","resolved"]]
=> [{"cleanupId":"id-1","id":"id-row","category":"category-row","title":"title-row","status":"status-row","lat":34.05,"lng":-118.24,"addr":"addr-row","thumbKey":"thumb_key-row","linkedAt":"2026-03-04T05:06:07.000Z"}]"
`;

exports[`sql transcripts > makeDrizzleAdminEventRepository.postMessage 1`] = `
"-- empty
BEGIN tx1
[tx1] SELECT id FROM cleanups WHERE id = $1 LIMIT 1 -- ["id-1"]
COMMIT tx1
=> null
-- row
BEGIN tx1
[tx1] SELECT id FROM cleanups WHERE id = $1 LIMIT 1 -- ["id-1"]
[tx1] INSERT INTO chat_messages (cleanup_id, sender_id, body, kind) VALUES ($1, $2, $3, 'text') RETURNING id -- ["id-1","00000000-0000-4000-8000-00000000c1f1","body-1"]
[tx1] INSERT INTO cleanup_timeline (cleanup_id, kind, note, actor_id) VALUES ($1, 'message', 'Posted an update to attendees', $2) -- ["id-1","actorId-1"]
[tx1] INSERT INTO notifications (user_id, type, title, body, link) SELECT cm.user_id, 'cleanup_chat', 'Cleanup update', $1, $2 FROM cleanup_members cm WHERE cm.cleanup_id = $3 RETURNING user_id -- ["body-1","/cleanups/id-1","id-1"]
[tx1] INSERT INTO audit_log (actor_id, action, target, meta) VALUES ($1, $2, $3, $4) RETURNING id -- ["actorId-1","event.message_posted","cleanup:id-1",{"<json>":{"members":1,"messageId":"id-row"}}]
COMMIT tx1
=> {"notified":1}"
`;

