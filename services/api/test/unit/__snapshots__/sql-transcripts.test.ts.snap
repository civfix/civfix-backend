exports[`sql transcripts > makeCleanupMapRepository.listCleanupPins 1`] = `
"-- empty
SELECT c.id, ST_X(c.geom) AS lng, ST_Y(c.geom) AS lat, c.scheduled_at, c.event_kind, ((SELECT count(*)::int FROM cleanup_members m WHERE m.cleanup_id = c.id) + ( SELECT count(*)::int FROM cleanup_guests cg WHERE cg.cleanup_id = c.id AND cg.cancelled_at IS NULL )) AS going FROM cleanups c WHERE TRUE AND ST_Intersects( c.geom, ST_MakeEnvelope($1, $2, $3, $4, 4326) ) AND c.status <> 'cancelled' AND c.ends_at > now() AND c.visibility = 'public' ORDER BY c.scheduled_at ASC LIMIT $5 -- [3,3,3,3,500]
=> []
-- row
SELECT c.id, ST_X(c.geom) AS lng, ST_Y(c.geom) AS lat, c.scheduled_at, c.event_kind, ((SELECT count(*)::int FROM cleanup_members m WHERE m.cleanup_id = c.id) + ( SELECT count(*)::int FROM cleanup_guests cg WHERE cg.cleanup_id = c.id AND cg.cancelled_at IS NULL )) AS going FROM cleanups c WHERE TRUE AND ST_Intersects( c.geom, ST_MakeEnvelope($1, $2, $3, $4, 4326) ) AND c.status <> 'cancelled' AND c.ends_at > now() AND c.visibility = 'public' ORDER BY c.scheduled_at ASC LIMIT $5 -- [3,3,3,3,500]
=> [{"id":"id-row","lat":34.05,"lng":-118.24,"scheduledAt":"2026-03-04T05:06:07.000Z","going":"going-row","eventKind":"event_kind-row"}]"
`;

