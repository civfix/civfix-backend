"-- empty
SELECT message_id, question, allow_multiple, anonymous, closed_at FROM chat_polls WHERE message_id = ANY($1::uuid[]) -- [["id-1"]]
SELECT o.poll_id, o.idx, o.text, COUNT(v.user_id)::int AS count, COUNT(*) FILTER (WHERE v.user_id = $1)::int AS mine_count FROM chat_poll_options o LEFT JOIN chat_poll_votes v ON v.poll_id = o.poll_id AND v.option_idx = o.idx WHERE o.poll_id = ANY($2::uuid[]) GROUP BY o.poll_id, o.idx, o.text ORDER BY o.poll_id, o.idx ASC -- ["viewerUserId-1",["id-1"]]
SELECT poll_id, COUNT(DISTINCT user_id)::int AS total FROM chat_poll_votes WHERE poll_id = ANY($1::uuid[]) GROUP BY poll_id -- [["id-1"]]
=> {"<map>":[]}
-- row
SELECT message_id, question, allow_multiple, anonymous, closed_at FROM chat_polls WHERE message_id = ANY($1::uuid[]) -- [["id-1"]]
SELECT o.poll_id, o.idx, o.text, COUNT(v.user_id)::int AS count, COUNT(*) FILTER (WHERE v.user_id = $1)::int AS mine_count FROM chat_poll_options o LEFT JOIN chat_poll_votes v ON v.poll_id = o.poll_id AND v.option_idx = o.idx WHERE o.poll_id = ANY($2::uuid[]) GROUP BY o.poll_id, o.idx, o.text ORDER BY o.poll_id, o.idx ASC -- ["viewerUserId-1",["id-1"]]
SELECT poll_id, COUNT(DISTINCT user_id)::int AS total FROM chat_poll_votes WHERE poll_id = ANY($1::uuid[]) GROUP BY poll_id -- [["id-1"]]
=> {"<map>":[["message_id-row",{"question":"question-row","options":[],"allowMultiple":"allow_multiple-row","anonymous":"anonymous-row","closed":true,"totalVoters":0,"myVote":[]}]]}"
`;

