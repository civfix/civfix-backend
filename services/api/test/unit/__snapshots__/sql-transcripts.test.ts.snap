=> {"all":0,"submitted":0,"in_progress":0,"completed":0,"flagged":0,"needsVerification":0}
-- row
SELECT COUNT(*) FILTER (WHERE r.status = ANY($1))::text AS submitted, COUNT(*) FILTER ( WHERE r.status = ANY($2) AND r.verification_verdict IS NULL )::text AS needs_verification, COUNT(*) FILTER (WHERE r.status = ANY($3))::text AS in_progress, COUNT(*) FILTER (WHERE r.status = ANY($4))::text AS completed, ( SELECT COUNT(DISTINCT af.subject_id) FROM abuse_flags af JOIN reports r ON r.id::text = af.subject_id LEFT JOIN jurisdictions j ON j.geoid = r.jurisdiction_geoid LEFT JOIN users u ON u.id = r.reporter_user_id WHERE af.subject_type = 'report' AND af.resolved_at IS NULL AND r.deleted_at IS NULL AND (r.title ILIKE $5 ESCAPE '\\' OR r.addr ILIKE $6 ESCAPE '\\' OR j.name ILIKE $7 ESCAPE '\\' OR u.display_name ILIKE $8 ESCAPE '\\' OR u.handle::text ILIKE $9 ESCAPE '\\' OR r.reference_code = upper(btrim($10))) )::text AS flagged FROM reports r LEFT JOIN jurisdictions j ON j.geoid = r.jurisdiction_geoid LEFT JOIN users u ON u.id = r.reporter_user_id WHERE r.deleted_at IS NULL AND (r.title ILIKE $11 ESCAPE '\\' OR r.addr ILIKE $12 ESCAPE '\\' OR j.name ILIKE $13 ESCAPE '\\' OR u.display_name ILIKE $14 ESCAPE '\\' OR u.handle::text ILIKE $15 ESCAPE '\\' OR r.reference_code = upper(btrim($16))) -- [["submitted","held","published"],["submitted","held","published"],["acknowledged","in_progress"],["resolved"],"%q-1%","%q-1%","%q-1%","%q-1%","%q-1%","q-1","%q-1%","%q-1%","%q-1%","%q-1%","%q-1%","q-1"]
=> {"all":null,"submitted":null,"in_progress":null,"completed":null,"flagged":null,"needsVerification":null}"
