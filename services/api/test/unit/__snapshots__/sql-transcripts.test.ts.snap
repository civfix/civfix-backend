exports[`sql transcripts > makeDrizzleJurisdictionContactsRepository.listDirectory 1`] = `
"-- empty
WITH waiting AS ( -- "Waiting" = open, un-routed reports: excludes acknowledged/in_progress (already routed) and -- rejected/resolved (closed). So reportsWaiting is the backlog needing a contact, and it drops -- as operators route those reports one by one. -- -- Aggregated ONCE for every geoid rather than per row. The page's COUNT(*) OVER() has to -- materialize the whole filtered set before OFFSET/LIMIT, so as a per-row LATERAL this aggregate -- ran for every jurisdiction matching the filter on every page view. SELECT r.jurisdiction_geoid AS geoid, COUNT(*) AS total, -- Oldest still-waiting report; shares the waiting predicate so it agrees with total. MIN(r.created_at) AS oldest_waiting_at, COUNT(*) FILTER (WHERE <helper ["r"]>.category = $1)::text AS <helper ["cat_trash"]>, COUNT(*) FILTER (WHERE <helper ["r"]>.category = $2)::text AS <helper ["cat_recycling"]>, COUNT(*) FILTER (WHERE <helper ["r"]>.category = $3)::text AS <helper ["cat_graffiti"]>, COUNT(*) FILTER (WHERE <helper ["r"]>.category = $4)::text AS <helper ["cat_hazard"]>, COUNT(*) FILTER (WHERE <helper ["r"]>.category = $5)::text AS <helper ["cat_encampment"]>, COUNT(*) FILTER (WHERE <helper ["r"]>.category = $6)::text AS <helper ["cat_water"]>, COUNT(*) FILTER (WHERE <helper ["r"]>.category = $7)::text AS <helper ["cat_other"]> FROM reports r WHERE r.jurisdiction_geoid IS NOT NULL AND r.deleted_at IS NULL AND r.status NOT IN ('rejected', 'resolved', 'acknowledged', 'in_progress') GROUP BY r.jurisdiction_geoid ) SELECT j.geoid, j.name, j.contact_emails AS default_emails, j.report_form_url, j.contact_updated_at, EXISTS ( SELECT 1 FROM jurisdiction_contacts dc WHERE dc.geoid = j.geoid AND dc.category IS NULL AND dc.email IS NOT NULL AND dc.email <> '' ) AS has_default_contact, ( SELECT COALESCE( json_agg(json_build_object('category', cc.category, 'email', cc.email)), '[]'::json ) FROM jurisdiction_contacts cc WHERE cc.geoid = j.geoid AND cc.category IS NOT NULL ) AS category_emails, ( SELECT MAX(rt.created_at) FROM report_timeline rt JOIN reports r2 ON r2.id = rt.report_id WHERE r2.jurisdiction_geoid = j.geoid AND rt.status = 'acknowledged' ) AS last_routed_at, ( -- A contact is 'bounced' when ANY of the geoid's contact rows has a bounce marker (the inbound -- bounce handler stamps jurisdiction_contacts.bounced_at; this takes precedence over -- verified/pending). The legacy mail_events signal is OR'd in for threads with no per-contact -- row (e.g. a digest-only bounce), so an existing bounce never silently disappears. -- -- That fallback is scoped to events NEWER than the last contact save: mail_events rows are never -- deleted, so an unscoped EXISTS pinned the directory to 'bounced' forever — re-entering a good -- address cleared bounced_at (and cleared the flag in the in-memory repo, which is what the -- offline tests asserted) yet the row still read bounced in production. EXISTS ( SELECT 1 FROM jurisdiction_contacts bc WHERE bc.geoid = j.geoid AND bc.bounced_at IS NOT NULL ) OR EXISTS ( SELECT 1 FROM mail_events me JOIN mail_threads mt ON mt.id = me.thread_id WHERE mt.jurisdiction_geoid = j.geoid AND me.type = 'bounced' AND (j.contact_updated_at IS NULL OR me.created_at > j.contact_updated_at) ) ) AS bounced, j.layer, j.population, j.flagged_at, j.handle, j.forward_subject_template, j.forward_body_template, COUNT(*) OVER()::text AS filtered_total, COALESCE(w.total, 0)::text AS reports_waiting, w.oldest_waiting_at, COALESCE(<helper ["w"]>.<helper ["cat_trash"]>, '0') AS <helper ["cat_trash"]>, COALESCE(<helper ["w"]>.<helper ["cat_recycling"]>, '0') AS <helper ["cat_recycling"]>, COALESCE(<helper ["w"]>.<helper ["cat_graffiti"]>, '0') AS <helper ["cat_graffiti"]>, COALESCE(<helper ["w"]>.<helper ["cat_hazard"]>, '0') AS <helper ["cat_hazard"]>, COALESCE(<helper ["w"]>.<helper ["cat_encampment"]>, '0') AS <helper ["cat_encampment"]>, COALESCE(<helper ["w"]>.<helper ["cat_water"]>, '0') AS <helper ["cat_water"]>, COALESCE(<helper ["w"]>.<helper ["cat_other"]>, '0') AS <helper ["cat_other"]> FROM jurisdictions j LEFT JOIN waiting w ON w.geoid = j.geoid WHERE true AND (j.name ILIKE $8 ESCAPE '\\' OR j.geoid ILIKE $9 ESCAPE '\\') AND j.layer = $10 ORDER BY j.name ASC, j.geoid ASC OFFSET $11 LIMIT $12 -- ["trash","recycling","graffiti","hazard","encampment","water","other","%q-1%","%q-1%","place",0,4]
SELECT COUNT(*)::text AS total, COUNT(*) FILTER (WHERE ( EXISTS ( SELECT 1 FROM unnest(COALESCE(j.contact_emails, '{}'::text[])) AS e(v) WHERE btrim(e.v) <> '' ) OR EXISTS ( SELECT 1 FROM jurisdiction_contacts mc WHERE mc.geoid = j.geoid AND mc.category IS NOT NULL AND mc.email IS NOT NULL AND btrim(mc.email) <> '' ) ) OR (j.report_form_url IS NOT NULL AND btrim(j.report_form_url) <> ''))::text AS routed, COUNT(*) FILTER (WHERE NOT (( EXISTS ( SELECT 1 FROM unnest(COALESCE(j.contact_emails, '{}'::text[])) AS e(v) WHERE btrim(e.v) <> '' ) OR EXISTS ( SELECT 1 FROM jurisdiction_contacts mc WHERE mc.geoid = j.geoid AND mc.category IS NOT NULL AND mc.email IS NOT NULL AND btrim(mc.email) <> '' ) ) OR (j.report_form_url IS NOT NULL AND btrim(j.report_form_url) <> '')))::text AS unrouted FROM jurisdictions j WHERE true AND (j.name ILIKE $1 ESCAPE '\\' OR j.geoid ILIKE $2 ESCAPE '\\') AND j.layer = $3 -- ["%q-1%","%q-1%","place"]
=> {"records":[],"nextCursor":null,"total":0,"facets":{"routed":0,"unrouted":0}}
-- row
WITH waiting AS ( -- "Waiting" = open, un-routed reports: excludes acknowledged/in_progress (already routed) and -- rejected/resolved (closed). So reportsWaiting is the backlog needing a contact, and it drops -- as operators route those reports one by one. -- -- Aggregated ONCE for every geoid rather than per row. The page's COUNT(*) OVER() has to -- materialize the whole filtered set before OFFSET/LIMIT, so as a per-row LATERAL this aggregate -- ran for every jurisdiction matching the filter on every page view. SELECT r.jurisdiction_geoid AS geoid, COUNT(*) AS total, -- Oldest still-waiting report; shares the waiting predicate so it agrees with total. MIN(r.created_at) AS oldest_waiting_at, COUNT(*) FILTER (WHERE <helper ["r"]>.category = $1)::text AS <helper ["cat_trash"]>, COUNT(*) FILTER (WHERE <helper ["r"]>.category = $2)::text AS <helper ["cat_recycling"]>, COUNT(*) FILTER (WHERE <helper ["r"]>.category = $3)::text AS <helper ["cat_graffiti"]>, COUNT(*) FILTER (WHERE <helper ["r"]>.category = $4)::text AS <helper ["cat_hazard"]>, COUNT(*) FILTER (WHERE <helper ["r"]>.category = $5)::text AS <helper ["cat_encampment"]>, COUNT(*) FILTER (WHERE <helper ["r"]>.category = $6)::text AS <helper ["cat_water"]>, COUNT(*) FILTER (WHERE <helper ["r"]>.category = $7)::text AS <helper ["cat_other"]> FROM reports r WHERE r.jurisdiction_geoid IS NOT NULL AND r.deleted_at IS NULL AND r.status NOT IN ('rejected', 'resolved', 'acknowledged', 'in_progress') GROUP BY r.jurisdiction_geoid ) SELECT j.geoid, j.name, j.contact_emails AS default_emails, j.report_form_url, j.contact_updated_at, EXISTS ( SELECT 1 FROM jurisdiction_contacts dc WHERE dc.geoid = j.geoid AND dc.category IS NULL AND dc.email IS NOT NULL AND dc.email <> '' ) AS has_default_contact, ( SELECT COALESCE( json_agg(json_build_object('category', cc.category, 'email', cc.email)), '[]'::json ) FROM jurisdiction_contacts cc WHERE cc.geoid = j.geoid AND cc.category IS NOT NULL ) AS category_emails, ( SELECT MAX(rt.created_at) FROM report_timeline rt JOIN reports r2 ON r2.id = rt.report_id WHERE r2.jurisdiction_geoid = j.geoid AND rt.status = 'acknowledged' ) AS last_routed_at, ( -- A contact is 'bounced' when ANY of the geoid's contact rows has a bounce marker (the inbound -- bounce handler stamps jurisdiction_contacts.bounced_at; this takes precedence over -- verified/pending). The legacy mail_events signal is OR'd in for threads with no per-contact -- row (e.g. a digest-only bounce), so an existing bounce never silently disappears. -- -- That fallback is scoped to events NEWER than the last contact save: mail_events rows are never -- deleted, so an unscoped EXISTS pinned the directory to 'bounced' forever — re-entering a good -- address cleared bounced_at (and cleared the flag in the in-memory repo, which is what the -- offline tests asserted) yet the row still read bounced in production. EXISTS ( SELECT 1 FROM jurisdiction_contacts bc WHERE bc.geoid = j.geoid AND bc.bounced_at IS NOT NULL ) OR EXISTS ( SELECT 1 FROM mail_events me JOIN mail_threads mt ON mt.id = me.thread_id WHERE mt.jurisdiction_geoid = j.geoid AND me.type = 'bounced' AND (j.contact_updated_at IS NULL OR me.created_at > j.contact_updated_at) ) ) AS bounced, j.layer, j.population, j.flagged_at, j.handle, j.forward_subject_template, j.forward_body_template, COUNT(*) OVER()::text AS filtered_total, COALESCE(w.total, 0)::text AS reports_waiting, w.oldest_waiting_at, COALESCE(<helper ["w"]>.<helper ["cat_trash"]>, '0') AS <helper ["cat_trash"]>, COALESCE(<helper ["w"]>.<helper ["cat_recycling"]>, '0') AS <helper ["cat_recycling"]>, COALESCE(<helper ["w"]>.<helper ["cat_graffiti"]>, '0') AS <helper ["cat_graffiti"]>, COALESCE(<helper ["w"]>.<helper ["cat_hazard"]>, '0') AS <helper ["cat_hazard"]>, COALESCE(<helper ["w"]>.<helper ["cat_encampment"]>, '0') AS <helper ["cat_encampment"]>, COALESCE(<helper ["w"]>.<helper ["cat_water"]>, '0') AS <helper ["cat_water"]>, COALESCE(<helper ["w"]>.<helper ["cat_other"]>, '0') AS <helper ["cat_other"]> FROM jurisdictions j LEFT JOIN waiting w ON w.geoid = j.geoid WHERE true AND (j.name ILIKE $8 ESCAPE '\\' OR j.geoid ILIKE $9 ESCAPE '\\') AND j.layer = $10 ORDER BY j.name ASC, j.geoid ASC OFFSET $11 LIMIT $12 -- ["trash","recycling","graffiti","hazard","encampment","water","other","%q-1%","%q-1%","place",0,4]
SELECT COUNT(*)::text AS total, COUNT(*) FILTER (WHERE ( EXISTS ( SELECT 1 FROM unnest(COALESCE(j.contact_emails, '{}'::text[])) AS e(v) WHERE btrim(e.v) <> '' ) OR EXISTS ( SELECT 1 FROM jurisdiction_contacts mc WHERE mc.geoid = j.geoid AND mc.category IS NOT NULL AND mc.email IS NOT NULL AND btrim(mc.email) <> '' ) ) OR (j.report_form_url IS NOT NULL AND btrim(j.report_form_url) <> ''))::text AS routed, COUNT(*) FILTER (WHERE NOT (( EXISTS ( SELECT 1 FROM unnest(COALESCE(j.contact_emails, '{}'::text[])) AS e(v) WHERE btrim(e.v) <> '' ) OR EXISTS ( SELECT 1 FROM jurisdiction_contacts mc WHERE mc.geoid = j.geoid AND mc.category IS NOT NULL AND mc.email IS NOT NULL AND btrim(mc.email) <> '' ) ) OR (j.report_form_url IS NOT NULL AND btrim(j.report_form_url) <> '')))::text AS unrouted FROM jurisdictions j WHERE true AND (j.name ILIKE $1 ESCAPE '\\' OR j.geoid ILIKE $2 ESCAPE '\\') AND j.layer = $3 -- ["%q-1%","%q-1%","place"]
=> {"records":[{"geoid":"geoid-row","name":"name-row","layer":"layer-row","population":"population-row","defaultEmails":[],"categoryContacts":[],"hasDefaultContact":true,"reportFormUrl":"report_form_url-row","reportsWaiting":0,"perCategoryCounts":{},"oldestReportAt":"2026-03-04T05:06:07.000Z","lastRoutedAt":"2026-03-04T05:06:07.000Z","bounced":"bounced-row","contactUpdatedAt":"2026-03-04T05:06:07.000Z","flaggedAt":"2026-03-04T05:06:07.000Z","handle":"handle-row","forwardSubjectTemplate":"forward_subject_template-row","forwardBodyTemplate":"forward_body_template-row"}],"nextCursor":null,"total":2,"facets":{"routed":null,"unrouted":null}}"
`;

exports[`sql transcripts > makeDrizzleJurisdictionContactsRepository.patch 1`] = `
"-- empty
BEGIN tx1
[tx1] SELECT geoid FROM jurisdictions WHERE geoid = $1 LIMIT 1 -- ["geoid-1"]
COMMIT tx1
=> false
-- row
BEGIN tx1
[tx1] SELECT geoid FROM jurisdictions WHERE geoid = $1 LIMIT 1 -- ["geoid-1"]
[tx1] INSERT INTO jurisdiction_contacts (geoid, category, email, updated_at, bounced_at) VALUES ($1, $2, $3, now(), NULL) ON CONFLICT (geoid, category) WHERE category IS NOT NULL DO UPDATE SET email = EXCLUDED.email, updated_at = now(), bounced_at = NULL -- ["geoid-1","trash","trash-any"]
[tx1] INSERT INTO jurisdiction_contacts (geoid, category, email, updated_at, bounced_at) VALUES ($1, $2, $3, now(), NULL) ON CONFLICT (geoid, category) WHERE category IS NOT NULL DO UPDATE SET email = EXCLUDED.email, updated_at = now(), bounced_at = NULL -- ["geoid-1","recycling","recycling-any"]
[tx1] INSERT INTO jurisdiction_contacts (geoid, category, email, updated_at, bounced_at) VALUES ($1, $2, $3, now(), NULL) ON CONFLICT (geoid, category) WHERE category IS NOT NULL DO UPDATE SET email = EXCLUDED.email, updated_at = now(), bounced_at = NULL -- ["geoid-1","graffiti","graffiti-any"]
[tx1] INSERT INTO jurisdiction_contacts (geoid, category, email, updated_at, bounced_at) VALUES ($1, $2, $3, now(), NULL) ON CONFLICT (geoid, category) WHERE category IS NOT NULL DO UPDATE SET email = EXCLUDED.email, updated_at = now(), bounced_at = NULL -- ["geoid-1","hazard","hazard-any"]
[tx1] INSERT INTO jurisdiction_contacts (geoid, category, email, updated_at, bounced_at) VALUES ($1, $2, $3, now(), NULL) ON CONFLICT (geoid, category) WHERE category IS NOT NULL DO UPDATE SET email = EXCLUDED.email, updated_at = now(), bounced_at = NULL -- ["geoid-1","encampment","encampment-any"]
[tx1] INSERT INTO jurisdiction_contacts (geoid, category, email, updated_at, bounced_at) VALUES ($1, $2, $3, now(), NULL) ON CONFLICT (geoid, category) WHERE category IS NOT NULL DO UPDATE SET email = EXCLUDED.email, updated_at = now(), bounced_at = NULL -- ["geoid-1","water","water-any"]
[tx1] INSERT INTO jurisdiction_contacts (geoid, category, email, updated_at, bounced_at) VALUES ($1, $2, $3, now(), NULL) ON CONFLICT (geoid, category) WHERE category IS NOT NULL DO UPDATE SET email = EXCLUDED.email, updated_at = now(), bounced_at = NULL -- ["geoid-1","other","other-any"]
[tx1] INSERT INTO jurisdiction_contacts (geoid, category, email, form_url, updated_at, bounced_at) VALUES ($1, NULL, $2, $3, now(), NULL) ON CONFLICT (geoid) WHERE category IS NULL DO UPDATE SET email = CASE WHEN $4 THEN EXCLUDED.email ELSE jurisdiction_contacts.email END, form_url = CASE WHEN $5 THEN EXCLUDED.form_url ELSE jurisdiction_contacts.form_url END, updated_at = now(), bounced_at = CASE WHEN $6 THEN NULL ELSE jurisdiction_contacts.bounced_at END -- ["geoid-1","defaultEmail-1","formUrl-1",true,true,true]
[tx1] UPDATE jurisdictions SET contact_emails = CASE WHEN $1 > 0 THEN $2 ELSE contact_emails END, report_form_url = COALESCE($3, report_form_url) WHERE geoid = $4 -- [1,["defaultEmail-1"],"formUrl-1","geoid-1"]
[tx1] UPDATE jurisdictions SET contact_updated_at = now() WHERE geoid = $1 -- ["geoid-1"]
[tx1] UPDATE jurisdictions SET notes = $1 WHERE geoid = $2 -- ["notes-1","geoid-1"]
[tx1] UPDATE jurisdictions SET flagged_at = now(), flag_reason = $1 WHERE geoid = $2 -- ["flagReason-1","geoid-1"]
[tx1] SELECT geoid FROM jurisdictions WHERE handle IS NOT NULL AND lower(handle) = lower($1) AND geoid <> $2 LIMIT 1 -- ["handle-1","geoid-1"]
ROLLBACK tx1
=> throws AppError: That @handle is already used by another jurisdiction."
`;

