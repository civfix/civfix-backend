exports[`sql transcripts > makeDrizzleAdminReportRepository.listTimeline 1`] = `
"-- empty
SELECT t.status, t.note, t.kind, COALESCE(u.display_name, u.handle) AS who, t.created_at FROM report_timeline t LEFT JOIN users u ON u.id = t.actor_id WHERE t.report_id = $1 ORDER BY t.created_at ASC, t.id ASC -- ["id-1"]
=> []
-- row
SELECT t.status, t.note, t.kind, COALESCE(u.display_name, u.handle) AS who, t.created_at FROM report_timeline t LEFT JOIN users u ON u.id = t.actor_id WHERE t.report_id = $1 ORDER BY t.created_at ASC, t.id ASC -- ["id-1"]
=> [{"status":"status-row","note":"note-row","kind":null,"who":"who-row","createdAt":"2026-03-04T05:06:07.000Z"}]"
`;

exports[`sql transcripts > makeDrizzleAdminReportRepository.remove 1`] = `
"-- empty
BEGIN tx1
[tx1] UPDATE reports SET status = 'rejected', deleted_at = now() WHERE id = $1 AND deleted_at IS NULL RETURNING id -- ["id-1"]
COMMIT tx1
=> false
-- row
BEGIN tx1
[tx1] UPDATE reports SET status = 'rejected', deleted_at = now() WHERE id = $1 AND deleted_at IS NULL RETURNING id -- ["id-1"]
[tx1] INSERT INTO report_timeline (report_id, status, note, kind, actor_id) VALUES ($1, 'rejected', $2, 'remove', $3) -- ["id-1","note-1","actorId-1"]
[tx1] INSERT INTO audit_log (actor_id, action, target, meta) VALUES ($1, $2, $3, $4) RETURNING id -- ["actorId-1","report.removed","report:id-1",{"<json>":{"note":"note-1"}}]
COMMIT tx1
=> true"
`;

exports[`sql transcripts > makeDrizzleAdminReportRepository.setReportVerdict 1`] = `
"-- empty
BEGIN tx1
[tx1] UPDATE reports SET verification_verdict = $1, verified_by = $2, verified_at = now() WHERE id = $3 AND deleted_at IS NULL RETURNING reporter_user_id -- ["rejected","actorId-1","id-1"]
COMMIT tx1
=> false
-- row
BEGIN tx1
[tx1] UPDATE reports SET verification_verdict = $1, verified_by = $2, verified_at = now() WHERE id = $3 AND deleted_at IS NULL RETURNING reporter_user_id -- ["rejected","actorId-1","id-1"]
[tx1] INSERT INTO audit_log (actor_id, action, target, meta) VALUES ($1, $2, $3, $4) RETURNING id -- ["actorId-1","report.verdict_set","report:id-1",{"<json>":{"verdict":"rejected"}}]
COMMIT tx1
=> true"
`;

exports[`sql transcripts > makeDrizzleAdminReportRepository.setStatus 1`] = `
"-- empty
BEGIN tx1
[tx1] UPDATE reports SET status = $1, deleted_at = CASE WHEN $2 = 'rejected' THEN COALESCE(deleted_at, now()) ELSE deleted_at END WHERE id = $3 AND deleted_at IS NULL RETURNING id -- ["submitted","submitted","id-1"]
COMMIT tx1
=> false
-- row
BEGIN tx1
[tx1] UPDATE reports SET status = $1, deleted_at = CASE WHEN $2 = 'rejected' THEN COALESCE(deleted_at, now()) ELSE deleted_at END WHERE id = $3 AND deleted_at IS NULL RETURNING id -- ["submitted","submitted","id-1"]
[tx1] INSERT INTO report_timeline (report_id, status, note, kind, body, actor_id) VALUES ($1, $2, $3, $4, $5, $6) -- ["id-1","submitted","note-1","warn","body-1","actorId-1"]
[tx1] INSERT INTO audit_log (actor_id, action, target, meta) VALUES ($1, $2, $3, $4) RETURNING id -- ["actorId-1","report.status_changed","report:id-1",{"<json>":{"status":"submitted"}}]
COMMIT tx1
=> true"
`;

exports[`sql transcripts > makeDrizzleAdminReportRepository.toggleFlag 1`] = `
"-- empty
BEGIN tx1
[tx1] SELECT status FROM reports WHERE id = $1 AND deleted_at IS NULL LIMIT 1 -- ["id-1"]
COMMIT tx1
=> null
-- row
BEGIN tx1
[tx1] SELECT status FROM reports WHERE id = $1 AND deleted_at IS NULL LIMIT 1 -- ["id-1"]
[tx1] SELECT id FROM abuse_flags WHERE subject_type = 'report' AND subject_id = $1 AND resolved_at IS NULL -- ["id-1"]
[tx1] UPDATE abuse_flags SET resolved_at = now() WHERE subject_type = 'report' AND subject_id = $1 AND resolved_at IS NULL -- ["id-1"]
[tx1] INSERT INTO report_timeline (report_id, status, note, kind, actor_id) VALUES ( $1, $2, $3, 'warn', $4 ) -- ["id-1","status-row","Flag cleared","actorId-1"]
[tx1] INSERT INTO audit_log (actor_id, action, target, meta) VALUES ($1, $2, $3, $4) RETURNING id -- ["actorId-1","report.unflagged","report:id-1",{"<json>":{"reason":"reason-1"}}]
COMMIT tx1
=> false"
`;

exports[`sql transcripts > makeDrizzleAdminReportRepository.withRouteLock 1`] = `
"-- empty
RESERVE reserved1
[reserved1] SELECT pg_advisory_lock($1, hashtext($2)) -- [2096201217,"id-1"]
[reserved1] SELECT pg_advisory_unlock($1, hashtext($2)) -- [2096201217,"id-1"]
RELEASE reserved1
=> "fnResult-unsupported"
-- row
RESERVE reserved1
[reserved1] SELECT pg_advisory_lock($1, hashtext($2)) -- [2096201217,"id-1"]
[reserved1] SELECT pg_advisory_unlock($1, hashtext($2)) -- [2096201217,"id-1"]
RELEASE reserved1
=> "fnResult-unsupported""
`;

exports[`sql transcripts > makeDrizzleAdminUserRepository.applyRole 1`] = `
"-- empty
BEGIN tx1
[tx1] SELECT role FROM users WHERE id = $1 AND deleted_at IS NULL LIMIT 1 -- ["id-1"]
COMMIT tx1
=> false
-- row
BEGIN tx1
[tx1] SELECT role FROM users WHERE id = $1 AND deleted_at IS NULL LIMIT 1 -- ["id-1"]
[tx1] UPDATE users SET role = $1 WHERE id = $2 -- ["citizen","id-1"]
[tx1] INSERT INTO audit_log (actor_id, action, target, meta) VALUES ($1, $2, $3, $4) RETURNING id -- ["actorId-1","user.role_changed","user:id-1",{"<json>":{"role":"citizen","priorRole":"role-row"}}]
COMMIT tx1
=> true"
`;

exports[`sql transcripts > makeDrizzleAdminUserRepository.countByFacet 1`] = `
"-- empty
SELECT DISTINCT r2.reporter_user_id AS id FROM reports r2 JOIN jurisdictions j2 ON j2.geoid = r2.jurisdiction_geoid WHERE r2.reporter_user_id IS NOT NULL AND j2.name ILIKE $1 ESCAPE '\\' LIMIT $2 -- ["%q-1%",5000]
SELECT COUNT(*)::text AS all, COUNT(*) FILTER (WHERE COALESCE(um.account_status, 'active') = 'active')::text AS active, COUNT(*) FILTER (WHERE COALESCE(um.account_status, 'active') = 'suspended')::text AS suspended, COUNT(*) FILTER (WHERE COALESCE(um.flagged, false))::text AS flagged, COUNT(*) FILTER (WHERE u.deleted_at IS NOT NULL)::text AS deleted, COUNT(*) FILTER (WHERE COALESCE(um.account_status, 'active') = 'banned')::text AS banned FROM users u LEFT JOIN user_moderation um ON um.user_id = u.id WHERE TRUE AND (u.display_name ILIKE $1 ESCAPE '\\' OR u.handle::text ILIKE $2 ESCAPE '\\') -- ["%q-1%","%q-1%"]
=> {"all":0,"active":0,"suspended":0,"flagged":0,"deleted":0,"banned":0}
-- row
SELECT DISTINCT r2.reporter_user_id AS id FROM reports r2 JOIN jurisdictions j2 ON j2.geoid = r2.jurisdiction_geoid WHERE r2.reporter_user_id IS NOT NULL AND j2.name ILIKE $1 ESCAPE '\\' LIMIT $2 -- ["%q-1%",5000]
SELECT COUNT(*)::text AS all, COUNT(*) FILTER (WHERE COALESCE(um.account_status, 'active') = 'active')::text AS active, COUNT(*) FILTER (WHERE COALESCE(um.account_status, 'active') = 'suspended')::text AS suspended, COUNT(*) FILTER (WHERE COALESCE(um.flagged, false))::text AS flagged, COUNT(*) FILTER (WHERE u.deleted_at IS NOT NULL)::text AS deleted, COUNT(*) FILTER (WHERE COALESCE(um.account_status, 'active') = 'banned')::text AS banned FROM users u LEFT JOIN user_moderation um ON um.user_id = u.id WHERE TRUE AND (u.display_name ILIKE $1 ESCAPE '\\' OR u.handle::text ILIKE $2 ESCAPE '\\' OR u.id = ANY($3::uuid[])) -- ["%q-1%","%q-1%",["id-row"]]
=> {"all":null,"active":null,"suspended":null,"flagged":null,"deleted":null,"banned":null}"
`;

exports[`sql transcripts > makeDrizzleAdminUserRepository.getUser 1`] = `
"-- empty
SELECT u.id, u.display_name AS name, u.handle, u.email_verified, ( SELECT j.name FROM reports r LEFT JOIN jurisdictions j ON j.geoid = r.jurisdiction_geoid WHERE r.reporter_user_id = u.id AND j.name IS NOT NULL ORDER BY r.created_at DESC LIMIT 1 ) AS city, u.role, u.avatar_url, u.created_at, u.deleted_at, (SELECT MAX(s.last_seen_at) FROM sessions s WHERE s.user_id = u.id) AS last_active_at, COALESCE(um.account_status, 'active') AS account_status, (SELECT COUNT(*) FROM reports r WHERE r.reporter_user_id = u.id AND r.deleted_at IS NULL)::text AS reports, (SELECT COUNT(*) FROM cleanup_members cm WHERE cm.user_id = u.id)::text AS cleanups, ( (SELECT COUNT(*) FROM chat_messages msg WHERE msg.sender_id = u.id) + (SELECT COUNT(*) FROM dm_messages dmsg WHERE dmsg.sender_id = u.id) )::text AS messages, COALESCE(um.removals, 0) AS removals, COALESCE(um.strikes, 0) AS strikes, COALESCE(um.risk, 'low') AS risk, COALESCE(um.flagged, false) AS flagged, um.flag_reason, COALESCE(um.report_verified, false) AS report_verified FROM users u LEFT JOIN user_moderation um ON um.user_id = u.id WHERE TRUE AND u.id = $1 LIMIT 1 -- ["id-1"]
=> null
-- row
SELECT u.id, u.display_name AS name, u.handle, u.email_verified, ( SELECT j.name FROM reports r LEFT JOIN jurisdictions j ON j.geoid = r.jurisdiction_geoid WHERE r.reporter_user_id = u.id AND j.name IS NOT NULL ORDER BY r.created_at DESC LIMIT 1 ) AS city, u.role, u.avatar_url, u.created_at, u.deleted_at, (SELECT MAX(s.last_seen_at) FROM sessions s WHERE s.user_id = u.id) AS last_active_at, COALESCE(um.account_status, 'active') AS account_status, (SELECT COUNT(*) FROM reports r WHERE r.reporter_user_id = u.id AND r.deleted_at IS NULL)::text AS reports, (SELECT COUNT(*) FROM cleanup_members cm WHERE cm.user_id = u.id)::text AS cleanups, ( (SELECT COUNT(*) FROM chat_messages msg WHERE msg.sender_id = u.id) + (SELECT COUNT(*) FROM dm_messages dmsg WHERE dmsg.sender_id = u.id) )::text AS messages, COALESCE(um.removals, 0) AS removals, COALESCE(um.strikes, 0) AS strikes, COALESCE(um.risk, 'low') AS risk, COALESCE(um.flagged, false) AS flagged, um.flag_reason, COALESCE(um.report_verified, false) AS report_verified FROM users u LEFT JOIN user_moderation um ON um.user_id = u.id WHERE TRUE AND u.id = $1 LIMIT 1 -- ["id-1"]
