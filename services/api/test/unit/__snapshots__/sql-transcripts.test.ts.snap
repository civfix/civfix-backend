exports[`sql transcripts > makeDrizzleSocialRepository.removeFollow 1`] = `
"-- empty
SELECT 1 AS one FROM users WHERE id = $1 AND deleted_at IS NULL LIMIT 1 -- ["followeeId-1"]
=> {"exists":false}
-- row
SELECT 1 AS one FROM users WHERE id = $1 AND deleted_at IS NULL LIMIT 1 -- ["followeeId-1"]
BEGIN tx1
[tx1] DELETE FROM follows_people WHERE follower_id = $1 AND followee_id = $2 RETURNING follower_id -- ["followerId-1","followeeId-1"]
[tx1] UPDATE users SET follower_count = GREATEST(follower_count - CASE WHEN id = $1 THEN 1 ELSE 0 END, 0), following_count = GREATEST(following_count - CASE WHEN id = $2 THEN 1 ELSE 0 END, 0) WHERE id IN ($3, $4) -- ["followeeId-1","followerId-1","followerId-1","followeeId-1"]
COMMIT tx1
=> {"exists":true}"
`;

