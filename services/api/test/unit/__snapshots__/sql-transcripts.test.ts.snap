SELECT id, display_name, handle, email, email_verified, bio, avatar_url, donation_url, created_at, deleted_at FROM users WHERE id = $1 LIMIT 1 -- ["userId-1"]
SELECT r.id, r.category, r.title, r.description, j.name AS place, r.status, r.created_at FROM reports r LEFT JOIN jurisdictions j ON j.geoid = r.jurisdiction_geoid WHERE r.reporter_user_id = $1 ORDER BY r.created_at DESC LIMIT $2 -- ["userId-1",50001]
