-- row
BEGIN tx1
[tx1] SELECT id FROM cleanup_ticket_types WHERE id = $1 AND cleanup_id = $2 LIMIT 1 FOR UPDATE -- ["ticketTypeId-1","cleanupId-1"]
[tx1] SELECT 1 AS one WHERE EXISTS ( SELECT 1 FROM cleanup_registrations WHERE ticket_type_id = $1 ) OR EXISTS ( SELECT 1 FROM cleanup_waitlist WHERE ticket_type_id = $2 ) -- ["ticketTypeId-1","ticketTypeId-1"]
COMMIT tx1
=> {"kind":"in_use"}"
`;

