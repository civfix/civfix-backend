=> false
-- row
INSERT INTO jurisdiction_discovery_tasks (geoid, population, sample_report_id) SELECT $1, COALESCE($2, j.population), (SELECT r.id FROM reports r WHERE r.jurisdiction_geoid = $3 AND r.deleted_at IS NULL ORDER BY r.created_at DESC LIMIT 1) FROM jurisdictions j WHERE j.geoid = $4 ON CONFLICT (geoid) WHERE status <> 'done' DO NOTHING RETURNING id -- ["geoid-1",3,"geoid-1","geoid-1"]
