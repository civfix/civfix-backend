SELECT count(*)::int AS count FROM volunteer_hours vh WHERE vh.user_id = $1 AND vh.voided_at IS NULL AND vh.source <> 'report' AND vh.jurisdiction_geoid = $2 AND vh.created_at >= $3 AND vh.created_at <= $4 -- ["userId-1","geoid-1","2026-03-04T05:06:07.000Z","2026-03-04T05:06:07.000Z"]
