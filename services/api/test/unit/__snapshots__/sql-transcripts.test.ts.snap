exports[`sql transcripts > makeDrizzleCleanupRepository.findOrganizationEventsHost 1`] = `
"-- empty
SELECT o.id, o.slug, o.name, COALESCE(<helper ["am"]>.served_key, CASE WHEN <helper ["am"]>.status = 'validating' THEN <helper ["am"]>.r2_key END) AS logo_key, o.donation_url, o.verified_status, o.verified_kind, (o.suspended_at IS NOT NULL) AS suspended, EXISTS ( SELECT 1 FROM organization_members m WHERE m.organization_id = o.id AND m.user_id = $1::uuid ) AS viewer_is_member FROM organizations o LEFT JOIN media_assets am ON am.id = o.logo_media_id WHERE o.slug = $2 AND o.deleted_at IS NULL LIMIT 1 -- ["viewerId-1","slug-1"]
=> null
-- row
SELECT o.id, o.slug, o.name, COALESCE(<helper ["am"]>.served_key, CASE WHEN <helper ["am"]>.status = 'validating' THEN <helper ["am"]>.r2_key END) AS logo_key, o.donation_url, o.verified_status, o.verified_kind, (o.suspended_at IS NOT NULL) AS suspended, EXISTS ( SELECT 1 FROM organization_members m WHERE m.organization_id = o.id AND m.user_id = $1::uuid ) AS viewer_is_member FROM organizations o LEFT JOIN media_assets am ON am.id = o.logo_media_id WHERE o.slug = $2 AND o.deleted_at IS NULL LIMIT 1 -- ["viewerId-1","slug-1"]
=> {"organization":{"id":"id-row","slug":"slug-row","name":"name-row","logoKey":"logo_key-row","donationUrl":"donation_url-row","verifiedStatus":"verified_status-row","verifiedKind":"verified_kind-row","suspended":"suspended-row"},"viewerIsMember":"viewer_is_member-row"}"
`;

exports[`sql transcripts > makeDrizzleCleanupRepository.galleryKeysFor 1`] = `
"-- empty
SELECT COALESCE(<helper ["ma"]>.served_key, CASE WHEN <helper ["ma"]>.status = 'validating' THEN <helper ["ma"]>.r2_key END) AS served_key FROM cleanups c JOIN LATERAL unnest(c.gallery_media_ids) WITH ORDINALITY AS g(media_id, ord) ON true JOIN media_assets ma ON ma.id = g.media_id WHERE c.id = $1 AND (<helper ["ma"]>.status = 'validating' OR (<helper ["ma"]>.status = 'ready' AND <helper ["ma"]>.served_key IS NOT NULL)) ORDER BY g.ord -- ["cleanupId-1"]
=> []
-- row
SELECT COALESCE(<helper ["ma"]>.served_key, CASE WHEN <helper ["ma"]>.status = 'validating' THEN <helper ["ma"]>.r2_key END) AS served_key FROM cleanups c JOIN LATERAL unnest(c.gallery_media_ids) WITH ORDINALITY AS g(media_id, ord) ON true JOIN media_assets ma ON ma.id = g.media_id WHERE c.id = $1 AND (<helper ["ma"]>.status = 'validating' OR (<helper ["ma"]>.status = 'ready' AND <helper ["ma"]>.served_key IS NOT NULL)) ORDER BY g.ord -- ["cleanupId-1"]
=> ["served_key-row"]"
`;

exports[`sql transcripts > makeDrizzleCleanupRepository.goingCount 1`] = `
"-- empty
SELECT (SELECT count(*)::int FROM cleanup_members m WHERE m.cleanup_id = $1) + ( SELECT count(*)::int FROM cleanup_guests cg WHERE cg.cleanup_id = $2 AND cg.cancelled_at IS NULL ) AS count -- ["cleanupId-1","cleanupId-1"]
=> 0
-- row
SELECT (SELECT count(*)::int FROM cleanup_members m WHERE m.cleanup_id = $1) + ( SELECT count(*)::int FROM cleanup_guests cg WHERE cg.cleanup_id = $2 AND cg.cancelled_at IS NULL ) AS count -- ["cleanupId-1","cleanupId-1"]
=> 2"
`;

exports[`sql transcripts > makeDrizzleCleanupRepository.isBanned 1`] = `
"-- empty
SELECT 1 AS one FROM cleanup_bans WHERE cleanup_id = $1 AND user_id = $2 LIMIT 1 -- ["cleanupId-1","userId-1"]
=> false
-- row
SELECT 1 AS one FROM cleanup_bans WHERE cleanup_id = $1 AND user_id = $2 LIMIT 1 -- ["cleanupId-1","userId-1"]
=> true"
`;

exports[`sql transcripts > makeDrizzleCleanupRepository.isMember 1`] = `
"-- empty
SELECT 1 AS one FROM cleanup_members WHERE cleanup_id = $1 AND user_id = $2 LIMIT 1 -- ["cleanupId-1","userId-1"]
=> false
-- row
SELECT 1 AS one FROM cleanup_members WHERE cleanup_id = $1 AND user_id = $2 LIMIT 1 -- ["cleanupId-1","userId-1"]
=> true"
`;

exports[`sql transcripts > makeDrizzleCleanupRepository.joinCleanupTx 1`] = `
"-- empty
BEGIN tx1
[tx1] SELECT status, visibility, organization_id, scheduled_at, ends_at, now() AS now FROM cleanups WHERE id = $1 LIMIT 1 FOR SHARE -- ["cleanupId-1"]
COMMIT tx1
=> "not_found"
-- row
BEGIN tx1
[tx1] SELECT status, visibility, organization_id, scheduled_at, ends_at, now() AS now FROM cleanups WHERE id = $1 LIMIT 1 FOR SHARE -- ["cleanupId-1"]
ROLLBACK tx1
=> throws TypeError: cleanup.now.getTime is not a function"
`;

exports[`sql transcripts > makeDrizzleCleanupRepository.leaveCleanup 1`] = `
"-- empty
BEGIN tx1
[tx1] SELECT status, now() AS now FROM cleanups WHERE id = $1 LIMIT 1 FOR SHARE -- ["cleanupId-1"]
COMMIT tx1
=> "not_found"
-- row
BEGIN tx1
[tx1] SELECT status, now() AS now FROM cleanups WHERE id = $1 LIMIT 1 FOR SHARE -- ["cleanupId-1"]
[tx1] DELETE FROM cleanup_members WHERE cleanup_id = $1 AND user_id = $2 -- ["cleanupId-1","userId-1"]
[tx1] WITH cancelled AS ( UPDATE cleanup_registrations SET status = 'cancelled', cancelled_at = $1, cancelled_by = $2 WHERE cleanup_id = $3 AND user_id = $4 AND status = 'registered' AND ticket_type_id IS NULL RETURNING id ), seats AS ( UPDATE cleanup_registration_seats s SET status = 'cancelled' FROM cancelled c WHERE s.registration_id = c.id AND s.status = 'active' RETURNING s.id ) SELECT id FROM cancelled -- ["now-row","userId-1","cleanupId-1","userId-1"]
[tx1] DELETE FROM cleanup_slot_claims WHERE cleanup_id = $1 AND user_id = $2 -- ["cleanupId-1","userId-1"]
COMMIT tx1
=> "left""
`;

exports[`sql transcripts > makeDrizzleCleanupRepository.linkReports 1`] = `
"-- empty
BEGIN tx1
[tx1] SELECT cr.report_id FROM cleanup_reports cr WHERE cr.report_id = ANY($1::uuid[]) AND cr.cleanup_id <> $2 GROUP BY cr.report_id HAVING count(*) >= $3 -- [["reportId-1"],"cleanupId-1",50]
[tx1] INSERT INTO cleanup_reports (cleanup_id, report_id, linked_by_user_id) SELECT $1, rid, $2 FROM unnest($3::uuid[]) AS rid ON CONFLICT (cleanup_id, report_id) DO NOTHING RETURNING report_id -- ["cleanupId-1","actorId-1",["reportId-1"]]
COMMIT tx1
=> []
-- row
BEGIN tx1
[tx1] SELECT cr.report_id FROM cleanup_reports cr WHERE cr.report_id = ANY($1::uuid[]) AND cr.cleanup_id <> $2 GROUP BY cr.report_id HAVING count(*) >= $3 -- [["reportId-1"],"cleanupId-1",50]
ROLLBACK tx1
=> throws AppError: Validation failed"
`;

