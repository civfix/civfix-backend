exports[`sql transcripts > makeDrizzleVolunteerHoursRepository.logEventHours 1`] = `
"-- empty
BEGIN tx1
[tx1] SELECT pg_advisory_xact_lock(hashtext('volunteer_event:' || $1)) -- ["cleanupId-1"]
[tx1] SELECT pg_advisory_xact_lock(hashtext('volunteer_user:' || u)) FROM unnest($1::uuid[]) AS t(u) ORDER BY u -- [["userId-1"]]
[tx1] SELECT DISTINCT logged_by_user_id FROM volunteer_hours WHERE cleanup_id = $1 AND source = 'event' AND user_id = $2 AND voided_at IS NULL AND logged_by_user_id <> $3 AND logged_by_user_id = ANY($4::uuid[]) -- ["cleanupId-1","actorId-1","actorId-1",["userId-1"]]
[tx1] SELECT vh.user_id, COALESCE(SUM(vh.hours), 0)::float8 AS hours FROM volunteer_hours vh JOIN cleanups c ON c.id = vh.cleanup_id WHERE vh.user_id = ANY($1::uuid[]) AND vh.source = 'event' AND vh.voided_at IS NULL AND vh.cleanup_id <> $2 AND (c.scheduled_at AT TIME ZONE COALESCE(c.timezone, $3))::date = ( SELECT (scheduled_at AT TIME ZONE COALESCE(timezone, $4))::date FROM cleanups WHERE id = $5 ) GROUP BY vh.user_id -- [["userId-1"],"cleanupId-1","America/Los_Angeles","America/Los_Angeles","cleanupId-1"]
[tx1] INSERT INTO volunteer_hours_audit (cleanup_id, user_id, actor_user_id, previous_hours, new_hours) SELECT $1, t.u, $2, prev.hours, t.h FROM unnest($3::uuid[], $4::float8[]) AS t(u, h) LEFT JOIN volunteer_hours prev ON prev.cleanup_id = $5 AND prev.source = 'event' AND prev.user_id = t.u RETURNING user_id, previous_hours::float8 AS previous_hours, new_hours::float8 AS new_hours -- ["cleanupId-1","actorId-1",["userId-1"],[3],"cleanupId-1"]
[tx1] WITH prev AS ( SELECT user_id, hours AS old_hours, jurisdiction_geoid AS old_geoid FROM volunteer_hours WHERE cleanup_id = $1 AND source = 'event' AND user_id = ANY($2::uuid[]) ), upsert AS ( INSERT INTO volunteer_hours (user_id, hours, source, cleanup_id, jurisdiction_geoid, logged_by_user_id) SELECT t.u, t.h, 'event', $3, $4, $5 FROM unnest($6::uuid[], $7::float8[]) AS t(u, h) ON CONFLICT (cleanup_id, user_id) WHERE source = 'event' DO UPDATE SET hours = EXCLUDED.hours, jurisdiction_geoid = EXCLUDED.jurisdiction_geoid, logged_by_user_id = EXCLUDED.logged_by_user_id RETURNING user_id, hours ), deltas AS ( SELECT up.user_id, $8::text AS geoid, up.hours - COALESCE( CASE WHEN p.old_geoid = $9 THEN p.old_hours END, 0 ) AS delta FROM upsert up LEFT JOIN prev p ON p.user_id = up.user_id UNION ALL -- The event moved jurisdictions since this attendee was last credited: take the stale hours -- back out of the jurisdiction it no longer belongs to. Disjoint from the branch above (that -- one is always the CURRENT geoid), so no (user, geoid) pair is inserted twice. SELECT p.user_id, p.old_geoid, -p.old_hours FROM upsert up JOIN prev p ON p.user_id = up.user_id WHERE p.old_geoid IS NOT NULL AND p.old_geoid <> $10 ) INSERT INTO user_jurisdiction_hours (user_id, jurisdiction_geoid, total_hours) SELECT d.user_id, d.geoid, d.delta FROM deltas d ON CONFLICT (user_id, jurisdiction_geoid) DO UPDATE SET total_hours = user_jurisdiction_hours.total_hours + EXCLUDED.total_hours RETURNING user_id -- ["cleanupId-1",["userId-1"],"cleanupId-1","geoid-1","actorId-1",["userId-1"],[3],"geoid-1","geoid-1","geoid-1"]
[tx1] SELECT user_id, COALESCE(SUM(hours), 0)::float8 AS hours FROM volunteer_hours WHERE user_id = ANY($1::uuid[]) AND source <> 'report' AND voided_at IS NULL AND created_at >= now() - $2::interval GROUP BY user_id HAVING COALESCE(SUM(hours), 0) > $3 -- [["userId-1"],"7 days",3]
[tx1] SELECT DISTINCT logged_by_user_id FROM volunteer_hours WHERE user_id = $1 AND source = 'event' AND voided_at IS NULL AND cleanup_id <> $2 AND created_at >= now() - $3::interval AND logged_by_user_id = ANY($4::uuid[]) -- ["actorId-1","cleanupId-1","2592000 seconds",["userId-1"]]
COMMIT tx1
=> {"credited":0,"changed":[],"anomalies":[]}
-- row
BEGIN tx1
[tx1] SELECT pg_advisory_xact_lock(hashtext('volunteer_event:' || $1)) -- ["cleanupId-1"]
[tx1] SELECT pg_advisory_xact_lock(hashtext('volunteer_user:' || u)) FROM unnest($1::uuid[]) AS t(u) ORDER BY u -- [["userId-1"]]
[tx1] SELECT DISTINCT logged_by_user_id FROM volunteer_hours WHERE cleanup_id = $1 AND source = 'event' AND user_id = $2 AND voided_at IS NULL AND logged_by_user_id <> $3 AND logged_by_user_id = ANY($4::uuid[]) -- ["cleanupId-1","actorId-1","actorId-1",["userId-1"]]
ROLLBACK tx1
