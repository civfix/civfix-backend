exports[`sql transcripts > makeDrizzleDiscoveryRepository.saveDraft 1`] = `
"-- empty
BEGIN tx1
[tx1] SELECT geoid FROM jurisdiction_discovery_tasks WHERE id = $1 LIMIT 1 -- ["id-1"]
COMMIT tx1
=> false
-- row
BEGIN tx1
[tx1] SELECT geoid FROM jurisdiction_discovery_tasks WHERE id = $1 LIMIT 1 -- ["id-1"]
[tx1] INSERT INTO jurisdiction_contacts (geoid, category, email, updated_at, bounced_at) VALUES ($1, $2, $3, now(), NULL) ON CONFLICT (geoid, category) WHERE category IS NOT NULL DO UPDATE SET email = EXCLUDED.email, updated_at = now(), bounced_at = NULL -- ["geoid-row","trash","trash-any"]
[tx1] INSERT INTO jurisdiction_contacts (geoid, category, email, updated_at, bounced_at) VALUES ($1, $2, $3, now(), NULL) ON CONFLICT (geoid, category) WHERE category IS NOT NULL DO UPDATE SET email = EXCLUDED.email, updated_at = now(), bounced_at = NULL -- ["geoid-row","recycling","recycling-any"]
[tx1] INSERT INTO jurisdiction_contacts (geoid, category, email, updated_at, bounced_at) VALUES ($1, $2, $3, now(), NULL) ON CONFLICT (geoid, category) WHERE category IS NOT NULL DO UPDATE SET email = EXCLUDED.email, updated_at = now(), bounced_at = NULL -- ["geoid-row","graffiti","graffiti-any"]
[tx1] INSERT INTO jurisdiction_contacts (geoid, category, email, updated_at, bounced_at) VALUES ($1, $2, $3, now(), NULL) ON CONFLICT (geoid, category) WHERE category IS NOT NULL DO UPDATE SET email = EXCLUDED.email, updated_at = now(), bounced_at = NULL -- ["geoid-row","hazard","hazard-any"]
[tx1] INSERT INTO jurisdiction_contacts (geoid, category, email, updated_at, bounced_at) VALUES ($1, $2, $3, now(), NULL) ON CONFLICT (geoid, category) WHERE category IS NOT NULL DO UPDATE SET email = EXCLUDED.email, updated_at = now(), bounced_at = NULL -- ["geoid-row","encampment","encampment-any"]
[tx1] INSERT INTO jurisdiction_contacts (geoid, category, email, updated_at, bounced_at) VALUES ($1, $2, $3, now(), NULL) ON CONFLICT (geoid, category) WHERE category IS NOT NULL DO UPDATE SET email = EXCLUDED.email, updated_at = now(), bounced_at = NULL -- ["geoid-row","water","water-any"]
[tx1] INSERT INTO jurisdiction_contacts (geoid, category, email, updated_at, bounced_at) VALUES ($1, $2, $3, now(), NULL) ON CONFLICT (geoid, category) WHERE category IS NOT NULL DO UPDATE SET email = EXCLUDED.email, updated_at = now(), bounced_at = NULL -- ["geoid-row","other","other-any"]
[tx1] INSERT INTO jurisdiction_contacts (geoid, category, email, form_url, updated_at, bounced_at) VALUES ($1, NULL, $2, $3, now(), NULL) ON CONFLICT (geoid) WHERE category IS NULL DO UPDATE SET email = CASE WHEN $4 THEN EXCLUDED.email ELSE jurisdiction_contacts.email END, form_url = CASE WHEN $5 THEN EXCLUDED.form_url ELSE jurisdiction_contacts.form_url END, updated_at = now(), bounced_at = CASE WHEN $6 THEN NULL ELSE jurisdiction_contacts.bounced_at END -- ["geoid-row","defaultEmail-1","formUrl-1",true,true,true]
[tx1] UPDATE jurisdictions SET contact_emails = CASE WHEN $1 > 0 THEN $2 ELSE contact_emails END, report_form_url = COALESCE($3, report_form_url) WHERE geoid = $4 -- [1,["defaultEmail-1"],"formUrl-1","geoid-row"]
[tx1] INSERT INTO audit_log (actor_id, action, target, meta) VALUES ($1, $2, $3, $4) RETURNING id -- ["actorId-1","discovery.draft_saved","discovery:id-1",{"<json>":{"geoid":"geoid-row","categories":["trash","recycling","graffiti","hazard","encampment","water","other"],"defaultEmails":["defaultEmail-1"]}}]
COMMIT tx1
=> true"
`;

