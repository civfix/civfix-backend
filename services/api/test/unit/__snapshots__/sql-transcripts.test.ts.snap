exports[`sql transcripts > makeDrizzleSocialRepository.pastEventsPageFor 1`] = `
"-- empty
WITH ids AS ( SELECT id AS cleanup_id FROM cleanups WHERE organizer_user_id = $1 UNION SELECT cleanup_id FROM cleanup_members WHERE user_id = $2 ) SELECT c.id, c.organizer_user_id, c.type, c.event_kind, c.title, c.description, ST_X(c.geom) AS lng, ST_Y(c.geom) AS lat, c.scheduled_at, c.completed_at, c.ends_at, c.timezone, CASE WHEN c.status = 'cancelled' THEN 'cancelled' WHEN c.ends_at <= now() THEN 'done' WHEN c.scheduled_at <= now() THEN 'active' ELSE 'upcoming' END AS status, c.bring, c.address, c.address_source, c.jurisdiction_geoid, c.reference_code, c.created_at, c.capacity, c.visibility, ((SELECT count(*)::int FROM cleanup_members m WHERE m.cleanup_id = c.id) + ( SELECT count(*)::int FROM cleanup_guests cg WHERE cg.cleanup_id = c.id AND cg.cancelled_at IS NULL )) AS going, u.display_name AS org_display_name, u.handle AS org_handle, u.bio AS org_bio, u.avatar_url AS org_avatar_url, u.donation_url AS org_donation_url FROM cleanups c JOIN ids ON ids.cleanup_id = c.id JOIN users u ON u.id = c.organizer_user_id WHERE c.status <> 'cancelled' AND c.visibility = 'public' AND c.scheduled_at < now() ORDER BY c.scheduled_at DESC, c.id DESC LIMIT $3 -- ["userId-1","userId-1",4]
=> {"items":[],"nextCursor":null}
-- row
WITH ids AS ( SELECT id AS cleanup_id FROM cleanups WHERE organizer_user_id = $1 UNION SELECT cleanup_id FROM cleanup_members WHERE user_id = $2 ) SELECT c.id, c.organizer_user_id, c.type, c.event_kind, c.title, c.description, ST_X(c.geom) AS lng, ST_Y(c.geom) AS lat, c.scheduled_at, c.completed_at, c.ends_at, c.timezone, CASE WHEN c.status = 'cancelled' THEN 'cancelled' WHEN c.ends_at <= now() THEN 'done' WHEN c.scheduled_at <= now() THEN 'active' ELSE 'upcoming' END AS status, c.bring, c.address, c.address_source, c.jurisdiction_geoid, c.reference_code, c.created_at, c.capacity, c.visibility, ((SELECT count(*)::int FROM cleanup_members m WHERE m.cleanup_id = c.id) + ( SELECT count(*)::int FROM cleanup_guests cg WHERE cg.cleanup_id = c.id AND cg.cancelled_at IS NULL )) AS going, u.display_name AS org_display_name, u.handle AS org_handle, u.bio AS org_bio, u.avatar_url AS org_avatar_url, u.donation_url AS org_donation_url FROM cleanups c JOIN ids ON ids.cleanup_id = c.id JOIN users u ON u.id = c.organizer_user_id WHERE c.status <> 'cancelled' AND c.visibility = 'public' AND c.scheduled_at < now() ORDER BY c.scheduled_at DESC, c.id DESC LIMIT $3 -- ["userId-1","userId-1",4]
=> {"items":[{"id":"id-row","organizerUserId":"organizer_user_id-row","type":"type-row","eventKind":"event_kind-row","title":"title-row","description":"description-row","lat":34.05,"lng":-118.24,"scheduledAt":"2026-03-04T05:06:07.000Z","completedAt":"2026-03-04T05:06:07.000Z","status":"status-row","bring":"bring-row","address":"address-row","addressSource":"address_source-row","jurisdictionGeoid":"jurisdiction_geoid-row","referenceCode":"reference_code-row","createdAt":"2026-03-04T05:06:07.000Z","capacity":"capacity-row","going":null,"dist":null,"organizer":{"id":"organizer_user_id-row","displayName":"org_display_name-row","handle":"org_handle-row","bio":"org_bio-row","avatarUrl":"org_avatar_url-row","donationUrl":"org_donation_url-row"},"endsAt":"2026-03-04T05:06:07.000Z","timezone":"timezone-row","visibility":"visibility-row","coverMediaId":null,"coverKey":null,"galleryMediaIds":[],"donationUrl":null,"pageSlug":null,"registrationOpensAt":null,"registrationClosesAt":null,"organizationId":null,"organization":null,"reminderOffsetsMin":null,"hostReplyTo":null,"hostReplyToVerifiedAt":null}],"nextCursor":null}"
