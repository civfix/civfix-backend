=> {"reports":0,"fixed":0,"cleanups":0}
-- row
SELECT (SELECT count(*)::int FROM reports r WHERE r.reporter_user_id = $1 AND r.deleted_at IS NULL) AS reports, (SELECT count(*)::int FROM reports r WHERE r.reporter_user_id = $2 AND r.deleted_at IS NULL AND r.status = 'resolved') AS fixed, ( SELECT count(*)::int FROM cleanups c WHERE c.organizer_user_id = $3 AND c.visibility = 'public' ) AS cleanups -- ["userId-1","userId-1","userId-1"]
=> {"reports":"reports-row","fixed":"fixed-row","cleanups":"cleanups-row"}"
`;

exports[`sql transcripts > makeDrizzleSocialRepository.suggestFollows 1`] = `
"-- empty
WITH viewer_point AS ( SELECT p.geom FROM ( SELECT r.geom, r.created_at FROM reports r WHERE r.reporter_user_id = $1 AND r.deleted_at IS NULL UNION ALL SELECT c.geom, c.created_at FROM cleanups c WHERE c.organizer_user_id = $2 UNION ALL SELECT c.geom, c.created_at FROM cleanups c JOIN cleanup_members m ON m.cleanup_id = c.id WHERE m.user_id = $3 ) p ORDER BY p.created_at DESC NULLS LAST LIMIT 1 ), near_pool AS ( SELECT n.id FROM viewer_point vp CROSS JOIN LATERAL ( SELECT u.id FROM users u WHERE u.deleted_at IS NULL AND u.handle IS NOT NULL AND u.id <> $4 AND u.id <> $5 AND NOT EXISTS ( SELECT 1 FROM follows_people f WHERE f.follower_id = $6 AND f.followee_id = u.id ) AND NOT EXISTS ( SELECT 1 FROM user_blocks b WHERE (b.blocker_id = $7 AND b.blocked_id = u.id) OR (b.blocker_id = u.id AND b.blocked_id = $8) ) AND u.last_activity_geom IS NOT NULL AND ST_DWithin(u.last_activity_geom, vp.geom, $9) ORDER BY u.last_activity_geom <-> vp.geom LIMIT $10 ) n ), recent_pool AS ( SELECT u.id FROM users u WHERE u.deleted_at IS NULL AND u.handle IS NOT NULL AND u.id <> $11 AND u.id <> $12 AND NOT EXISTS ( SELECT 1 FROM follows_people f WHERE f.follower_id = $13 AND f.followee_id = u.id ) AND NOT EXISTS ( SELECT 1 FROM user_blocks b WHERE (b.blocker_id = $14 AND b.blocked_id = u.id) OR (b.blocker_id = u.id AND b.blocked_id = $15) ) AND u.last_activity_at IS NOT NULL ORDER BY u.last_activity_at DESC LIMIT $16 ), new_pool AS ( SELECT u.id FROM users u WHERE u.deleted_at IS NULL AND u.handle IS NOT NULL AND u.id <> $17 AND u.id <> $18 AND NOT EXISTS ( SELECT 1 FROM follows_people f WHERE f.follower_id = $19 AND f.followee_id = u.id ) AND NOT EXISTS ( SELECT 1 FROM user_blocks b WHERE (b.blocker_id = $20 AND b.blocked_id = u.id) OR (b.blocker_id = u.id AND b.blocked_id = $21) ) ORDER BY u.created_at DESC, u.id DESC LIMIT $22 ), pool AS ( SELECT id FROM near_pool UNION SELECT id FROM recent_pool UNION SELECT id FROM new_pool ), candidates AS ( SELECT u.id, u.display_name, u.handle, u.bio, u.avatar_media_id, u.avatar_url, u.show_volunteer_hours, u.created_at, u.follower_count AS followers, u.following_count AS following, EXISTS ( SELECT 1 FROM cleanups oc WHERE oc.organizer_user_id = u.id AND oc.visibility = 'public' ) AS is_organizer, dist.meters AS dist_meters, (dist.meters IS NOT NULL AND dist.meters <= $23) AS is_near FROM pool p JOIN users u ON u.id = p.id LEFT JOIN LATERAL ( SELECT ST_Distance(vp.geom::geography, u.last_activity_geom::geography) AS meters FROM viewer_point vp WHERE u.last_activity_geom IS NOT NULL ) dist ON TRUE ), ranked AS ( SELECT * FROM candidates ORDER BY (is_near AND is_organizer) DESC, is_near DESC, is_organizer DESC, dist_meters ASC NULLS LAST, followers DESC, created_at DESC LIMIT $24 ) SELECT c.id, c.display_name, c.handle, c.bio, c.followers, c.following, COALESCE(<helper ["am"]>.served_key, CASE WHEN <helper ["am"]>.status = 'validating' THEN <helper ["am"]>.r2_key END) AS avatar_r2_key, c.avatar_url, c.show_volunteer_hours, c.is_organizer FROM ranked c LEFT JOIN media_assets am ON am.id = c.avatar_media_id ORDER BY (c.is_near AND c.is_organizer) DESC, c.is_near DESC, c.is_organizer DESC, c.dist_meters ASC NULLS LAST, c.followers DESC, c.created_at DESC -- ["viewerId-1","viewerId-1","viewerId-1","viewerId-1","00000000-0000-4000-8000-00000000c1f1","viewerId-1","viewerId-1","viewerId-1",2.5,200,"viewerId-1","00000000-0000-4000-8000-00000000c1f1","viewerId-1","viewerId-1","viewerId-1",200,"viewerId-1","00000000-0000-4000-8000-00000000c1f1","viewerId-1","viewerId-1","viewerId-1",200,25000,3]
=> []
-- row
WITH viewer_point AS ( SELECT p.geom FROM ( SELECT r.geom, r.created_at FROM reports r WHERE r.reporter_user_id = $1 AND r.deleted_at IS NULL UNION ALL SELECT c.geom, c.created_at FROM cleanups c WHERE c.organizer_user_id = $2 UNION ALL SELECT c.geom, c.created_at FROM cleanups c JOIN cleanup_members m ON m.cleanup_id = c.id WHERE m.user_id = $3 ) p ORDER BY p.created_at DESC NULLS LAST LIMIT 1 ), near_pool AS ( SELECT n.id FROM viewer_point vp CROSS JOIN LATERAL ( SELECT u.id FROM users u WHERE u.deleted_at IS NULL AND u.handle IS NOT NULL AND u.id <> $4 AND u.id <> $5 AND NOT EXISTS ( SELECT 1 FROM follows_people f WHERE f.follower_id = $6 AND f.followee_id = u.id ) AND NOT EXISTS ( SELECT 1 FROM user_blocks b WHERE (b.blocker_id = $7 AND b.blocked_id = u.id) OR (b.blocker_id = u.id AND b.blocked_id = $8) ) AND u.last_activity_geom IS NOT NULL AND ST_DWithin(u.last_activity_geom, vp.geom, $9) ORDER BY u.last_activity_geom <-> vp.geom LIMIT $10 ) n ), recent_pool AS ( SELECT u.id FROM users u WHERE u.deleted_at IS NULL AND u.handle IS NOT NULL AND u.id <> $11 AND u.id <> $12 AND NOT EXISTS ( SELECT 1 FROM follows_people f WHERE f.follower_id = $13 AND f.followee_id = u.id ) AND NOT EXISTS ( SELECT 1 FROM user_blocks b WHERE (b.blocker_id = $14 AND b.blocked_id = u.id) OR (b.blocker_id = u.id AND b.blocked_id = $15) ) AND u.last_activity_at IS NOT NULL ORDER BY u.last_activity_at DESC LIMIT $16 ), new_pool AS ( SELECT u.id FROM users u WHERE u.deleted_at IS NULL AND u.handle IS NOT NULL AND u.id <> $17 AND u.id <> $18 AND NOT EXISTS ( SELECT 1 FROM follows_people f WHERE f.follower_id = $19 AND f.followee_id = u.id ) AND NOT EXISTS ( SELECT 1 FROM user_blocks b WHERE (b.blocker_id = $20 AND b.blocked_id = u.id) OR (b.blocker_id = u.id AND b.blocked_id = $21) ) ORDER BY u.created_at DESC, u.id DESC LIMIT $22 ), pool AS ( SELECT id FROM near_pool UNION SELECT id FROM recent_pool UNION SELECT id FROM new_pool ), candidates AS ( SELECT u.id, u.display_name, u.handle, u.bio, u.avatar_media_id, u.avatar_url, u.show_volunteer_hours, u.created_at, u.follower_count AS followers, u.following_count AS following, EXISTS ( SELECT 1 FROM cleanups oc WHERE oc.organizer_user_id = u.id AND oc.visibility = 'public' ) AS is_organizer, dist.meters AS dist_meters, (dist.meters IS NOT NULL AND dist.meters <= $23) AS is_near FROM pool p JOIN users u ON u.id = p.id LEFT JOIN LATERAL ( SELECT ST_Distance(vp.geom::geography, u.last_activity_geom::geography) AS meters FROM viewer_point vp WHERE u.last_activity_geom IS NOT NULL ) dist ON TRUE ), ranked AS ( SELECT * FROM candidates ORDER BY (is_near AND is_organizer) DESC, is_near DESC, is_organizer DESC, dist_meters ASC NULLS LAST, followers DESC, created_at DESC LIMIT $24 ) SELECT c.id, c.display_name, c.handle, c.bio, c.followers, c.following, COALESCE(<helper ["am"]>.served_key, CASE WHEN <helper ["am"]>.status = 'validating' THEN <helper ["am"]>.r2_key END) AS avatar_r2_key, c.avatar_url, c.show_volunteer_hours, c.is_organizer FROM ranked c LEFT JOIN media_assets am ON am.id = c.avatar_media_id ORDER BY (c.is_near AND c.is_organizer) DESC, c.is_near DESC, c.is_organizer DESC, c.dist_meters ASC NULLS LAST, c.followers DESC, c.created_at DESC -- ["viewerId-1","viewerId-1","viewerId-1","viewerId-1","00000000-0000-4000-8000-00000000c1f1","viewerId-1","viewerId-1","viewerId-1",2.5,200,"viewerId-1","00000000-0000-4000-8000-00000000c1f1","viewerId-1","viewerId-1","viewerId-1",200,"viewerId-1","00000000-0000-4000-8000-00000000c1f1","viewerId-1","viewerId-1","viewerId-1",200,25000,3]
