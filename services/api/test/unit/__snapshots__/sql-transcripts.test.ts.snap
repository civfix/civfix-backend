[tx1] SELECT flagged FROM user_moderation WHERE user_id = $1 LIMIT 1 -- ["id-1"]
[tx1] INSERT INTO user_moderation (user_id, flagged, flag_reason, updated_at) VALUES ($1, $2, $3, now()) ON CONFLICT (user_id) DO UPDATE SET flagged = EXCLUDED.flagged, flag_reason = EXCLUDED.flag_reason, updated_at = now() -- ["id-1",false,null]
[tx1] UPDATE abuse_flags SET resolved_at = now() WHERE subject_type = 'user' AND subject_id = $1 AND resolved_at IS NULL -- ["id-1"]
[tx1] INSERT INTO audit_log (actor_id, action, target, meta) VALUES ($1, $2, $3, $4) RETURNING id -- ["actorId-1","user.unflagged","user:id-1",{"<json>":{"reason":"reason-1"}}]
COMMIT tx1
=> false"
`;

