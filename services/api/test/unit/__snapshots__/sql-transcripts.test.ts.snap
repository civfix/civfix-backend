exports[`sql transcripts > makeDrizzleOutreachRepository.listCandidateGeoids 1`] = `
"-- empty
WITH candidate AS ( SELECT DISTINCT r.jurisdiction_geoid AS geoid FROM reports r WHERE r.deleted_at IS NULL AND r.status NOT IN ('rejected', 'resolved') AND r.jurisdiction_geoid IS NOT NULL ) SELECT c.geoid FROM candidate c LEFT JOIN outreach_state os ON os.geoid = c.geoid WHERE COALESCE(os.suppressed, false) = false AND ( EXISTS ( SELECT 1 FROM jurisdiction_contacts jc WHERE jc.geoid = c.geoid AND jc.email IS NOT NULL AND jc.email <> '' AND jc.bounced_at IS NULL ) OR EXISTS ( SELECT 1 FROM jurisdictions j WHERE j.geoid = c.geoid AND j.contact_emails IS NOT NULL AND EXISTS ( SELECT 1 FROM unnest(j.contact_emails) AS e WHERE e <> '' ) ) ) ORDER BY os.last_outreach_at ASC NULLS FIRST, c.geoid ASC LIMIT $1 -- [3]
=> []
-- row
WITH candidate AS ( SELECT DISTINCT r.jurisdiction_geoid AS geoid FROM reports r WHERE r.deleted_at IS NULL AND r.status NOT IN ('rejected', 'resolved') AND r.jurisdiction_geoid IS NOT NULL ) SELECT c.geoid FROM candidate c LEFT JOIN outreach_state os ON os.geoid = c.geoid WHERE COALESCE(os.suppressed, false) = false AND ( EXISTS ( SELECT 1 FROM jurisdiction_contacts jc WHERE jc.geoid = c.geoid AND jc.email IS NOT NULL AND jc.email <> '' AND jc.bounced_at IS NULL ) OR EXISTS ( SELECT 1 FROM jurisdictions j WHERE j.geoid = c.geoid AND j.contact_emails IS NOT NULL AND EXISTS ( SELECT 1 FROM unnest(j.contact_emails) AS e WHERE e <> '' ) ) ) ORDER BY os.last_outreach_at ASC NULLS FIRST, c.geoid ASC LIMIT $1 -- [3]
=> ["geoid-row"]"
`;

exports[`sql transcripts > makeDrizzleOutreachRepository.loadDigest 1`] = `
"-- empty
SELECT j.name AS org, COALESCE( ( SELECT dc.email FROM jurisdiction_contacts dc WHERE dc.geoid = j.geoid AND dc.category IS NULL AND dc.email IS NOT NULL AND dc.email <> '' AND dc.bounced_at IS NULL LIMIT 1 ), ( SELECT cc.email FROM jurisdiction_contacts cc WHERE cc.geoid = j.geoid AND cc.category IS NOT NULL AND cc.email IS NOT NULL AND cc.email <> '' AND cc.bounced_at IS NULL ORDER BY COALESCE( array_position($1::text[], cc.category), 2147483647 ), cc.category ASC LIMIT 1 ), ( SELECT e FROM unnest(COALESCE(j.contact_emails, ARRAY[]::text[])) AS e WHERE e <> '' LIMIT 1 ) ) AS to_addr, COALESCE(w.total, 0)::text AS total, w.oldest_waiting_at, COALESCE(<helper ["w"]>.<helper ["cat_trash"]>, '0') AS <helper ["cat_trash"]>, COALESCE(<helper ["w"]>.<helper ["cat_recycling"]>, '0') AS <helper ["cat_recycling"]>, COALESCE(<helper ["w"]>.<helper ["cat_graffiti"]>, '0') AS <helper ["cat_graffiti"]>, COALESCE(<helper ["w"]>.<helper ["cat_hazard"]>, '0') AS <helper ["cat_hazard"]>, COALESCE(<helper ["w"]>.<helper ["cat_encampment"]>, '0') AS <helper ["cat_encampment"]>, COALESCE(<helper ["w"]>.<helper ["cat_water"]>, '0') AS <helper ["cat_water"]>, COALESCE(<helper ["w"]>.<helper ["cat_other"]>, '0') AS <helper ["cat_other"]> FROM jurisdictions j LEFT JOIN LATERAL ( SELECT COUNT(*) AS total, MIN(r.created_at) AS oldest_waiting_at, COUNT(*) FILTER (WHERE <helper ["r"]>.category = $2)::text AS <helper ["cat_trash"]>, COUNT(*) FILTER (WHERE <helper ["r"]>.category = $3)::text AS <helper ["cat_recycling"]>, COUNT(*) FILTER (WHERE <helper ["r"]>.category = $4)::text AS <helper ["cat_graffiti"]>, COUNT(*) FILTER (WHERE <helper ["r"]>.category = $5)::text AS <helper ["cat_hazard"]>, COUNT(*) FILTER (WHERE <helper ["r"]>.category = $6)::text AS <helper ["cat_encampment"]>, COUNT(*) FILTER (WHERE <helper ["r"]>.category = $7)::text AS <helper ["cat_water"]>, COUNT(*) FILTER (WHERE <helper ["r"]>.category = $8)::text AS <helper ["cat_other"]> FROM reports r WHERE r.jurisdiction_geoid = j.geoid AND r.deleted_at IS NULL AND r.status NOT IN ('rejected', 'resolved') ) w ON true WHERE j.geoid = $9 LIMIT 1 -- [["trash","recycling","graffiti","hazard","encampment","water","other"],"trash","recycling","graffiti","hazard","encampment","water","other","geoid-1"]
=> null
