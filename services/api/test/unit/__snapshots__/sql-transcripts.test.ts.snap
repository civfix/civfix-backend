exports[`sql transcripts > makeDrizzleGroupThreadsSource.listGroupThreadsFor 1`] = `
"-- empty
WITH page AS ( SELECT r.id AS room_id, mem.joined_at AS joined_at, mem.last_read_at AS last_read_at, date_trunc('milliseconds', COALESCE(last_msg.created_at, mem.joined_at)) AS activity FROM <helper ["chat_group_members"]> mem JOIN <helper ["chat_groups"]> r ON r.id = mem.<helper ["group_id"]> LEFT JOIN LATERAL ( SELECT cm.created_at FROM chat_messages cm WHERE cm.<helper ["group_id"]> = r.id AND cm.deleted_at IS NULL ORDER BY cm.created_at DESC, cm.id DESC LIMIT 1 ) last_msg ON TRUE LEFT JOIN conversation_hides h ON h.user_id = $1 AND h.room_kind = $2 AND h.room_id = r.id WHERE mem.user_id = $3 AND (h.hidden_at IS NULL OR COALESCE(last_msg.created_at, mem.joined_at) > h.hidden_at) AND date_trunc('milliseconds', COALESCE(last_msg.created_at, mem.joined_at)) < $4 AND (date_trunc('milliseconds', COALESCE(last_msg.created_at, mem.joined_at)) < $5 OR r.id < $6::uuid) ORDER BY date_trunc('milliseconds', COALESCE(last_msg.created_at, mem.joined_at)) DESC, r.id DESC LIMIT $7 ) SELECT page.room_id, r.name, r.kind, page.joined_at, (SELECT count(*)::int FROM <helper ["chat_group_members"]> m WHERE m.<helper ["group_id"]> = page.room_id) AS members, ( SELECT count(*)::int FROM chat_messages cm WHERE cm.<helper ["group_id"]> = page.room_id AND cm.deleted_at IS NULL AND cm.sender_id IS DISTINCT FROM $8 AND cm.created_at > GREATEST(page.joined_at, COALESCE(page.last_read_at, to_timestamp(0))) ) AS unread, last_msg.body AS last_body, last_msg.created_at AS last_created_at, last_msg.sender_id AS last_sender_id FROM page JOIN <helper ["chat_groups"]> r ON r.id = page.room_id LEFT JOIN LATERAL ( SELECT cm.body, cm.created_at, cm.sender_id FROM chat_messages cm WHERE cm.<helper ["group_id"]> = page.room_id AND cm.deleted_at IS NULL ORDER BY cm.created_at DESC, cm.id DESC LIMIT 1 ) last_msg ON TRUE ORDER BY page.activity DESC, page.room_id DESC -- ["userId-1","group","userId-1","2026-03-04T05:06:07.001Z","2026-03-04T05:06:07.000Z","id-1",3,"userId-1"]
=> []
-- row
WITH page AS ( SELECT r.id AS room_id, mem.joined_at AS joined_at, mem.last_read_at AS last_read_at, date_trunc('milliseconds', COALESCE(last_msg.created_at, mem.joined_at)) AS activity FROM <helper ["chat_group_members"]> mem JOIN <helper ["chat_groups"]> r ON r.id = mem.<helper ["group_id"]> LEFT JOIN LATERAL ( SELECT cm.created_at FROM chat_messages cm WHERE cm.<helper ["group_id"]> = r.id AND cm.deleted_at IS NULL ORDER BY cm.created_at DESC, cm.id DESC LIMIT 1 ) last_msg ON TRUE LEFT JOIN conversation_hides h ON h.user_id = $1 AND h.room_kind = $2 AND h.room_id = r.id WHERE mem.user_id = $3 AND (h.hidden_at IS NULL OR COALESCE(last_msg.created_at, mem.joined_at) > h.hidden_at) AND date_trunc('milliseconds', COALESCE(last_msg.created_at, mem.joined_at)) < $4 AND (date_trunc('milliseconds', COALESCE(last_msg.created_at, mem.joined_at)) < $5 OR r.id < $6::uuid) ORDER BY date_trunc('milliseconds', COALESCE(last_msg.created_at, mem.joined_at)) DESC, r.id DESC LIMIT $7 ) SELECT page.room_id, r.name, r.kind, page.joined_at, (SELECT count(*)::int FROM <helper ["chat_group_members"]> m WHERE m.<helper ["group_id"]> = page.room_id) AS members, ( SELECT count(*)::int FROM chat_messages cm WHERE cm.<helper ["group_id"]> = page.room_id AND cm.deleted_at IS NULL AND cm.sender_id IS DISTINCT FROM $8 AND cm.created_at > GREATEST(page.joined_at, COALESCE(page.last_read_at, to_timestamp(0))) ) AS unread, last_msg.body AS last_body, last_msg.created_at AS last_created_at, last_msg.sender_id AS last_sender_id FROM page JOIN <helper ["chat_groups"]> r ON r.id = page.room_id LEFT JOIN LATERAL ( SELECT cm.body, cm.created_at, cm.sender_id FROM chat_messages cm WHERE cm.<helper ["group_id"]> = page.room_id AND cm.deleted_at IS NULL ORDER BY cm.created_at DESC, cm.id DESC LIMIT 1 ) last_msg ON TRUE ORDER BY page.activity DESC, page.room_id DESC -- ["userId-1","group","userId-1","2026-03-04T05:06:07.001Z","2026-03-04T05:06:07.000Z","id-1",3,"userId-1"]
=> [{"groupId":"room_id-row","title":"name-row","kind":"kind-row","members":"members-row","unread":"unread-row","joinedAt":"2026-03-04T05:06:07.000Z","last":{"body":"last_body-row","createdAt":"2026-03-04T05:06:07.000Z","senderId":"last_sender_id-row"}}]"
`;

exports[`sql transcripts > makeDrizzleGuestRsvpRepository.cancelGuest 1`] = `
"-- empty
WITH cancelled_guest AS ( UPDATE cleanup_guests SET cancelled_at = $1, email = NULL, phone = NULL, contact_key = NULL, contact_scrubbed_at = COALESCE(contact_scrubbed_at, $2) WHERE id = $3 AND cancelled_at IS NULL RETURNING id ), cancelled_registrations AS ( UPDATE cleanup_registrations r SET status = 'cancelled', cancelled_at = $4 FROM cancelled_guest g WHERE r.guest_id = g.id AND r.status = 'registered' RETURNING r.id, r.ticket_type_id, r.party_size ), cancelled_seats AS ( UPDATE cleanup_registration_seats s SET status = 'cancelled', attendee_name = NULL FROM cancelled_registrations r WHERE s.registration_id = r.id AND s.status = 'active' RETURNING s.id ), scrubbed_answers AS ( UPDATE cleanup_answers a SET value_text = NULL, value_json = NULL, scrubbed_at = $5 FROM cancelled_registrations r WHERE a.registration_id = r.id AND a.scrubbed_at IS NULL RETURNING a.id ), cancelled_waitlist AS ( UPDATE cleanup_waitlist w SET status = 'cancelled' FROM cancelled_guest g WHERE w.guest_id = g.id AND w.status IN ('waiting', 'offered') RETURNING w.id, w.ticket_type_id, w.party_size, w.offered_at ), releases AS ( SELECT ticket_type_id, sum(party_size)::int AS seats FROM ( SELECT ticket_type_id, party_size FROM cancelled_registrations WHERE ticket_type_id IS NOT NULL UNION ALL SELECT ticket_type_id, party_size FROM cancelled_waitlist WHERE offered_at IS NOT NULL ) held GROUP BY ticket_type_id ) , released_types AS ( UPDATE cleanup_ticket_types t SET reserved_seats = GREATEST(t.reserved_seats - r.seats, 0), updated_at = $6 FROM releases r WHERE t.id = r.ticket_type_id RETURNING t.id ) SELECT id AS ticket_type_id FROM released_types -- ["2026-03-04T05:06:07.000Z","2026-03-04T05:06:07.000Z","guestId-1","2026-03-04T05:06:07.000Z","2026-03-04T05:06:07.000Z","2026-03-04T05:06:07.000Z"]
=> []
-- row
WITH cancelled_guest AS ( UPDATE cleanup_guests SET cancelled_at = $1, email = NULL, phone = NULL, contact_key = NULL, contact_scrubbed_at = COALESCE(contact_scrubbed_at, $2) WHERE id = $3 AND cancelled_at IS NULL RETURNING id ), cancelled_registrations AS ( UPDATE cleanup_registrations r SET status = 'cancelled', cancelled_at = $4 FROM cancelled_guest g WHERE r.guest_id = g.id AND r.status = 'registered' RETURNING r.id, r.ticket_type_id, r.party_size ), cancelled_seats AS ( UPDATE cleanup_registration_seats s SET status = 'cancelled', attendee_name = NULL FROM cancelled_registrations r WHERE s.registration_id = r.id AND s.status = 'active' RETURNING s.id ), scrubbed_answers AS ( UPDATE cleanup_answers a SET value_text = NULL, value_json = NULL, scrubbed_at = $5 FROM cancelled_registrations r WHERE a.registration_id = r.id AND a.scrubbed_at IS NULL RETURNING a.id ), cancelled_waitlist AS ( UPDATE cleanup_waitlist w SET status = 'cancelled' FROM cancelled_guest g WHERE w.guest_id = g.id AND w.status IN ('waiting', 'offered') RETURNING w.id, w.ticket_type_id, w.party_size, w.offered_at ), releases AS ( SELECT ticket_type_id, sum(party_size)::int AS seats FROM ( SELECT ticket_type_id, party_size FROM cancelled_registrations WHERE ticket_type_id IS NOT NULL UNION ALL SELECT ticket_type_id, party_size FROM cancelled_waitlist WHERE offered_at IS NOT NULL ) held GROUP BY ticket_type_id ) , released_types AS ( UPDATE cleanup_ticket_types t SET reserved_seats = GREATEST(t.reserved_seats - r.seats, 0), updated_at = $6 FROM releases r WHERE t.id = r.ticket_type_id RETURNING t.id ) SELECT id AS ticket_type_id FROM released_types -- ["2026-03-04T05:06:07.000Z","2026-03-04T05:06:07.000Z","guestId-1","2026-03-04T05:06:07.000Z","2026-03-04T05:06:07.000Z","2026-03-04T05:06:07.000Z"]
=> ["ticket_type_id-row"]"
`;

