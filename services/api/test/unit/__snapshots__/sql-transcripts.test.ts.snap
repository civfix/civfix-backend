exports[`sql transcripts > makeDrizzleDiscoveryRepository.getDetail 1`] = `
"-- empty
WITH waiting AS ( SELECT r.jurisdiction_geoid AS geoid, COUNT(*) AS total, MIN(r.created_at) AS oldest_waiting_at, MAX(r.created_at) AS newest_waiting_at, COUNT(*) FILTER (WHERE <helper ["r"]>.category = $1)::text AS <helper ["cat_trash"]>, COUNT(*) FILTER (WHERE <helper ["r"]>.category = $2)::text AS <helper ["cat_recycling"]>, COUNT(*) FILTER (WHERE <helper ["r"]>.category = $3)::text AS <helper ["cat_graffiti"]>, COUNT(*) FILTER (WHERE <helper ["r"]>.category = $4)::text AS <helper ["cat_hazard"]>, COUNT(*) FILTER (WHERE <helper ["r"]>.category = $5)::text AS <helper ["cat_encampment"]>, COUNT(*) FILTER (WHERE <helper ["r"]>.category = $6)::text AS <helper ["cat_water"]>, COUNT(*) FILTER (WHERE <helper ["r"]>.category = $7)::text AS <helper ["cat_other"]>, array_agg(DISTINCT r.category) AS waiting_categories FROM reports r WHERE r.deleted_at IS NULL AND r.status NOT IN ('rejected', 'resolved') AND r.jurisdiction_geoid IN (SELECT dt.geoid FROM jurisdiction_discovery_tasks dt WHERE dt.id = $8 AND dt.geoid IS NOT NULL) GROUP BY r.jurisdiction_geoid ) SELECT t.id, t.geoid, j.name AS place, j.layer AS layer, COALESCE(j.population, t.population) AS population, t.status, COALESCE(w.total, 0)::text AS total, w.oldest_waiting_at, w.newest_waiting_at, COALESCE(<helper ["w"]>.<helper ["cat_trash"]>, '0') AS <helper ["cat_trash"]>, COALESCE(<helper ["w"]>.<helper ["cat_recycling"]>, '0') AS <helper ["cat_recycling"]>, COALESCE(<helper ["w"]>.<helper ["cat_graffiti"]>, '0') AS <helper ["cat_graffiti"]>, COALESCE(<helper ["w"]>.<helper ["cat_hazard"]>, '0') AS <helper ["cat_hazard"]>, COALESCE(<helper ["w"]>.<helper ["cat_encampment"]>, '0') AS <helper ["cat_encampment"]>, COALESCE(<helper ["w"]>.<helper ["cat_water"]>, '0') AS <helper ["cat_water"]>, COALESCE(<helper ["w"]>.<helper ["cat_other"]>, '0') AS <helper ["cat_other"]>, c.categories AS contact_categories, ( COALESCE(c.has_default, false) OR COALESCE(array_length(j.contact_emails, 1), 0) > 0 ) AS has_default_contact FROM jurisdiction_discovery_tasks t LEFT JOIN jurisdictions j ON j.geoid = t.geoid LEFT JOIN waiting w ON w.geoid = t.geoid LEFT JOIN LATERAL ( SELECT array_agg(jc.category) FILTER (WHERE jc.category IS NOT NULL) AS categories, bool_or(jc.category IS NULL) AS has_default FROM jurisdiction_contacts jc WHERE jc.geoid = t.geoid AND (jc.email IS NOT NULL AND jc.email <> '') ) c ON true WHERE t.status <> 'done' AND t.id = $9 -- ["trash","recycling","graffiti","hazard","encampment","water","other","id-1","id-1"]
