`;

exports[`sql transcripts > makeDrizzleModerationRepository.getItem 1`] = `
"-- empty
SELECT id, kind, subject_type, subject_id, flag, reason, category, place, priority, auto_action, status, signals, "similar", meta, created_at , CASE WHEN subject_type IN ('chat', 'message') THEN ( SELECT CASE WHEN cm.report_id IS NOT NULL THEN 'report:' || cm.report_id::text WHEN cm.cleanup_id IS NOT NULL THEN 'event:' || cm.cleanup_id::text ELSE NULL END FROM chat_messages cm WHERE cm.id = moderation_items.subject_id LIMIT 1 ) WHEN subject_type = 'photo' THEN ( SELECT CASE WHEN COALESCE(ma.report_id, cm.report_id) IS NOT NULL THEN 'report:' || COALESCE(ma.report_id, cm.report_id)::text WHEN cm.cleanup_id IS NOT NULL THEN 'event:' || cm.cleanup_id::text ELSE NULL END FROM media_assets ma LEFT JOIN chat_messages cm ON cm.id = ma.chat_message_id WHERE ma.id = moderation_items.subject_id LIMIT 1 ) ELSE NULL END AS destination_ref FROM moderation_items WHERE id = $1 LIMIT 1 -- ["id-1"]
=> null
-- row
SELECT id, kind, subject_type, subject_id, flag, reason, category, place, priority, auto_action, status, signals, "similar", meta, created_at , CASE WHEN subject_type IN ('chat', 'message') THEN ( SELECT CASE WHEN cm.report_id IS NOT NULL THEN 'report:' || cm.report_id::text WHEN cm.cleanup_id IS NOT NULL THEN 'event:' || cm.cleanup_id::text ELSE NULL END FROM chat_messages cm WHERE cm.id = moderation_items.subject_id LIMIT 1 ) WHEN subject_type = 'photo' THEN ( SELECT CASE WHEN COALESCE(ma.report_id, cm.report_id) IS NOT NULL THEN 'report:' || COALESCE(ma.report_id, cm.report_id)::text WHEN cm.cleanup_id IS NOT NULL THEN 'event:' || cm.cleanup_id::text ELSE NULL END FROM media_assets ma LEFT JOIN chat_messages cm ON cm.id = ma.chat_message_id WHERE ma.id = moderation_items.subject_id LIMIT 1 ) ELSE NULL END AS destination_ref FROM moderation_items WHERE id = $1 LIMIT 1 -- ["id-1"]
=> {"id":"id-row","kind":"kind-row","subjectType":"subject_type-row","subjectId":"subject_id-row","destinationKind":null,"destinationId":null,"flag":"flag-row","reason":"reason-row","category":null,"place":"place-row","priority":"priority-row","autoAction":"auto_action-row","reporter":null,"reporterId":null,"desc":null,"status":"status-row","signals":[],"similar":[],"user":null,"media":[],"createdAt":"2026-03-04T05:06:07.000Z"}"
`;

