exports[`sql transcripts > makeDrizzlePostRepository.like 1`] = `
"-- empty
BEGIN tx1
[tx1] INSERT INTO post_likes (post_id, user_id) VALUES ($1, $2) ON CONFLICT (post_id, user_id) DO NOTHING RETURNING post_id -- ["postId-1","userId-1"]
COMMIT tx1
=> false
-- row
BEGIN tx1
[tx1] INSERT INTO post_likes (post_id, user_id) VALUES ($1, $2) ON CONFLICT (post_id, user_id) DO NOTHING RETURNING post_id -- ["postId-1","userId-1"]
[tx1] UPDATE posts SET like_count = like_count + 1 WHERE id = $1 -- ["postId-1"]
COMMIT tx1
=> true"
`;

