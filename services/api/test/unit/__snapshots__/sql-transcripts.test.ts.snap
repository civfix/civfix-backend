[tx1] UPDATE users SET follower_count = follower_count + CASE WHEN id = $1 THEN 1 ELSE 0 END, following_count = following_count + CASE WHEN id = $2 THEN 1 ELSE 0 END WHERE id IN ($3, $4) -- ["followeeId-1","followerId-1","followerId-1","followeeId-1"]
COMMIT tx1
=> {"exists":true,"created":true}"
`;

