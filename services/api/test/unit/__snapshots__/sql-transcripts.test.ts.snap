=> null
-- row
SELECT o.id, o.slug, o.name, o.description, o.website_url, o.donation_url, o.logo_media_id, COALESCE(<helper ["am"]>.served_key, CASE WHEN <helper ["am"]>.status = 'validating' THEN <helper ["am"]>.r2_key END) AS logo_key, o.social_links, o.verified_status, o.verified_kind, o.verified_at, o.created_by, o.created_at, o.updated_at, o.deleted_at, o.suspended_at, o.suspended_reason, (SELECT count(*)::int FROM organization_members om WHERE om.organization_id = o.id) AS member_count, ( SELECT count(*)::int FROM cleanups c WHERE c.organization_id = o.id AND ( (c.visibility = 'public' AND c.status <> 'cancelled') OR EXISTS ( SELECT 1 FROM organization_members vm WHERE vm.organization_id = o.id AND vm.user_id = $1::uuid ) ) ) AS event_count, ( SELECT om.role FROM organization_members om WHERE om.organization_id = o.id AND om.user_id = $2::uuid LIMIT 1 ) AS my_role FROM organizations o LEFT JOIN media_assets am ON am.id = o.logo_media_id WHERE o.id = $3 AND o.deleted_at IS NULL LIMIT 1 -- ["viewerId-1","viewerId-1","id-1"]
