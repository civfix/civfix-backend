exports[`sql transcripts > makeDrizzleAdminEventRepository.cancel 1`] = `
"-- empty
BEGIN tx1
[tx1] UPDATE cleanups SET status = 'cancelled' WHERE id = $1 AND status <> 'cancelled' RETURNING id -- ["id-1"]
[tx1] SELECT id FROM cleanups WHERE id = $1 LIMIT 1 -- ["id-1"]
COMMIT tx1
=> false
-- row
BEGIN tx1
[tx1] UPDATE cleanups SET status = 'cancelled' WHERE id = $1 AND status <> 'cancelled' RETURNING id -- ["id-1"]
[tx1] INSERT INTO cleanup_timeline (cleanup_id, kind, note, actor_id) VALUES ($1, 'cancel', $2, $3) -- ["id-1","note-1","actorId-1"]
[tx1] INSERT INTO audit_log (actor_id, action, target, meta) VALUES ($1, $2, $3, $4) RETURNING id -- ["actorId-1","event.cancelled","cleanup:id-1",{"<json>":{"note":"note-1"}}]
COMMIT tx1
=> true"
`;

exports[`sql transcripts > makeDrizzleAdminEventRepository.countByBucket 1`] = `
"-- empty
WITH candidates AS ( SELECT CASE WHEN c.status = 'cancelled' THEN 'cancelled' WHEN c.ends_at <= now() THEN 'completed' WHEN c.scheduled_at <= now() THEN 'in_progress' ELSE 'upcoming' END AS status, COALESCE(( SELECT ct.kind = 'flag' FROM cleanup_timeline ct WHERE ct.cleanup_id = c.id AND ct.kind IN ('flag', 'unflag') ORDER BY ct.created_at DESC, ct.id DESC LIMIT 1 ), false) AS flagged FROM cleanups c LEFT JOIN users u ON u.id = c.organizer_user_id WHERE true AND (c.title ILIKE $1 ESCAPE '\\' OR c.address ILIKE $2 ESCAPE '\\' OR u.display_name ILIKE $3 ESCAPE '\\' OR u.handle::text ILIKE $4 ESCAPE '\\') ) SELECT COUNT(*)::text AS all, COUNT(*) FILTER (WHERE status = 'upcoming')::text AS upcoming, COUNT(*) FILTER (WHERE status = 'in_progress')::text AS in_progress, COUNT(*) FILTER (WHERE status = 'completed')::text AS completed, COUNT(*) FILTER (WHERE flagged)::text AS flagged FROM candidates -- ["%q-1%","%q-1%","%q-1%","%q-1%"]
=> {"all":0,"upcoming":0,"in_progress":0,"completed":0,"flagged":0}
-- row
WITH candidates AS ( SELECT CASE WHEN c.status = 'cancelled' THEN 'cancelled' WHEN c.ends_at <= now() THEN 'completed' WHEN c.scheduled_at <= now() THEN 'in_progress' ELSE 'upcoming' END AS status, COALESCE(( SELECT ct.kind = 'flag' FROM cleanup_timeline ct WHERE ct.cleanup_id = c.id AND ct.kind IN ('flag', 'unflag') ORDER BY ct.created_at DESC, ct.id DESC LIMIT 1 ), false) AS flagged FROM cleanups c LEFT JOIN users u ON u.id = c.organizer_user_id WHERE true AND (c.title ILIKE $1 ESCAPE '\\' OR c.address ILIKE $2 ESCAPE '\\' OR u.display_name ILIKE $3 ESCAPE '\\' OR u.handle::text ILIKE $4 ESCAPE '\\') ) SELECT COUNT(*)::text AS all, COUNT(*) FILTER (WHERE status = 'upcoming')::text AS upcoming, COUNT(*) FILTER (WHERE status = 'in_progress')::text AS in_progress, COUNT(*) FILTER (WHERE status = 'completed')::text AS completed, COUNT(*) FILTER (WHERE flagged)::text AS flagged FROM candidates -- ["%q-1%","%q-1%","%q-1%","%q-1%"]
=> {"all":null,"upcoming":null,"in_progress":null,"completed":null,"flagged":null}"
`;

