exports[`sql transcripts > makeDrizzlePostRepository.repost 1`] = `
"-- empty
BEGIN tx1
[tx1] SELECT id, kind, repost_of_id FROM posts WHERE id = $1 AND deleted_at IS NULL -- ["postId-1"]
COMMIT tx1
=> {"targetId":"postId-1","created":false}
-- row
BEGIN tx1
[tx1] SELECT id, kind, repost_of_id FROM posts WHERE id = $1 AND deleted_at IS NULL -- ["postId-1"]
[tx1] UPDATE posts SET deleted_at = NULL, updated_at = now() WHERE author_id = $1 AND kind = 'repost' AND repost_of_id = $2 AND deleted_at IS NOT NULL RETURNING id -- ["userId-1","id-row"]
[tx1] UPDATE posts SET repost_count = repost_count + 1 WHERE id = $1 -- ["id-row"]
COMMIT tx1
=> {"targetId":"id-row","created":true}"
`;

exports[`sql transcripts > makeDrizzlePostRepository.save 1`] = `
"-- empty
BEGIN tx1
[tx1] INSERT INTO post_saves (post_id, user_id) VALUES ($1, $2) ON CONFLICT (post_id, user_id) DO NOTHING RETURNING post_id -- ["postId-1","userId-1"]
COMMIT tx1
=> false
-- row
BEGIN tx1
[tx1] INSERT INTO post_saves (post_id, user_id) VALUES ($1, $2) ON CONFLICT (post_id, user_id) DO NOTHING RETURNING post_id -- ["postId-1","userId-1"]
[tx1] UPDATE posts SET save_count = save_count + 1 WHERE id = $1 -- ["postId-1"]
COMMIT tx1
=> true"
`;

exports[`sql transcripts > makeDrizzlePostRepository.softDeletePost 1`] = `
"-- empty
BEGIN tx1
[tx1] UPDATE posts SET deleted_at = now() WHERE id = $1 AND deleted_at IS NULL RETURNING kind, reply_to_id, repost_of_id -- ["postId-1"]
COMMIT tx1
=> undefined
-- row
BEGIN tx1
[tx1] UPDATE posts SET deleted_at = now() WHERE id = $1 AND deleted_at IS NULL RETURNING kind, reply_to_id, repost_of_id -- ["postId-1"]
[tx1] UPDATE posts SET reply_count = GREATEST(reply_count - 1, 0) WHERE id = $1 -- ["reply_to_id-row"]
COMMIT tx1
=> undefined"
`;

exports[`sql transcripts > makeDrizzlePostRepository.unlike 1`] = `
"-- empty
BEGIN tx1
[tx1] DELETE FROM post_likes WHERE post_id = $1 AND user_id = $2 RETURNING post_id -- ["postId-1","userId-1"]
COMMIT tx1
=> false
-- row
BEGIN tx1
[tx1] DELETE FROM post_likes WHERE post_id = $1 AND user_id = $2 RETURNING post_id -- ["postId-1","userId-1"]
[tx1] UPDATE posts SET like_count = GREATEST(like_count - 1, 0) WHERE id = $1 -- ["postId-1"]
COMMIT tx1
=> true"
`;

exports[`sql transcripts > makeDrizzlePostRepository.unrepost 1`] = `
"-- empty
BEGIN tx1
[tx1] SELECT id, kind, repost_of_id FROM posts WHERE id = $1 AND deleted_at IS NULL -- ["postId-1"]
COMMIT tx1
=> {"targetId":"postId-1","removed":false}
-- row
BEGIN tx1
[tx1] SELECT id, kind, repost_of_id FROM posts WHERE id = $1 AND deleted_at IS NULL -- ["postId-1"]
[tx1] UPDATE posts SET deleted_at = now() WHERE author_id = $1 AND kind = 'repost' AND repost_of_id = $2 AND deleted_at IS NULL RETURNING id -- ["userId-1","id-row"]
[tx1] UPDATE posts SET repost_count = GREATEST(repost_count - 1, 0) WHERE id = $1 -- ["id-row"]
COMMIT tx1
=> {"targetId":"id-row","removed":true}"
`;

exports[`sql transcripts > makeDrizzlePostRepository.unsave 1`] = `
