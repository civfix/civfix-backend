exports[`sql transcripts > makeDrizzleMetricsRepository.recomputeFromSource 1`] = `
"-- empty
SELECT to_char((r.registered_at AT TIME ZONE $1)::date, 'YYYY-MM-DD') AS day, 'registrations' AS metric, '' AS bucket, count(*)::text AS n FROM cleanup_registrations r WHERE r.cleanup_id = $2 AND r.registered_at >= $3 GROUP BY 1 UNION ALL SELECT to_char((r.cancelled_at AT TIME ZONE $4)::date, 'YYYY-MM-DD'), 'cancellations', '', count(*)::text FROM cleanup_registrations r WHERE r.cleanup_id = $5 AND r.cancelled_at IS NOT NULL AND r.cancelled_at >= $6 GROUP BY 1 UNION ALL SELECT to_char((s.checked_in_at AT TIME ZONE $7)::date, 'YYYY-MM-DD'), 'checkins', '', count(*)::text FROM cleanup_registration_seats s WHERE s.cleanup_id = $8 AND s.checked_in_at IS NOT NULL AND s.checked_in_at >= $9 GROUP BY 1 UNION ALL SELECT to_char((s.no_show_at AT TIME ZONE $10)::date, 'YYYY-MM-DD'), 'no_shows', '', count(*)::text FROM cleanup_registration_seats s WHERE s.cleanup_id = $11 AND s.no_show_at IS NOT NULL AND s.no_show_at >= $12 GROUP BY 1 UNION ALL SELECT to_char((w.created_at AT TIME ZONE $13)::date, 'YYYY-MM-DD'), 'waitlist_joined', '', count(*)::text FROM cleanup_waitlist w WHERE w.cleanup_id = $14 AND w.created_at >= $15 GROUP BY 1 UNION ALL SELECT to_char((b.finished_at AT TIME ZONE $16)::date, 'YYYY-MM-DD'), 'broadcast_recipients', '', sum(b.recipient_count)::text FROM broadcasts b WHERE b.cleanup_id = $17 AND b.finished_at IS NOT NULL AND b.finished_at >= $18 GROUP BY 1 UNION ALL SELECT to_char((d.created_at AT TIME ZONE $19)::date, 'YYYY-MM-DD'), 'broadcast_' || d.status, d.channel, count(*)::text FROM broadcast_deliveries d JOIN broadcasts b ON b.id = d.broadcast_id WHERE b.cleanup_id = $20 AND d.created_at >= $21 AND d.status IN ('sent','failed','suppressed') GROUP BY 1, 2, 3 UNION ALL SELECT to_char((bu.created_at AT TIME ZONE $22)::date, 'YYYY-MM-DD'), 'unsubscribes', '', count(*)::text FROM broadcast_unsubscribes bu WHERE bu.cleanup_id = $23 AND bu.created_at >= $24 GROUP BY 1 -- ["timezone-1","cleanupId-1","2026-03-04T05:06:07.000Z","timezone-1","cleanupId-1","2026-03-04T05:06:07.000Z","timezone-1","cleanupId-1","2026-03-04T05:06:07.000Z","timezone-1","cleanupId-1","2026-03-04T05:06:07.000Z","timezone-1","cleanupId-1","2026-03-04T05:06:07.000Z","timezone-1","cleanupId-1","2026-03-04T05:06:07.000Z","timezone-1","cleanupId-1","2026-03-04T05:06:07.000Z","timezone-1","cleanupId-1","2026-03-04T05:06:07.000Z"]
=> []
-- row
SELECT to_char((r.registered_at AT TIME ZONE $1)::date, 'YYYY-MM-DD') AS day, 'registrations' AS metric, '' AS bucket, count(*)::text AS n FROM cleanup_registrations r WHERE r.cleanup_id = $2 AND r.registered_at >= $3 GROUP BY 1 UNION ALL SELECT to_char((r.cancelled_at AT TIME ZONE $4)::date, 'YYYY-MM-DD'), 'cancellations', '', count(*)::text FROM cleanup_registrations r WHERE r.cleanup_id = $5 AND r.cancelled_at IS NOT NULL AND r.cancelled_at >= $6 GROUP BY 1 UNION ALL SELECT to_char((s.checked_in_at AT TIME ZONE $7)::date, 'YYYY-MM-DD'), 'checkins', '', count(*)::text FROM cleanup_registration_seats s WHERE s.cleanup_id = $8 AND s.checked_in_at IS NOT NULL AND s.checked_in_at >= $9 GROUP BY 1 UNION ALL SELECT to_char((s.no_show_at AT TIME ZONE $10)::date, 'YYYY-MM-DD'), 'no_shows', '', count(*)::text FROM cleanup_registration_seats s WHERE s.cleanup_id = $11 AND s.no_show_at IS NOT NULL AND s.no_show_at >= $12 GROUP BY 1 UNION ALL SELECT to_char((w.created_at AT TIME ZONE $13)::date, 'YYYY-MM-DD'), 'waitlist_joined', '', count(*)::text FROM cleanup_waitlist w WHERE w.cleanup_id = $14 AND w.created_at >= $15 GROUP BY 1 UNION ALL SELECT to_char((b.finished_at AT TIME ZONE $16)::date, 'YYYY-MM-DD'), 'broadcast_recipients', '', sum(b.recipient_count)::text FROM broadcasts b WHERE b.cleanup_id = $17 AND b.finished_at IS NOT NULL AND b.finished_at >= $18 GROUP BY 1 UNION ALL SELECT to_char((d.created_at AT TIME ZONE $19)::date, 'YYYY-MM-DD'), 'broadcast_' || d.status, d.channel, count(*)::text FROM broadcast_deliveries d JOIN broadcasts b ON b.id = d.broadcast_id WHERE b.cleanup_id = $20 AND d.created_at >= $21 AND d.status IN ('sent','failed','suppressed') GROUP BY 1, 2, 3 UNION ALL SELECT to_char((bu.created_at AT TIME ZONE $22)::date, 'YYYY-MM-DD'), 'unsubscribes', '', count(*)::text FROM broadcast_unsubscribes bu WHERE bu.cleanup_id = $23 AND bu.created_at >= $24 GROUP BY 1 -- ["timezone-1","cleanupId-1","2026-03-04T05:06:07.000Z","timezone-1","cleanupId-1","2026-03-04T05:06:07.000Z","timezone-1","cleanupId-1","2026-03-04T05:06:07.000Z","timezone-1","cleanupId-1","2026-03-04T05:06:07.000Z","timezone-1","cleanupId-1","2026-03-04T05:06:07.000Z","timezone-1","cleanupId-1","2026-03-04T05:06:07.000Z","timezone-1","cleanupId-1","2026-03-04T05:06:07.000Z","timezone-1","cleanupId-1","2026-03-04T05:06:07.000Z"]
=> [{"cleanupId":"cleanupId-1","day":"day-row","metric":"metric-row","bucket":"bucket-row","value":2}]"
`;

