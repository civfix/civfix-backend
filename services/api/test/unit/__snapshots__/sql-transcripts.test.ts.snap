exports[`sql transcripts > sendFailedExpr 1`] = `
"-- empty
NOT EXISTS ( SELECT 1 FROM mail_events e WHERE e.thread_id = TRUE /* threadRef */ AND e.type = 'sent' ) AND COALESCE( ( SELECT CASE WHEN EXISTS ( SELECT 1 FROM mail_events e WHERE e.thread_id = TRUE /* threadRef */ AND e.message_id = latest.id::text AND e.type = $1 AND COALESCE(e.meta->>'reason', '') <> 'deadline' ) THEN true WHEN EXISTS ( SELECT 1 FROM mail_events e WHERE e.thread_id = TRUE /* threadRef */ AND e.message_id = latest.id::text AND e.type = $2 AND e.meta->>'reason' = 'deadline' AND e.created_at > now() - make_interval(secs => $3) ) THEN false WHEN EXISTS ( SELECT 1 FROM mail_events e WHERE e.thread_id = TRUE /* threadRef */ AND e.message_id = latest.id::text AND e.type = $4 ) THEN true ELSE latest.created_at < now() - make_interval(secs => $5) END FROM ( SELECT m.id, m.created_at FROM mail_messages m WHERE m.thread_id = TRUE /* threadRef */ AND m.direction = 'out' ORDER BY m.created_at DESC, m.id DESC LIMIT 1 ) latest ), false ) -- ["failed","failed",900,"failed",900]
=> []
-- row
NOT EXISTS ( SELECT 1 FROM mail_events e WHERE e.thread_id = TRUE /* threadRef */ AND e.type = 'sent' ) AND COALESCE( ( SELECT CASE WHEN EXISTS ( SELECT 1 FROM mail_events e WHERE e.thread_id = TRUE /* threadRef */ AND e.message_id = latest.id::text AND e.type = $1 AND COALESCE(e.meta->>'reason', '') <> 'deadline' ) THEN true WHEN EXISTS ( SELECT 1 FROM mail_events e WHERE e.thread_id = TRUE /* threadRef */ AND e.message_id = latest.id::text AND e.type = $2 AND e.meta->>'reason' = 'deadline' AND e.created_at > now() - make_interval(secs => $3) ) THEN false WHEN EXISTS ( SELECT 1 FROM mail_events e WHERE e.thread_id = TRUE /* threadRef */ AND e.message_id = latest.id::text AND e.type = $4 ) THEN true ELSE latest.created_at < now() - make_interval(secs => $5) END FROM ( SELECT m.id, m.created_at FROM mail_messages m WHERE m.thread_id = TRUE /* threadRef */ AND m.direction = 'out' ORDER BY m.created_at DESC, m.id DESC LIMIT 1 ) latest ), false ) -- ["failed","failed",900,"failed",900]
=> [{}]"
`;

