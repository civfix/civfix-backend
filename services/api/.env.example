# civfix API environment (machine reference).
# Markers: [BOOT] required to boot in production; [OPT] optional / feature-gated.
# "bypassed by USE_FAKE_*" means the [BOOT] requirement is lifted when that fake flag is on.
# Outside production, signing keys get insecure dev defaults and every USE_FAKE_* defaults to true,
# so the server boots offline with this file left mostly empty.
# Copy to .env (gitignored) and fill real values for production.
#
# NODE_ENV: this template ships `development` for LOCAL use (offline boot). In a real DEPLOYMENT do NOT
# rely on this line — the production image (Dockerfile) and the civfix-infra compose force
# NODE_ENV=production (compose `environment` overrides this env_file). Leaving a deployed secrets file at
# `development` would otherwise disable the auth bundle and 404 every /auth/* and /admin/* route.

# ===== core [BOOT] =====
NODE_ENV=development                       # [BOOT] development | test | production (deploys force =production; see header)
PORT=8080                                  # [BOOT] HTTP listen port (default 8080)
PUBLIC_API_URL=http://localhost:8080       # [BOOT] externally reachable base URL of this API
WEB_ORIGINS=http://localhost:5173          # [BOOT] allowlist (comma-separated origins) for BOTH CORS and the
                                           #        GET /ws upgrade Origin check (anti-CSWSH). Empty = allow all (dev).
DATABASE_URL=                              # [BOOT] postgres://user:pass@host:5432/civfix (PostGIS)
                                           #        PRODUCTION MUST append ?sslmode=require (or verify-ca /
                                           #        verify-full) FOR ANY HOST THAT CROSSES A WIRE:
                                           #        postgres.js defaults to ssl:false, so a URL without
                                           #        sslmode ships credentials and rows in CLEARTEXT, and
                                           #        boot fails in production without a TLS sslmode.
                                           #        EXEMPT: a host the packets cannot leave the machine to
                                           #        reach — localhost, 127.x, ::1, or a single-label compose
                                           #        alias like `postgres`. The deployed stack reaches
                                           #        Postgres over the private bridge and the image carries NO
                                           #        server certificate, so requiring TLS there would not
                                           #        encrypt the link, only refuse the connection. Dotted
                                           #        names and RFC1918 ADDRESSES are NOT exempt.
                                           #        To require TLS everywhere: give postgres a cert, set
                                           #        `ssl=on`, then append sslmode=require here (no code change).
REDIS_URL=                                 # [BOOT] redis://:PASSWORD@host:6379 (the compose redis sets
                                           #        requirepass; embed the SAME value as REDIS_PASSWORD)
SESSION_SIGNING_KEY=                       # [BOOT] HMAC key for session cookies (dev default off-prod)
ANON_TOKEN_SIGNING_KEY=                    # [BOOT] HMAC key for anon tokens (dev default off-prod)
SHUTDOWN_DRAIN_MS=                         # [OPT] SIGTERM drain window in ms. Default 0 = NO drain, in every
                                           #        environment. When set, SIGTERM makes GET /healthz answer 503 +
                                           #        `x-civfix-draining: 1` and the process keeps serving for this long
                                           #        before closing the server, so the blue/green load balancer (Caddy
                                           #        active health check, health_interval 2s / health_timeout 1s once
                                           #        the paired civfix-infra change lands =
                                           #        demoted within ~4s) pulls this api color out of the pool with no
                                           #        dropped in-flight request. Clamped to 0..10000 by the loader AND
                                           #        by makeShutdown: the drain is SERIAL with the 15s in-flight close
                                           #        wait (the requestTimeout) and the 15s teardown watchdog, and the
                                           #        whole shutdown must fit inside the container stop_grace_period or
                                           #        Docker SIGKILLs the process mid-teardown - which is worse than not
                                           #        draining at all. 10 + 15 + 15 = 40s, 5s inside the 45s grace. That
                                           #        is why it defaults OFF here: the deployed value is set in the
                                           #        civfix-infra compose api service `environment:` block, on the same
                                           #        service that carries `stop_grace_period: 45s`, so the two can never
                                           #        land in different deploys. The value this release expects there is
                                           #        8000 (paired civfix-infra change); a larger configured value is
                                           #        clamped to the ceiling and logged as a warning.

# ===== storage: R2 - MEDIA ONLY (report photos/videos; bypassed by USE_FAKE_STORAGE) =====
# R2 is NOT used for map tiles: the map uses the OpenStreetMap (CARTO Voyager) raster basemap directly
# in the clients (see the map basemap section below).
R2_ACCOUNT_ID=                             # [BOOT] unless USE_FAKE_STORAGE - Cloudflare R2 account id
R2_ACCESS_KEY_ID=                          # [BOOT] unless USE_FAKE_STORAGE - R2 access key id
R2_SECRET_ACCESS_KEY=                      # [BOOT] unless USE_FAKE_STORAGE - R2 secret access key
R2_BUCKET=                                 # [BOOT] unless USE_FAKE_STORAGE - R2 bucket name (media)
# SECURITY (H10): raw inbound email (.eml + every attachment) is private citizen<->city correspondence and
# must NEVER share a bucket with CDN-published media. R2_INBOUND_BUCKET is [OPT] only while R2_PUBLIC_BASE
# is empty; set a public base and it becomes [BOOT] and must NAME A DIFFERENT BUCKET than R2_BUCKET.
# The boot loader enforces both rules; the API refuses to start otherwise.
R2_INBOUND_BUCKET=                         # [BOOT] when R2_PUBLIC_BASE is set (else [OPT]) - dedicated, NON-public R2 bucket for the inbound-mail buffer (the Email Worker binds THIS bucket); must differ from R2_BUCKET
R2_PUBLIC_BASE=                            # [OPT] public base URL for media objects (CDN/custom domain)

# ===== storage: LOCAL DISK - DEVELOPMENT ONLY =====
# Set LOCAL_STORAGE_DIR and the API replaces BOTH R2 and the in-memory fake with a filesystem object
# store, and mounts PUT/GET routes under /_local-storage. Presigned URLs then become real, HMAC-signed
# HTTP URLs a browser can actually PUT to and render from, so the whole report-photo -> finalize ->
# media.checks -> media-worker pipeline runs with no cloud credentials. Requires PUBLIC_API_URL to be the
# URL the browser (and the worker) reach this API on. Give the media-worker the SAME LOCAL_STORAGE_DIR.
# The path MUST be ABSOLUTE and byte-for-byte identical in both services: the API and the media-worker run
# from different working directories, so a relative path resolves to two divergent trees (the worker writes
# thumbnails the API then 404s). The adapter rejects a non-absolute value at construction.
# Refused at boot in production - both by the env loader and by the adapter itself.
LOCAL_STORAGE_DIR=                         # [OPT] dev-only: ABSOLUTE directory for the local-disk object store (e.g. /home/you/civfix/.local-storage)
LOCAL_STORAGE_SIGNING_KEY=                 # [OPT] dev-only: HMAC key for local presigned URLs (defaults to a known dev constant)

# ===== map basemap (all [OPT]) =====
# The map uses the OpenStreetMap (CARTO Voyager) RASTER basemap directly in the clients; the platform
# does NOT host its own tiles. The clients hardcode the CARTO Voyager raster and need no tile config.
# These vars only tune what GET /map/tileinfo advertises (it never 500s on missing config).
TILES_RASTER_URL=                          # [OPT] OVERRIDE the default OSM/CARTO Voyager raster XYZ template
                                           #       (default https://a.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png)
TILES_MIN_ZOOM=                            # [OPT] min zoom advertised by tileinfo (default 1)
TILES_MAX_ZOOM=                            # [OPT] max zoom advertised by tileinfo (default 19)
TILES_BOUNDS=                              # [OPT] map bounds "west,south,east,north" (default -125,24,-66,50)

# ===== mailer: OCI SMTP (bypassed by USE_FAKE_MAILER) =====
OCI_EMAIL_SMTP_HOST=                       # [BOOT] unless USE_FAKE_MAILER - OCI Email Delivery SMTP host
OCI_EMAIL_SMTP_PORT=587                    # [BOOT] unless USE_FAKE_MAILER - SMTP port (default 587)
OCI_EMAIL_SMTP_USER=                       # [BOOT] unless USE_FAKE_MAILER - SMTP username
OCI_EMAIL_SMTP_PASS=                       # [BOOT] unless USE_FAKE_MAILER - SMTP password
OCI_EMAIL_SMTP_TIMEOUT_MS=15000            # [OPT] connect/greeting/socket timeout per SMTP send (default 15000)
OUTBOUND_SEND_MIN_THROUGHPUT_BPS=262144    # [OPT] >=1024. Floor throughput sizing the total send deadline (default 262144 = 256 KiB/s).
                                           #       With OCI_EMAIL_SMTP_TIMEOUT_MS (<=60000) it must keep the largest
                                           #       packet inside the 900s in-flight guard or boot fails.
                                           #       See docs/inbound-mail-effects.md "The outbound send triad".
VOLUNTEER_HOURS_WEEKLY_FLAG_HOURS=60       # [OPT] rolling 7-day credited-hours threshold that files a moderation item; never blocks (default 60)

# --- Outbound SMS (SmsSender seam; guest event RSVP) -------------------------------------------------
TWILIO_ACCOUNT_SID=                        # [BOOT] only when SMS_GUEST_ENABLED=true and USE_FAKE_SMS is off - Twilio account SID (ACxxxx)
TWILIO_AUTH_TOKEN=                         # [BOOT] only when SMS_GUEST_ENABLED=true and USE_FAKE_SMS is off - Twilio auth token (SECRET)
TWILIO_SMS_FROM=                           # [BOOT] only when SMS_GUEST_ENABLED=true and USE_FAKE_SMS is off - E.164 sending number, e.g. +15551234567
SMS_GUEST_ENABLED=                         # [OPT] 1/true offers the SMS guest-RSVP channel (default FALSE everywhere; each send costs money)
SMS_DAILY_CAP=50                           # [OPT] global cap on EVERY outbound guest text per UTC day (verification code, RSVP confirmation, event update/cancellation fan-out); FAILS CLOSED at the cap and when Redis is down (default 50)
MAIL_FROM_NOREPLY=no-reply@civfix.org      # [OPT] From for transactional mail / OTP (default no-reply@civfix.org)
MAIL_FROM_OUTREACH=outreach@civfix.org     # [OPT] canonical outreach identity (default outreach@civfix.org): the stored from_addr + 'sent' meta + the OUT Message-ID domain. NOTE: jurisdiction/outreach mail is now sent FROM the per-thread reply address {kind}-{token}@MAIL_REPLY_DOMAIN, not this address.
HOME_TURF_MAIL_FROM=donotreply@civfix.org  # [OPT] From for POST /forms/home-turf mail (notification + confirmation; default donotreply@civfix.org — covered by the @civfix.org approved-sender domain)
HOME_TURF_NOTIFY_TO=                       # [BOOT-if-used] recipient of the Home Turf coach-interest notification email. NO DEFAULT: unset DISABLES POST /forms/home-turf (409 CONFLICT, mails nobody, warned once at boot). Set it in the deployment secrets to enable the form.

# ===== admin / operator dashboard (Phase 2) [OPT] =====
# All four have safe defaults, so none is required at boot. ADMIN_EMAILS gates operator login.
ADMIN_EMAILS=                              # [OPT] comma list of operator login emails (normalized lowercase). EMPTY = no one can log in to admin.
MAIL_REPLY_DOMAIN=civfix.org               # [OPT] domain for the per-thread reply address {kind}-{token}@{domain} that outreach mail is sent FROM (a reply routes back via the catch-all inbound Worker). Must be an OCI approved DOMAIN. Default civfix.org.
OUTREACH_THROTTLE_DAYS=7                    # [OPT] at most one outreach / jurisdiction / this many days (default 7)
OUTREACH_DIGEST_CRON=0 14 * * *            # [OPT] cron for the outreach.digest sweep (default "0 14 * * *", 14:00 daily)
INBOUND_SWEEP_CRON=*/5 * * * *             # [OPT] cron for the inbound.sweep (LISTs R2 inbound/pending/ to catch up missed email; default every 5 min)
GUEST_RETENTION_CRON=15 4 * * *             # [OPT] cron for guest.retention.sweep (scrubs guest contact 30d after an event, reaps guest_otps after 24h; default 04:15 daily)

# ----- admin auth: Cloudflare Access (Zero Trust) SSO (doc 16) [OPT] -----
# The /admin/auth/access/exchange route verifies the Cf-Access-Jwt-Assertion header injected by the
# path-scoped Access app on api.civfix.org/admin, then mints the operator session. It is ENABLED only when
# BOTH CF_ACCESS_TEAM_DOMAIN and CF_ACCESS_AUD are set; otherwise the POST exchange returns 503 (admin
# login is unavailable). ADMIN_EMAILS above remains the in-app authorization allowlist.
CF_ACCESS_TEAM_DOMAIN=                      # [OPT] team Access domain = JWT iss + JWKS base, e.g. https://civfix.cloudflareaccess.com
CF_ACCESS_AUD=                             # [OPT] Application Audience (AUD) tag of the api.civfix.org/admin Access app
CF_ACCESS_SERVICE_TOKENS=                   # [OPT] comma list of permitted service-token client IDs (common_name); reserved, not yet consumed

# ===== Cloudflare features [OPT] =====
CF_TURNSTILE_SECRET=                       # [OPT] Turnstile secret; disables captcha verify if absent
# L16 token binding: siteverify echoes the hostname the token was minted on. List the hostnames that may
# mint one (comma list, case-insensitive; the web origins WITHOUT scheme — e.g. civfix.org,www.civfix.org)
# and a token minted on any other page using our sitekey is rejected even when Cloudflare says success.
# Leave EMPTY to skip the assertion (logs a one-time notice at boot; the captcha itself still verifies).
CF_TURNSTILE_HOSTNAMES=                     # [OPT] comma list of hostnames a Turnstile token may come from; empty = not asserted
CF_EMAIL_WEBHOOK_SECRET=                   # [OPT] HMAC key for the Cloudflare inbound-mail webhook (x-cf-signature over the JSON body); same value in the Email Worker; unset CLOSES the webhook
CF_API_TOKEN=                              # [OPT] Cloudflare API token for automation

# ===== Geocoding [OPT] =====
MAPBOX_TOKEN=                              # [OPT] Mapbox server token; reverse geocoding falls back to Photon if absent

# ===== Apple OAuth (Sign in with Apple) [OPT] =====
# CLIENT_ID is the NATIVE app bundle id (e.g. org.civfix.community) — the `aud` of the native iOS id_token.
# The WEB Services ID (org.civfix.web) is configured SEPARATELY as APPLE_OAUTH_WEB_CLIENT_ID below.
APPLE_OAUTH_CLIENT_ID=                     # [OPT] native app bundle id (e.g. org.civfix.community)
APPLE_OAUTH_TEAM_ID=                       # [OPT] Apple developer team id
APPLE_OAUTH_KEY_ID=                        # [OPT] key id for the Apple private key
APPLE_OAUTH_PRIVATE_KEY=                   # [OPT] PEM private key (.p8 contents)
# The WEB Services ID (e.g. org.civfix.web). When set, the browser Sign in with Apple redirect flow lights
# up and is the audience the WEB id_token is verified against. Unset => only native/mobile Apple works.
APPLE_OAUTH_WEB_CLIENT_ID=                 # [OPT] web Services ID (e.g. org.civfix.web)
# Extra accepted audience for the native id_token. Set to the bundle id so native Apple sign-in verifies
# even if CLIENT_ID above is (mis)configured to the web Services ID. Mirrors GOOGLE_OAUTH_IOS_CLIENT_ID.
APPLE_OAUTH_IOS_CLIENT_ID=                 # [OPT] native bundle id audience (e.g. org.civfix.community)

# ===== Google OAuth [OPT] =====
# The WEB OAuth client (id + secret) drives the browser redirect flow (/auth/google/start + /callback)
# and is the primary accepted ID-token audience. REDIRECT_URI is the backend callback Google redirects
# to and MUST be registered on the web client in Google Cloud Console, e.g.
#   https://api.civfix.org/auth/google/callback
GOOGLE_OAUTH_CLIENT_ID=                    # [OPT] WEB OAuth client id
GOOGLE_OAUTH_CLIENT_SECRET=                # [OPT] WEB OAuth client secret
GOOGLE_OAUTH_REDIRECT_URI=                 # [OPT] backend callback URL (registered on the web client)
# Native mobile sign-in uses SEPARATE per-platform OAuth clients. The native SDK can mint an ID token
# whose `aud` is the iOS or Android client id, so set these so the backend accepts those tokens too.
GOOGLE_OAUTH_IOS_CLIENT_ID=                # [OPT] iOS OAuth client id (bundle org.civfix.community)
GOOGLE_OAUTH_ANDROID_CLIENT_ID=           # [OPT] Android OAuth client id (package + SHA-1)

# Require a server-minted single-use nonce on NATIVE Google/Apple sign-in (POST /v1/auth/oauth/nonce ->
# POST /v1/auth/{google,apple} with `nonce`). With it OFF, a captured id_token can be replayed for the
# rest of its (short) validity; with it ON, native sign-in from a client that does not request a nonce
# FAILS with a 422. DEFAULT: false, and it must stay false until a shipped mobile build sends one —
# as of 2026-09 apps/community-mobile/src/components/AuthOptions.tsx calls signInWithApple/
# signInWithGoogle with no nonce, so flipping this on would break every store build in the wild.
# Flip to true (prod first) once a nonce-sending mobile release has aged out the old ones.
OAUTH_REQUIRE_NONCE=                       # [OPT] default false; see above before enabling

# ===== push: APNs (bypassed by USE_FAKE_PUSH) [OPT] =====
APNS_KEY_ID=                               # [OPT] APNs auth key id
APNS_TEAM_ID=                              # [OPT] Apple team id for APNs
APNS_PRIVATE_KEY=                          # [OPT] APNs .p8 private key contents
APNS_BUNDLE_ID=                            # [OPT] iOS app bundle id (apns topic)
APNS_PRODUCTION=                           # [OPT] 1/true to use the production APNs gateway

# ===== push: FCM (bypassed by USE_FAKE_PUSH) [OPT] =====
FCM_SERVICE_ACCOUNT_JSON=                  # [OPT] Firebase service account JSON (string)
FCM_PROJECT_ID=                            # [OPT] Firebase project id

# ===== push: Web Push / VAPID (bypassed by USE_FAKE_PUSH) [OPT] =====
VAPID_PUBLIC_KEY=                          # [OPT] VAPID public key
VAPID_PRIVATE_KEY=                         # [OPT] VAPID private key
VAPID_SUBJECT=                             # [OPT] VAPID subject (mailto: or https URL)

# ===== error reporting: GlitchTip [OPT] =====
GLITCHTIP_DSN=                             # [OPT] Sentry-compatible DSN; reporting is no-op if absent
GLITCHTIP_DATABASE_URL=                    # [OPT] separate DB URL for a self-hosted GlitchTip

# ===== reviewer-OTP bypass (App Review) - AN AUTHENTICATION BYPASS =====
# When on, the fixed reviewer address signs in with REVIEWER_OTP_CODE and NO email is sent, creating a real
# session. It defaults OFF in every environment. Turning it on in PRODUCTION additionally requires BOTH
# REVIEWER_OTP_BYPASS_ACK=true and a REVIEWER_OTP_CODE of >= 20 chars, or the API refuses to boot.
# Treat REVIEWER_OTP_CODE as a password: generate it per review submission (`openssl rand -hex 24`), and
# set REVIEWER_OTP_BYPASS back to empty/false the moment the review is done.
REVIEWER_OTP_BYPASS=                       # [OPT] 1/true to enable the reviewer sign-in bypass (default FALSE)
REVIEWER_OTP_BYPASS_ACK=                   # [OPT] 1/true - required second opt-in to run the bypass in production
REVIEWER_OTP_CODE=                         # [OPT] the reviewer's sign-in secret (>= 20 chars, no default; rotate per review)

# ===== proxy trust =====
TRUST_PROXY=                               # [OPT] unset = trust only loopback/RFC1918 upstreams (safe default).
                                           #       A CIDR list is also accepted; a bare number is IGNORED
                                           #       (falls back to the safe default) — Fastify 5.12.1 removed
                                           #       hop-count trust.
                                           #       `true` is REJECTED at boot in production: it would trust any
                                           #       client-supplied X-Forwarded-For and defeat every per-IP control.

# ===== seam fake flags (default true off-prod, false in production) =====
# EVERY flag in this block is REFUSED AT BOOT when NODE_ENV=production (env.ts FAKE_SEAM_FLAGS): a fake
# seam is a functional no-op that never errors and still reports /readyz 200, so it is a silent outage.
# Adding a new USE_FAKE_* flag means adding it to FAKE_SEAM_FLAGS, which parses AND refuses it.
USE_FAKE_STORAGE=                          # [OPT] 1/true to use in-memory storage instead of R2
USE_FAKE_MAILER=                           # [OPT] 1/true to use the no-op mailer instead of SMTP
USE_FAKE_PUSH=                             # [OPT] 1/true to use the in-memory push sender
USE_FAKE_ABUSE_NSFW=                       # [OPT] 1/true to use fake abuse checks (incl. NSFW)
USE_FAKE_CHAT=                             # [OPT] 1/true to use the in-process chat service
USE_FAKE_JOBS=                             # [OPT] 1/true to use the in-memory jobs queue instead of pg-boss
USE_FAKE_USER_CHANNEL=                     # [OPT] 1/true to use the in-memory per-user signal channel instead of Redis
USE_FAKE_GEOCODER=                         # [OPT] 1/true for the constant "Los Angeles, CA" label; false uses the credential-free TigerGeocoder (needs DATABASE_URL + seeded jurisdictions)
USE_FAKE_PAYMENTS=                         # [OPT] 1/true for the in-memory FakePayments seam. Refused in production: donations would be accepted against a fake, no charge would reach the organization, no receipt would be real, and the money a donor believes they gave would never exist. PAYMENTS_ENABLED=false wins over it — that runs DisabledPayments, which refuses every call
USE_FAKE_SMS=                              # [OPT] 1/true for the in-memory FakeSmsSender (default ON outside production). To run production WITHOUT SMS set SMS_GUEST_ENABLED=false; the fake is refused in production because it swallows guest OTPs while auth.routes still advertises SMS as available

# ===== event host platform: registration + check-in (W1) =====
# Signs event ticket tokens (base32(HMAC-SHA256(secret, seatId))[0:16]). Rotating it invalidates every
# outstanding QR: incident-only, and DIFFERENT per environment (a shared secret would let a staging
# ticket check in at a prod door).
TICKET_TOKEN_SECRET=                       # [BOOT] in production, min 32 chars - signs every event ticket
WAITLIST_EXPIRE_CRON=                      # [OPT] default */10 * * * * - releases expired waitlist offers and re-runs the promoter
CHECKIN_NOSHOW_CRON=                       # [OPT] default */30 * * * * - marks unscanned seats no-show 2h after a finished event ends

# ===== event host platform: communications, analytics, exports (W2) =====
MAIL_FROM_EVENTS=                          # [OPT] default events@civfix.org - From on every host broadcast. NEEDS AN OCI APPROVED SENDER before any real send
UNSUBSCRIBE_SIGNING_KEY=                   # [BOOT] in production, min 32 chars, MUST differ from SESSION_SIGNING_KEY and ANON_TOKEN_SIGNING_KEY - signs the one-click unsubscribe capability carried in every broadcast email
BROADCAST_SWEEP_CRON=                      # [OPT] default */2 * * * *
EVENT_REMINDERS_CRON=                      # [OPT] default */10 * * * *
METRICS_ROLLUP_CRON=                       # [OPT] default 7 * * * *
HOST_RETENTION_CRON=                       # [OPT] default 35 4 * * *
HOST_EXPORT_REAP_CRON=                     # [OPT] default 40 * * * *
HOST_BROADCAST_PER_EVENT_PER_DAY=          # [OPT] default 3
HOST_BROADCAST_RECIPIENTS_PER_DAY=         # [OPT] default 2000 - set to 25 on staging, which shares the prod SMTP relay
HOST_BROADCAST_COOLDOWN_SEC=               # [OPT] default 900
HOST_BROADCAST_MIN_ACCOUNT_AGE_HOURS=      # [OPT] default 24 - 0 = no delay (honoured; staging runs 0). Every other cap below
                                           #       has min 1, so a 0 or negative value there is a BOOT ERROR, not a silent default
HOST_EVENT_UPDATE_PER_EVENT_PER_HOUR=      # [OPT] default 3 - per-event throttle on the automated event_updated lane. That lane is
                                           #       CRITICAL (it reaches people who unsubscribed), so an edit loop must not re-mail them
BROADCAST_MAX_RECIPIENTS=                  # [OPT] default 5000
BROADCAST_CHUNK_SIZE=                      # [OPT] default 200
BROADCAST_EMAIL_CONCURRENCY=               # [OPT] default 4
BROADCAST_EMAIL_RATE_PER_SEC=              # [OPT] default 10
BROADCAST_LINK_ALLOWED_HOSTS=              # [OPT] csv, lowercased; empty = any https host
HOST_MESSAGING_KILL_SWITCH=                # [OPT] default false - global brake on every host-composed send
HOST_ANALYTICS_CACHE_TTL_SEC=              # [OPT] default 120
PAGE_VIEW_DEDUPE_SEC=                      # [OPT] default 0 = OFF = the view counter touches NO identifier at all. Turning it on is a PRIVACY DECISION (a short-lived hash guard), capped at 3600
METRICS_ROLLUP_LOOKBACK_DAYS=              # [OPT] default 3
HOST_EXPORT_MAX_ROWS=                      # [OPT] default 50000
HOST_EXPORT_TTL_HOURS=                     # [OPT] default 24 - how long an export OBJECT lives before host.export.reap deletes it
SMS_HOST_BROADCAST_ENABLED=                # [OPT] default false - the sms chunk arm is NOT built; enabling it also needs 10DLC filing, Twilio secrets, an inbound STOP webhook and consent copy

# ===== donations (W4) =====
# Master brake. While false: no donation route, no webhook path, and the Payments seam is
# DisabledPayments (every method throws PAYMENT_UNAVAILABLE).
PAYMENTS_ENABLED=false                     # [OPT] default false
STRIPE_SECRET_KEY_PAYMENTS=                # [BOOT] when PAYMENTS_ENABLED and not USE_FAKE_PAYMENTS - ONE restricted key (rk_...) scoped to payments + connect. An sk_ is refused at boot
STRIPE_WEBHOOK_SECRET_CONNECT=             # [BOOT] same condition - accepts a comma list so a secret roll can overlap
STRIPE_WEBHOOK_SECRET_PLATFORM=            # [BOOT] same condition - MUST differ from the connect secret
STRIPE_API_VERSION=                        # [OPT] default 2026-08-26.dahlia
DONATION_PLATFORM_FEE_BPS=                 # [OPT] default 500 = 5%. 0 omits the application_fee parameter entirely
DONATION_MIN_MINOR=                        # [OPT] default 500
DONATION_MAX_MINOR=                        # [OPT] default 1000000
DONATION_REFUND_APP_FEE=                   # [OPT] default true
DONATION_STATUS_TOKEN_KEY=                 # [BOOT] when PAYMENTS_ENABLED in production, min 32 chars, MUST differ from SESSION_SIGNING_KEY and ANON_TOKEN_SIGNING_KEY - the capability key a guest donor uses to read their own donation status
PAYMENT_METHOD_DOMAINS=                    # [OPT] csv, e.g. civfix.org - wallet domains registered per connected account
MAIL_FROM_RECEIPTS=                        # [OPT] default no-reply@civfix.org; receipts@civfix.org needs an OCI approved sender first
ELIGIBILITY_STALE_GRACE_HOURS=             # [OPT] default 72
CA_CFP_REGISTRATION_NUMBER=                # [OPT] the CA AG charitable-fundraising platform registration number published on the donate page
STRIPE_EVENTS_SWEEP_CRON=                  # [OPT] default */5 * * * *
PAYMENTS_RECONCILE_CRON=                   # [OPT] default 20 5 * * *
ELIGIBILITY_IRS_CRON=                      # [OPT] default 0 9 5 * *
ELIGIBILITY_FTB_CRON=                      # [OPT] default 30 9 5 * *
ELIGIBILITY_MNOS_CRON=                     # [OPT] default 0 17 * * 3
ELIGIBILITY_OFAC_CRON=                     # [OPT] default 0 10 5 * *
DONATION_RETENTION_CRON=                   # [OPT] default 50 4 * * *

# ===== media-worker only (services/media-worker; NOT read by the API process) =====
# Set on the media-worker container. The first four are [BOOT] in production - the worker refuses to
# start without them, because their absence is otherwise silent: decoders would keep running with the
# worker's own uid and full environment, or every upload would fail as "ffprobe failed".
# See docs/media-pipeline-hardening.md.
FFMPEG_PATH=                               # [BOOT in prod] absolute path to the pinned ffmpeg the image installs (/usr/local/bin/ffmpeg); off-prod falls back to the ffmpeg-static devDependency
FFPROBE_PATH=                              # [BOOT in prod] absolute path to the pinned ffprobe (/usr/local/bin/ffprobe); off-prod falls back to ffprobe-static
MEDIA_SANDBOX_UID=                         # [BOOT in prod] uid the media decoders are spawned as (image provisions mediatools=1001); must be set together with the gid
MEDIA_SANDBOX_GID=                         # [BOOT in prod] gid for the same (1001); `node` is a member so it can read decoder output in the shared job tmp dir
MEDIA_SANDBOX_DROP_BOUNDING=                # [OPT] 1 to also drop the child capability BOUNDING set; requires SETPCAP in the container's cap_add (default off, and inert without it: no_new_privs + empty ambient/inheritable already leave the decoder with no capabilities)
MEDIA_MAX_TOOL_STDOUT_BYTES=               # [OPT] default 1048576 - bytes the worker will buffer from a decoder's stdout/stderr. Every lane prints a small JSON/text result and writes real output to files, so this is deliberately far below the media size budget
MEDIA_VIDEO_MAX_PIXELS=                    # [OPT] default 8294400 (3840x2160) - videos above this are rejected BEFORE any remux/frame decode
MEDIA_VIDEO_MAX_FPS=                       # [OPT] default 120 - frame-rate cap applied at the same point
MEDIA_VIDEO_MAX_BITRATE=                   # [OPT] default 50000000 (bits/s) - bitrate cap applied at the same point
HTTPS_PROXY=                               # [OPT] CONNECT proxy for the worker's only egress (http://media-egress-proxy:8888); unset = direct. A new outbound host must also be added to civfix-infra/egress/allowed-hosts
NO_PROXY=                                  # [OPT] hosts that stay direct when HTTPS_PROXY is set (postgres,redis,localhost,127.0.0.1,::1)
