{
  "name": "@civfix/api",
  "version": "1.4.0",
  "private": true,
  "description": "civfix Fastify 5 API service. Hosts HTTP + WS endpoints; all external dependencies sit behind the 12 @civfix/shared interfaces, selected real-vs-fake in the DI container.",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/server.js",
  "exports": {
    ".": "./dist/server.js",
    "./server": "./dist/server.js",
    "./db": "./src/db/worker-db.ts",
    "./media-repo": "./src/services/media-worker-repo.ts",
    "./inbound-retention-repo": "./src/services/admin/inbound-retention-repository.drizzle.ts",
    "./geocode-cache": "./src/services/geocode-cache.ts",
    "./anon-hold-release": "./src/services/anon-hold-release.ts",
    "./anon-hold-repo": "./src/services/anon-hold-release-repo.drizzle.ts",
    "./adapters/storage": "./src/adapters/storage.r2.ts",
    "./adapters/storage-local": "./src/adapters/storage.local.ts",
    "./adapters/abuse-checks": "./src/adapters/abuse-checks.ts",
    "./errors": "./src/errors/glitchtip.ts",
    "./migrate": "./src/db/migrate.ts"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "start:migrate": "node dist/db/migrate.js",
    "start:seed": "node dist/db/seed.js",
    "start:ingest": "node dist/db/ingest-jurisdictions.js",
    "start:backfill": "node dist/db/backfill-jurisdictions.js",
    "start:backfill:reference-codes": "node dist/db/backfill-reference-codes.js",
    "start:backfill:served-key": "node dist/db/backfill-served-key.js",
    "start:backfill:user-activity": "node dist/db/backfill-user-activity.js",
    "start:backfill:signup-seats": "node dist/db/backfill-signup-seats.js",
    "start:backfill:post-geom": "node dist/db/backfill-post-geom.js",
    "start:seed:demo": "node dist/db/seed-demo-la.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:seed:demo": "tsx src/db/seed-demo-la.ts",
    "db:demo:join": "tsx src/db/demo-join-event.ts",
    "db:ingest": "tsx src/db/ingest-jurisdictions.ts",
    "db:backfill": "tsx src/db/backfill-jurisdictions.ts",
    "db:backfill:reference-codes": "tsx src/db/backfill-reference-codes.ts",
    "db:backfill-population": "tsx src/db/backfill-population.ts",
    "db:backfill:served-key": "tsx src/db/backfill-served-key.ts",
    "db:backfill:user-activity": "tsx src/db/backfill-user-activity.ts",
    "db:backfill:signup-seats": "tsx src/db/backfill-signup-seats.ts",
    "db:backfill:post-geom": "tsx src/db/backfill-post-geom.ts",
    "email:gallery": "tsx scripts/render-email-gallery.ts",
    "db:certificate:revoke": "tsx scripts/revoke-certificate.ts",
    "db:prepare-boundaries": "tsx scripts/prepare-boundaries.ts",
    "db:boundaries:refresh": "tsx scripts/refresh-boundaries.ts",
    "clean": "rimraf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1147.0",
    "@aws-sdk/s3-request-presigner": "^3.1147.0",
    "@civfix/shared": "^0.58.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^10.1.0",
    "@fastify/helmet": "^12.0.1",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/websocket": "^11.3.3",
    "@node-rs/argon2": "^2.2.2",
    "@sentry/node": "^10.76.1",
    "@smithy/node-http-handler": "4.7.5",
    "arctic": "^2.3.4",
    "drizzle-orm": "^0.45.3",
    "fastify": "^5.12.5",
    "firebase-admin": "^14.5.0",
    "h3-js": "^4.5.0",
    "https-proxy-agent": "7.0.6",
    "ioredis": "^5.11.1",
    "jose": "^5.10.0",
    "mailparser": "^3.9.36",
    "node-apn": "^3.0.0",
    "nodemailer": "^10.0.15",
    "oslo": "^1.2.1",
    "pdfkit": "^0.19.1",
    "pg-boss": "^10.4.2",
    "postgres": "^3.4.9",
    "qrcode-generator": "^2.0.4",
    "tldts": "^7.4.16",
    "web-push": "^3.6.7",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@civfix/config": "workspace:*",
    "@testcontainers/postgresql": "^11.14.0",
    "@types/ioredis-mock": "^8.2.8",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.6",
    "@types/web-push": "^3.6.4",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "ioredis-mock": "^8.13.1",
    "rimraf": "^6.1.3",
    "testcontainers": "^11.14.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
