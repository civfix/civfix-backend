{
  "name": "@civfix/api",
  "version": "0.0.0",
  "private": true,
  "description": "civfix Fastify 5 API service. Hosts HTTP + WS endpoints; all external dependencies sit behind the 9 @civfix/shared interfaces, selected real-vs-fake in the DI container.",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/server.js",
  "exports": {
    ".": "./dist/server.js",
    "./server": "./dist/server.js",
    "./db": "./src/db/worker-db.ts",
    "./media-repo": "./src/services/media-worker-repo.ts",
    "./adapters/storage": "./src/adapters/storage.r2.ts",
    "./adapters/abuse-checks": "./src/adapters/abuse-checks.ts",
    "./errors": "./src/errors/glitchtip.ts",
    "./migrate": "./src/db/migrate.ts"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "clean": "rimraf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@civfix/shared": "workspace:*",
    "@fastify/cookie": "^11.0.1",
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^12.0.1",
    "@fastify/rate-limit": "^10.1.1",
    "@fastify/websocket": "^11.0.1",
    "@node-rs/argon2": "^2.0.2",
    "@sentry/node": "^8.42.0",
    "arctic": "^2.3.0",
    "drizzle-orm": "^0.36.4",
    "fastify": "^5.1.0",
    "firebase-admin": "^13.0.1",
    "h3-js": "^4.1.0",
    "ioredis": "^5.4.1",
    "node-apn": "^3.0.0",
    "nodemailer": "^6.9.16",
    "oslo": "^1.2.1",
    "pg-boss": "^10.1.5",
    "postgres": "^3.4.5",
    "web-push": "^3.6.7",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@civfix/config": "workspace:*",
    "@testcontainers/postgresql": "^10.16.0",
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^6.4.17",
    "@types/web-push": "^3.6.4",
    "drizzle-kit": "^0.28.1",
    "eslint": "^9.16.0",
    "rimraf": "^6.0.1",
    "testcontainers": "^10.16.0",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
