{
  "name": "@civfix/backend-root",
  "version": "1.4.1",
  "private": true,
  "description": "civfix backend monorepo: Fastify API + media worker (VPS infra lives in the civfix-infra repo). Depends on @civfix/contract and @civfix/tokens (from the private npm registry) as the single contract source.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@10.34.9+sha512.f49b5a8ea0fdedb44bb3c0c1d6575092a53c2950d95b7ad15df11f17974877a2de3a01c07e934e9b28ce716e51c09a94962c7306d09be2e1e4b18a8c8762fd32",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test --continue",
    "test:coverage": "turbo run test:coverage --continue",
    "check:sql": "node scripts/check-dynamic-sql.mjs",
    "check:licenses": "node scripts/check-licenses.mjs",
    "test:scripts": "node --test scripts/*.test.mjs",
    "format:check": "prettier --check .",
    "knip": "knip",
    "dup:check": "jscpd",
    "dev": "turbo run dev",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "jscpd": "^5.3.2",
    "knip": "^5.88.1",
    "prettier": "^3.9.9",
    "turbo": "^2.11.7",
    "typescript": "^5.9.3"
  }
}
