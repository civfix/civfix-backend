{
  "name": "@civfix/backend-root",
  "version": "1.4.1",
  "private": true,
  "description": "civfix backend monorepo: Fastify API + media worker (VPS infra lives in the civfix-infra repo). Depends on @civfix/contract and @civfix/tokens (from the private npm registry) as the single contract source.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@12.17.0+sha512.b8d223ebec04b580a89ed206daa71d1bccb6a1ee1d52efa95cc3b0db75271561df8f0d8e2c43add39c5ec08018af7a8a95108e7090f95a29f88727b7a40fd53d",
  "engines": {
    "node": "^24.15"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test --continue",
    "test:coverage": "turbo run test:coverage --continue",
    "check:sql": "node scripts/check-dynamic-sql.mjs",
    "check:licenses": "node scripts/check-licenses.mjs",
    "test:scripts": "node --test scripts/*.test.mjs",
    "format:check": "prettier --check .",
    "knip": "knip",
    "dup:check": "jscpd",
    "dev": "turbo run dev",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "@typescript/native": "npm:typescript@^7.0.2",
    "jscpd": "^5.3.2",
    "knip": "^6.44.1",
    "prettier": "^3.9.9",
    "turbo": "^2.11.7",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  }
}
