{
  "name": "@civfix/email-worker",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "description": "Cloudflare Email Worker: catch-all *@civfix.org inbound mail -> R2 -> backend webhook nudge.",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy --env production",
    "deploy:staging": "wrangler deploy --env staging",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@civfix/testing": "link:../../packages/testing",
    "@cloudflare/workers-types": "^5.20261026.1",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^4.1.12",
    "typescript": "^5.6.0",
    "vitest": "^4.1.12",
    "wrangler": "^4.152.0"
  }
}
