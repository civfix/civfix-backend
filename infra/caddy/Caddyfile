# Caddy reverse proxy for civfix. Terminates HTTP on :80 and proxies to the api container.
# Replace the site address with your real domain (and Caddy will auto-provision TLS) in production.
#
# SECURITY (trusted-proxy hardening): the API derives request.ip from X-Forwarded-For ONLY for trusted
# upstream hops (see services/api env TRUST_PROXY, default = internal loopback+private ranges). For that
# to be safe, the edge must NOT let a client pre-seed the forwarding headers. Caddy APPENDS to an
# inbound X-Forwarded-For by default, so a request arriving with a forged "X-Forwarded-For: 9.9.9.9"
# would reach the API as "9.9.9.9, <real-client>". We therefore STRIP any inbound X-Forwarded-* on each
# proxied request (header_up -X-Forwarded-*), so Caddy sets X-Forwarded-For FRESH to the real client
# remote address and the client cannot inject its own value. The api+caddy pair together guarantee
# request.ip is the genuine client.
#
# We ALSO strip inbound Cloudflare geo headers (CF-IPLatitude / CF-IPLongitude / CF-IPCountry) on each
# request (defense in depth). The app only trusts CF-* geo when it arrives via a trusted forwarding hop,
# so a direct client cannot get them believed; stripping any client-supplied values at the proxy removes
# even that confusion at the edge. The real Cloudflare/edge in front re-adds the authentic CF-* headers.

:80 {
	# Strip any client-supplied forwarding headers so they cannot be spoofed; Caddy then sets
	# X-Forwarded-For / -Proto / -Host fresh from the real connection on each reverse_proxy below.
	# Also drop any client-supplied Cloudflare geo headers (defense in depth; the real edge re-adds them).
	request_header -X-Forwarded-For
	request_header -X-Forwarded-Proto
	request_header -X-Forwarded-Host
	request_header -CF-IPLatitude
	request_header -CF-IPLongitude
	request_header -CF-IPCountry

	# Liveness passthrough so the LB / uptime checks can hit the API directly.
	handle /healthz {
		reverse_proxy api:8080 {
			header_up -X-Forwarded-For
			header_up -X-Forwarded-Proto
			header_up -X-Forwarded-Host
			header_up -CF-IPLatitude
			header_up -CF-IPLongitude
			header_up -CF-IPCountry
		}
	}

	handle /readyz {
		reverse_proxy api:8080 {
			header_up -X-Forwarded-For
			header_up -X-Forwarded-Proto
			header_up -X-Forwarded-Host
			header_up -CF-IPLatitude
			header_up -CF-IPLongitude
			header_up -CF-IPCountry
		}
	}

	# Everything else proxies to the API as well.
	handle {
		reverse_proxy api:8080 {
			# Defense in depth: clear the inbound XFF on the upstream request so Caddy re-sets it to the
			# real client remote (Caddy does NOT append when the header was removed first).
			header_up -X-Forwarded-For
			header_up -X-Forwarded-Proto
			header_up -X-Forwarded-Host
			header_up -CF-IPLatitude
			header_up -CF-IPLongitude
			header_up -CF-IPCountry
		}
	}

	encode gzip zstd
	log {
		output stdout
		format console
	}
}
