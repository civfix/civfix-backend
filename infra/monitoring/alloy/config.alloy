// civfix Alloy — tails every container's logs via the read-only Docker socket-proxy and ships them to
// Loki. Labels are kept minimal (container, service, job); pino JSON fields are parsed at query time in
// Grafana with `| json`, NOT indexed here, to keep Loki cardinality low.

// Discover running containers through the socket-proxy (never the raw docker.sock).
discovery.docker "containers" {
	host             = "tcp://socket-proxy:2375"
	refresh_interval = "15s"
}

// Map Docker metadata to clean, low-cardinality Loki labels.
discovery.relabel "containers" {
	targets = discovery.docker.containers.targets

	// "/compose-api-1" -> "compose-api-1"
	rule {
		source_labels = ["__meta_docker_container_name"]
		regex         = "/(.*)"
		target_label  = "container"
	}

	// compose service name (api, postgres, grafana, ...) when present.
	rule {
		source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
		target_label  = "service"
	}

	// compose project (expected: "compose").
	rule {
		source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
		target_label  = "project"
	}

	// Don't tail the log pipeline's own containers — avoids a log-on-log feedback loop.
	// (Grafana/Prometheus logs are kept; their errors are worth seeing.)
	rule {
		source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
		regex         = "loki|alloy"
		action        = "drop"
	}
}

// Stream container logs to Loki via the Docker API (works regardless of the host's `local` log driver).
loki.source.docker "containers" {
	host       = "tcp://socket-proxy:2375"
	targets    = discovery.relabel.containers.output
	labels     = {job = "docker"}
	forward_to = [loki.write.default.receiver]
}

loki.write "default" {
	endpoint {
		url = "http://loki:3100/loki/api/v1/push"
	}
	external_labels = {host = "civfix"}
}
