# Exporter secrets (SOPS+age encrypted as infra/secrets/monitoring.env). Write values RAW — no quotes.
# The `monitoring` Postgres role is least-privilege (pg_monitor + SELECT on abuse_flags); see ops/DEPLOY.md.
# sslmode=disable is fine: the connection never leaves the compose_default bridge network.
DATA_SOURCE_NAME=postgresql://monitoring:replace-with-monitoring-role-password@postgres:5432/civfix?sslmode=disable
