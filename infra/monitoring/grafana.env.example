# Grafana secrets (SOPS+age encrypted as infra/secrets/grafana.env). Write values RAW — no surrounding
# quotes. Avoid '$' in the admin password unless you know start.sh escapes it ($ -> $$ for Compose).
GF_SECURITY_ADMIN_USER=civfix-admin
GF_SECURITY_ADMIN_PASSWORD=replace-with-a-strong-generated-password
